---
/**
 * SHA256.US — Layout Principal del CMS de Cumplimiento Forense (Astro Modular)
 * Stack: Astro ('output: static') + USWDS 3.14 + PHP/MySQL (cPanel)
 */
import SiteBanner from '../components/layout/SiteBanner.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import AuthGuard from '../components/layout/AuthGuard.astro';

interface Props {
  title?: string;
  activeNav?: string;
}

const { title = 'Forensic Chief Compliance Officer — SHA256.US', activeNav = '' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="stylesheet" href="/assets/uswds/css/uswds.min.css?v=3.14.0" />
    <script is:inline src="/assets/uswds/js/uswds-init.min.js"></script>
  </head>
  <body class="bg-base-lightest display-flex flex-column minh-viewport">
    <a class="usa-skipnav" href="#main-content">Saltar al contenido principal</a>
    <div class="usa-overlay"></div>
    <SiteBanner />
    <SiteHeader activeNav={activeNav} />
    <main class="usa-section padding-top-3 padding-bottom-6 flex-1" id="main-content">
      <div class="grid-container-widescreen">
        <slot />
      </div>
    </main>
    <SiteFooter />
    <AuthGuard />
    <script is:inline src="/assets/uswds/js/uswds.min.js"></script>
  </body>
</html>
