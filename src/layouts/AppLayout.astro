---
/**
 * SHA256.US — Layout Principal del CMS de Cumplimiento Forense (Astro Modular)
 * Stack: Astro ('output: static') + USWDS 3.14 + PHP/MySQL (cPanel)
 * Arquitectura Canónica USWDS: Banner Federal + Header Oficial + Layout 2 Columnas (.usa-sidenav)
 */
import SiteBanner from '../components/layout/SiteBanner.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteSidebar from '../components/layout/SiteSidebar.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import AuthGuard from '../components/layout/AuthGuard.astro';

interface Props {
  title?: string;
  activeNav?: string;
}

const { title = 'Forensic Chief Compliance Officer — SHA256.US', activeNav = '' } = Astro.props;
---
<!doctype html>
<html lang="es" class="fcco-auth-loading">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="stylesheet" href="/assets/uswds/css/uswds.min.css?v=3.14.0" />
    <script is:inline src="/assets/uswds/js/uswds-init.min.js"></script>

    <!-- Guardia Sincrónico de Acceso: Previene flash y bloquea acceso no autenticado -->
    <script is:inline>
      (function() {
        var p = window.location.pathname;
        var isPublic = p === '/' || p.endsWith('/index.html') || p === '';
        if (!isPublic) {
          if (sessionStorage.getItem('fcco_auth_active') !== '1') {
            window.location.replace('/?msg=sesion_requerida');
          }
        }
      })();
    </script>
    <style id="fcco-auth-cloak">
      html.fcco-auth-loading body {
        display: none !important;
      }
    </style>
  </head>
  <body class="bg-base-lightest display-flex flex-column minh-viewport">
    <a class="usa-skipnav" href="#main-content">Saltar al contenido principal</a>
    <div class="usa-overlay"></div>
    <SiteBanner />
    <SiteHeader activeNav={activeNav} />

    <!-- Área Principal de Trabajo con Cuadrícula Canónica de 2 Columnas -->
    <main class="usa-section padding-top-3 padding-bottom-6 flex-1" id="main-content">
      <div class="grid-container-widescreen">
        <div class="grid-row grid-gap-4">
          <!-- Columna Izquierda: Panel de Control Pericial CMS (.usa-sidenav) -->
          <aside class="desktop:grid-col-3 tablet:grid-col-4 margin-bottom-3" aria-label="Navegación del Panel de Control Compliance">
            <SiteSidebar activeNav={activeNav} />
          </aside>

          <!-- Columna Derecha: Área de Contenido y Flujo Procesal -->
          <div class="desktop:grid-col-9 tablet:grid-col-8 minw-0">
            <slot />
          </div>
        </div>
      </div>
    </main>

    <SiteFooter />
    <AuthGuard />
    <script is:inline src="/assets/uswds/js/uswds.min.js"></script>
  </body>
</html>
