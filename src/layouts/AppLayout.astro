---
/**
 * SHA256.US — Layout Principal del CMS de Cumplimiento Forense (Astro Modular)
 * Stack: Astro ('output: static') + USWDS 3.14 + PHP/MySQL (cPanel)
 * Arquitectura: Panel de Control Compliance Officer con Navbar al Lado Izquierdo (.usa-sidenav)
 */
import SiteBanner from '../components/layout/SiteBanner.astro';
import SiteSidebar from '../components/layout/SiteSidebar.astro';
import SiteTopBar from '../components/layout/SiteTopBar.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import AuthGuard from '../components/layout/AuthGuard.astro';

interface Props {
  title?: string;
  activeNav?: string;
}

const { title = 'Forensic Chief Compliance Officer — SHA256.US', activeNav = '' } = Astro.props;
---
<!doctype html>
<html lang="es" class="fcco-auth-loading">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="stylesheet" href="/assets/uswds/css/uswds.min.css?v=3.14.0" />
    <script is:inline src="/assets/uswds/js/uswds-init.min.js"></script>

    <!-- Guardia Sincrónico de Acceso: Previene flash y bloquea acceso no autenticado -->
    <script is:inline>
      (function() {
        var p = window.location.pathname;
        var isPublic = p === '/' || p.endsWith('/index.html') || p === '';
        if (!isPublic) {
          if (sessionStorage.getItem('fcco_auth_active') !== '1') {
            window.location.replace('/?msg=sesion_requerida');
          }
        }
      })();
    </script>
    <style id="fcco-auth-cloak">
      html.fcco-auth-loading body {
        display: none !important;
      }
    </style>
  </head>
  <body class="bg-base-lightest display-flex flex-column minh-viewport">
    <a class="usa-skipnav" href="#main-content">Saltar al contenido principal</a>
    <div class="fcco-overlay" id="fcco-overlay"></div>
    <SiteBanner />

    <!-- Estructura del Panel de Control CMS: Navbar al Lado Izquierdo + Área de Trabajo a la Derecha -->
    <div class="fcco-dashboard-shell">
      <SiteSidebar activeNav={activeNav} />

      <div class="fcco-main-wrapper">
        <SiteTopBar activeNav={activeNav} />
        <main class="fcco-content-area" id="main-content">
          <slot />
        </main>
        <SiteFooter />
      </div>
    </div>

    <AuthGuard />
    <script is:inline src="/assets/uswds/js/uswds.min.js"></script>
    <script is:inline>
      // Toggle interactivo del Sidebar en tabletas y móviles
      (function() {
        var toggleBtn = document.getElementById('fcco-sidebar-toggle');
        var closeBtn = document.getElementById('fcco-sidebar-close');
        var sidebar = document.getElementById('fcco-sidebar');
        var overlay = document.getElementById('fcco-overlay');

        function openSidebar() {
          if (sidebar) sidebar.classList.add('is-open');
          if (overlay) overlay.classList.add('is-visible');
        }

        function closeSidebar() {
          if (sidebar) sidebar.classList.remove('is-open');
          if (overlay) overlay.classList.remove('is-visible');
        }

        if (toggleBtn) toggleBtn.addEventListener('click', openSidebar);
        if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
        if (overlay) overlay.addEventListener('click', closeSidebar);
      })();
    </script>
  </body>
</html>
