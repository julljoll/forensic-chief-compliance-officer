---
/**
 * SHA256.US — PrintLayout para Planillas Oficiales en Folio (216mm x 330mm)
 * Aislado 100% en .folio-forense-aislado con generación única de Planilla QR + PDF vectorial.
 */
import '../styles/folio-aislado.css';
import PrintToolbar from '../components/layout/PrintToolbar.astro';
import AuthGuard from '../components/layout/AuthGuard.astro';

interface Props {
  title?: string;
  activeSlug?: string;
}

const { title = 'Documento Pericial Oficial — SHA256.US', activeSlug = '' } = Astro.props;
---
<!doctype html>
<html lang="es" class="fcco-auth-loading">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <script is:inline src="/assets/uswds/js/uswds-init.min.js"></script>
    <link rel="stylesheet" href="/assets/uswds/css/uswds.min.css?v=3.14.0" />

    <!-- Guardia Sincrónico de Acceso: Previene flash y bloquea acceso no autenticado a planillas -->
    <script is:inline>
      (function() {
        var p = window.location.pathname;
        var isPublic = p === '/' || p.endsWith('/index.html') || p === '';
        if (!isPublic) {
          if (sessionStorage.getItem('fcco_auth_active') !== '1') {
            window.location.replace('/?msg=sesion_requerida');
            return;
          }
          if (window.location.search.indexOf('render_pdf=1') !== -1) {
            document.documentElement.classList.remove('fcco-auth-loading');
          }
        }
      })();
    </script>
    <style id="fcco-auth-cloak">
      html.fcco-auth-loading body {
        display: none !important;
      }
    </style>
  </head>
  <body class="bg-base-darkest">
    <PrintToolbar />

    <!-- Contenedor Raíz Aislado Monocromático Folio (216mm × 330mm) -->
    <main id="main-content" class="display-flex flex-column flex-align-center width-full overflow-x-auto padding-x-1">
      <div class="folio-forense-aislado" data-slug={activeSlug}>
        <slot />
      </div>
    </main>

    <script is:inline src="/assets/uswds/js/uswds.min.js"></script>
    <script>
      import {
        generarPlanillaConQrNativo,
        type GenerarPlanillaQrResult,
      } from '../lib/export/generarPlanillaQr';

      const urlParams = new URLSearchParams(window.location.search);
      const btnGenerarQr = document.getElementById('btn-generar-planilla-qr');
      const txtGenerarQr = document.getElementById('txt-btn-generar-qr');

      const bannerSellada = document.getElementById('banner-planilla-sellada');
      const selladaCodigoEl = document.getElementById('sellada-codigo-planilla');
      const selladaModoTag = document.getElementById('sellada-modo-tag');
      const selladaPeritoEl = document.getElementById('sellada-perito-info');
      const selladaHashEl = document.getElementById('sellada-hash-sha256');
      const linkSelladaVerificar = document.getElementById('link-sellada-verificar') as HTMLAnchorElement | null;
      const btnSelladaImprimir = document.getElementById('btn-sellada-imprimir');
      const btnSelladaNueva = document.getElementById('btn-sellada-nueva');

      let ultimaEmisionQr: GenerarPlanillaQrResult | null = null;
      let emisionEnCurso = false;

      function mostrarBannerSellada(res: GenerarPlanillaQrResult) {
        if (!bannerSellada) return;
        const p = res.planilla;
        if (selladaCodigoEl) selladaCodigoEl.textContent = p.codigoPlanilla;
        if (selladaPeritoEl) {
          selladaPeritoEl.textContent = [p.perito?.nombre, p.perito?.civ].filter(Boolean).join(' · ') || 'Perito Autenticado';
        }
        if (selladaHashEl) {
          selladaHashEl.textContent = `${p.hashEmisionSha256.slice(0, 24)}…${p.hashEmisionSha256.slice(-12)}`;
          selladaHashEl.title = p.hashEmisionSha256;
        }
        if (selladaModoTag) {
          if (res.offlineDraft) {
            selladaModoTag.textContent = 'BORRADOR LOCAL (SIN SERVIDOR)';
            selladaModoTag.className = 'usa-tag bg-warning-dark text-white font-mono-3xs';
          } else {
            selladaModoTag.textContent = 'REGISTRADA EN SERVIDOR SHA256.US';
            selladaModoTag.className = 'usa-tag bg-success-dark text-white font-mono-3xs';
          }
        }
        if (linkSelladaVerificar) {
          linkSelladaVerificar.href = `/verificar?codigo=${encodeURIComponent(p.codigoPlanilla)}`;
        }
        bannerSellada.hidden = false;
      }

      async function ejecutarGeneracionQrNativa(autoPrint = true, forceNew = false) {
        if (emisionEnCurso) return;

        // Si ya fue sellada en esta sesión y no se solicitó nuevo código, imprimir directamente sin duplicar en BD
        if (ultimaEmisionQr && !forceNew) {
          mostrarBannerSellada(ultimaEmisionQr);
          if (autoPrint) {
            window.print();
          }
          return;
        }

        emisionEnCurso = true;
        if (txtGenerarQr) txtGenerarQr.textContent = 'Sellando QR...';
        btnGenerarQr?.setAttribute('disabled', 'true');
        btnSelladaNueva?.setAttribute('disabled', 'true');

        try {
          const result = await generarPlanillaConQrNativo({
            autoPrint,
            casoId: urlParams.get('casoId') || null,
            numeroCaso: urlParams.get('numeroCaso') || null,
            numeroPRCC: urlParams.get('numeroPRCC') || null,
          });
          ultimaEmisionQr = result;
          mostrarBannerSellada(result);
          if (txtGenerarQr) txtGenerarQr.textContent = 'Guardar PDF con QR';
        } catch (err) {
          console.error('Error al generar planilla con QR nativo:', err);
          alert('Hubo un inconveniente al registrar el sello QR de la planilla. Verifique su sesión e intente nuevamente.');
          if (txtGenerarQr) txtGenerarQr.textContent = 'Generar Planilla (QR + PDF)';
        } finally {
          emisionEnCurso = false;
          btnGenerarQr?.removeAttribute('disabled');
          btnSelladaNueva?.removeAttribute('disabled');
        }
      }

      btnGenerarQr?.addEventListener('click', () => {
        ejecutarGeneracionQrNativa(true, false);
      });

      btnSelladaImprimir?.addEventListener('click', () => {
        window.print();
      });

      btnSelladaNueva?.addEventListener('click', () => {
        ejecutarGeneracionQrNativa(false, true);
      });

      // Disparo automático opcional si se abre con ?generar=1
      if (urlParams.get('generar') === '1' && urlParams.get('render_pdf') !== '1') {
        setTimeout(() => {
          ejecutarGeneracionQrNativa(true, false);
        }, 450);
      }
    </script>
    <AuthGuard />
  </body>
</html>
