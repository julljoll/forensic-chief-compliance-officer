---
/**
 * SHA256.US — PrintLayout para Planillas Oficiales en Folio (216mm x 330mm)
 * Aislado 100% en .folio-forense-aislado con soporte para impresión web limpia o exportación a PDF.
 * Incluye barra superior USWDS no imprimible (.usa-header.no-print) con conmutador de Modo Blanco vs Con Datos.
 */
import '../styles/folio-aislado.css';

interface Props {
  title?: string;
  activeSlug?: string;
}

const { title = 'Documento Pericial Oficial — SHA256.US' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <script is:inline src="/assets/uswds/js/uswds-init.min.js"></script>
    <link rel="stylesheet" href="/assets/uswds/css/uswds.min.css" />
  </head>
  <body class="bg-base-darkest">
    <!-- USWDS: Header | https://designsystem.digital.gov/components/header/ -->
    <!-- Barra de Control de Impresión (se oculta automáticamente al imprimir vía @media print en folio-aislado.css) -->
    <header class="usa-header usa-header--basic no-print bg-white border-bottom-1px border-base-lighter">
      <div class="grid-container-widescreen padding-y-1">
        <div class="grid-row grid-gap-1 flex-align-center flex-justify">
          <div class="tablet:grid-col-auto display-flex flex-align-center margin-bottom-1 tablet:margin-bottom-0">
            <svg class="usa-icon text-primary margin-right-05" aria-hidden="true" focusable="false" role="img">
              <use href="/assets/uswds/img/sprite.svg#verified_user"></use>
            </svg>
            <div>
              <strong class="text-primary-darker font-body-3xs tablet:font-body-2xs">FORMATO FOLIO JUDICIAL:</strong>
              <span class="text-base-dark font-body-3xs tablet:font-body-2xs margin-left-05">216mm × 330mm (Oficio)</span>
            </div>
          </div>

          <!-- Selector de Modo de Visualización / Impresión -->
          <div class="tablet:grid-col-auto margin-bottom-1 tablet:margin-bottom-0" id="mode-toggle-container">
            <!-- USWDS: Button group | https://designsystem.digital.gov/components/button-group/ -->
            <ul class="usa-button-group usa-button-group--segmented">
              <li class="usa-button-group__item">
                <button
                  type="button"
                  class="usa-button font-sans-3xs tablet:font-sans-2xs padding-x-1 padding-y-05"
                  id="btn-modo-blanco"
                  title="Muestra el formulario completamente en blanco con líneas para llenado manual"
                >
                  Plantilla en Blanco
                </button>
              </li>
              <li class="usa-button-group__item">
                <button
                  type="button"
                  class="usa-button usa-button--outline font-sans-3xs tablet:font-sans-2xs padding-x-1 padding-y-05"
                  id="btn-modo-datos"
                  title="Rellena los campos con los datos del expediente seleccionado"
                >
                  Con Datos de Caso
                </button>
              </li>
            </ul>
          </div>

          <div class="tablet:grid-col-auto">
            <!-- USWDS: Button group | https://designsystem.digital.gov/components/button-group/ -->
            <ul class="usa-button-group flex-wrap">
              <li class="usa-button-group__item">
                <a href="/planillas" class="usa-button usa-button--outline font-sans-3xs tablet:font-sans-2xs padding-x-1 padding-y-05">
                  Catálogo
                </a>
              </li>
              <li class="usa-button-group__item">
                <button
                  type="button"
                  id="btn-descargar-word"
                  class="usa-button usa-button--base font-sans-3xs tablet:font-sans-2xs padding-x-1 padding-y-05"
                  title="Descargar esta planilla oficial en formato editable Microsoft Word (.docx)"
                >
                  <svg class="usa-icon margin-right-05" aria-hidden="true" focusable="false" role="img">
                    <use href="/assets/uswds/img/sprite.svg#file_download"></use>
                  </svg>
                  <span id="txt-btn-word">Word (.docx)</span>
                </button>
              </li>
              <li class="usa-button-group__item">
                <button
                  type="button"
                  id="btn-imprimir-folio"
                  class="usa-button font-sans-3xs tablet:font-sans-2xs padding-x-1 padding-y-05"
                >
                  <svg class="usa-icon margin-right-05" aria-hidden="true" focusable="false" role="img">
                    <use href="/assets/uswds/img/sprite.svg#print"></use>
                  </svg>
                  <span>Imprimir / PDF</span>
                </button>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </header>

    <!-- EXCEPCIÓN FUERA DE USWDS: Contenedor Raíz Aislado Monocromático Folio (216mm × 330mm) -->
    <main id="main-content" class="display-flex flex-column flex-align-center width-full overflow-x-auto padding-x-1">
      <div class="folio-forense-aislado">
        <slot />
      </div>
    </main>

    <script is:inline src="/assets/uswds/js/uswds.min.js"></script>
    <script>
      import { exportCurrentPlanillaToWordDocx } from '../lib/export/exportWordDocx';

      // Sincronizar el estado del selector con la URL
      const urlParams = new URLSearchParams(window.location.search);
      const modoActual = urlParams.get('modo') || (urlParams.get('casoId') ? 'datos' : 'blanco');
      const btnBlanco = document.getElementById('btn-modo-blanco');
      const btnDatos = document.getElementById('btn-modo-datos');
      const btnWord = document.getElementById('btn-descargar-word');
      const txtWord = document.getElementById('txt-btn-word');
      const btnImprimir = document.getElementById('btn-imprimir-folio');

      function updateActiveBtn(modo: string) {
        if (modo === 'datos') {
          btnDatos?.classList.remove('usa-button--outline');
          btnBlanco?.classList.add('usa-button--outline');
        } else {
          btnBlanco?.classList.remove('usa-button--outline');
          btnDatos?.classList.add('usa-button--outline');
        }
      }

      updateActiveBtn(modoActual);

      btnBlanco?.addEventListener('click', () => {
        const u = new URL(window.location.href);
        u.searchParams.set('modo', 'blanco');
        window.location.href = u.toString();
      });

      btnDatos?.addEventListener('click', () => {
        const u = new URL(window.location.href);
        u.searchParams.set('modo', 'datos');
        window.location.href = u.toString();
      });

      btnImprimir?.addEventListener('click', () => {
        window.print();
      });

      // Manejador de descarga Microsoft Word (.docx)
      btnWord?.addEventListener('click', async () => {
        if (txtWord) txtWord.textContent = 'Generando...';
        btnWord.setAttribute('disabled', 'true');
        try {
          await exportCurrentPlanillaToWordDocx();
        } catch (err) {
          console.error('Error al exportar Word:', err);
          alert('Hubo un inconveniente al generar el documento Word. Revise la consola pericial.');
        } finally {
          if (txtWord) txtWord.textContent = 'Word (.docx)';
          btnWord.removeAttribute('disabled');
        }
      });

      // Descarga automática por parámetro URL ?descargar=docx
      if (urlParams.get('descargar') === 'docx') {
        setTimeout(async () => {
          await exportCurrentPlanillaToWordDocx();
        }, 700);
      }
    </script>
  </body>
</html>
