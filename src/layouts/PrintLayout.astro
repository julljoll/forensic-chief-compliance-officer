---
/**
 * SHA256.US — PrintLayout para Planillas Oficiales en Folio (216mm x 330mm)
 * Aislado 100% en .folio-forense-aislado con soporte para impresión web limpia o exportación a PDF.
 */
import '../styles/folio-aislado.css';
import PrintToolbar from '../components/layout/PrintToolbar.astro';
import AuthGuard from '../components/layout/AuthGuard.astro';

interface Props {
  title?: string;
  activeSlug?: string;
}

const { title = 'Documento Pericial Oficial — SHA256.US' } = Astro.props;
---
<!doctype html>
<html lang="es" class="fcco-auth-loading">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <script is:inline src="/assets/uswds/js/uswds-init.min.js"></script>
    <link rel="stylesheet" href="/assets/uswds/css/uswds.min.css?v=3.14.0" />

    <!-- Guardia Sincrónico de Acceso: Previene flash y bloquea acceso no autenticado a planillas -->
    <script is:inline>
      (function() {
        var p = window.location.pathname;
        var isPublic = p === '/' || p.endsWith('/index.html') || p === '';
        if (!isPublic) {
          if (sessionStorage.getItem('fcco_auth_active') !== '1') {
            window.location.replace('/?msg=sesion_requerida');
          }
        }
      })();
    </script>
    <style id="fcco-auth-cloak">
      html.fcco-auth-loading body {
        display: none !important;
      }
    </style>
  </head>
  <body class="bg-base-darkest">
    <PrintToolbar />

    <!-- Contenedor Raíz Aislado Monocromático Folio (216mm × 330mm) -->
    <main id="main-content" class="display-flex flex-column flex-align-center width-full overflow-x-auto padding-x-1">
      <div class="folio-forense-aislado">
        <slot />
      </div>
    </main>

    <script is:inline src="/assets/uswds/js/uswds.min.js"></script>
    <script>
      import { exportCurrentPlanillaToWordDocx } from '../lib/export/exportWordDocx';
      import { exportCurrentPlanillaToEditablePdf } from '../lib/export/exportEditablePdf';

      const urlParams = new URLSearchParams(window.location.search);
      const btnWord = document.getElementById('btn-descargar-word');
      const txtWord = document.getElementById('txt-btn-word');
      const btnPdfEditable = document.getElementById('btn-descargar-pdf-editable');
      const txtPdfEditable = document.getElementById('txt-btn-pdf-editable');
      const btnImprimir = document.getElementById('btn-imprimir-folio');

      btnImprimir?.addEventListener('click', () => {
        window.print();
      });

      // Manejador de descarga Microsoft Word (.docx)
      btnWord?.addEventListener('click', async () => {
        if (txtWord) txtWord.textContent = 'Generando...';
        btnWord.setAttribute('disabled', 'true');
        try {
          await exportCurrentPlanillaToWordDocx();
        } catch (err) {
          console.error('Error al exportar Word:', err);
          alert('Hubo un inconveniente al generar el documento Word. Revise la consola pericial.');
        } finally {
          if (txtWord) txtWord.textContent = 'Word (.docx)';
          btnWord.removeAttribute('disabled');
        }
      });

      // Manejador de descarga PDF Editable con QR y Firma Digital para Adobe Acrobat
      btnPdfEditable?.addEventListener('click', async () => {
        if (txtPdfEditable) txtPdfEditable.textContent = 'Generando...';
        btnPdfEditable.setAttribute('disabled', 'true');
        try {
          await exportCurrentPlanillaToEditablePdf();
        } catch (err) {
          console.error('Error al exportar PDF Editable:', err);
          alert('Hubo un inconveniente al generar el PDF editable con firma digital.');
        } finally {
          if (txtPdfEditable) txtPdfEditable.textContent = 'PDF Editable (Adobe)';
          btnPdfEditable.removeAttribute('disabled');
        }
      });

      // Descarga automática por parámetro URL ?descargar=docx o ?descargar=pdf_editable
      if (urlParams.get('descargar') === 'docx') {
        setTimeout(async () => {
          await exportCurrentPlanillaToWordDocx();
        }, 700);
      } else if (urlParams.get('descargar') === 'pdf_editable') {
        setTimeout(async () => {
          await exportCurrentPlanillaToEditablePdf();
        }, 700);
      }
    </script>
    <AuthGuard />
  </body>
</html>
