---
/**
 * SHA256.US — Layout Dedicado para Autenticación y Acceso Seguro (MFA)
 */
import SiteBanner from '../components/layout/SiteBanner.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';

interface Props {
  title?: string;
}

const { title = 'Acceso Seguro — Forensic Chief Compliance Officer (SHA256.US)' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="stylesheet" href="/assets/uswds/css/uswds.min.css?v=3.14.0" />
    <script is:inline src="/assets/uswds/js/uswds-init.min.js"></script>
  </head>
  <body class="bg-base-lightest display-flex flex-column minh-viewport">
    <a class="usa-skipnav" href="#main-content">Saltar al contenido principal</a>
    <SiteBanner />
    <main class="usa-section flex-1 padding-y-4" id="main-content">
      <div class="grid-container">
        <slot />
      </div>
    </main>
    <SiteFooter />
    <script is:inline src="/assets/uswds/js/uswds.min.js"></script>
  </body>
</html>
