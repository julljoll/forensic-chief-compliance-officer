---
/**
 * SHA256.US — Base Normativa Forense RAG (77 Normas y Estándares)
 * Compendio de directrices ISO/IEC, NIST, MUCC-2017 y legislación procesal penal.
 */
import AppLayout from '../layouts/AppLayout.astro';
import SummaryBox from '../components/uswds/SummaryBox.astro';
import { NORMATIVAS_INICIALES } from '../lib/data/seed';
---

<AppLayout title="Base Normativa RAG — SHA256.US" activeNav="normativa">
  <!-- Encabezado de Página -->
  <div class="margin-bottom-3">
    <h1 class="margin-top-0 margin-bottom-1 text-primary-darker">
      Base de Conocimiento Normativo RAG
    </h1>
    <p class="usa-intro margin-top-0 margin-bottom-0 font-body-sm text-base-dark">
      Compendio legal y técnico internacional que fundamenta los dictámenes y garantiza la licitud probatoria.
    </p>
  </div>

  <!-- Resumen de Jerarquía Normativa -->
  <div class="margin-bottom-3">
    <SummaryBox heading="Pirámide de Aplicación y Supletoriedad (COPP Art. 225)" headingId="summary-piramide-normativa">
      <p class="margin-top-0 margin-bottom-1 font-body-2xs">
        En materia de informática forense, el Código Orgánico Procesal Penal faculta al perito a fundar su metodología
        en las reglas de su ciencia, arte o técnica. La validez probatoria descansa en la aplicación armónica de:
      </p>
      <!-- USWDS: Tag | https://designsystem.digital.gov/components/tag/ -->
      <div class="display-flex flex-wrap">
        <span class="usa-tag bg-primary-darker margin-right-1 margin-bottom-1 font-mono-3xs">1. CRBV Arts. 28 y 60 (Hábeas Data)</span>
        <span class="usa-tag bg-primary-darker margin-right-1 margin-bottom-1 font-mono-3xs">2. COPP Arts. 187, 223–225</span>
        <span class="usa-tag bg-primary margin-right-1 margin-bottom-1 font-mono-3xs">3. MUCC-2017 (Gaceta N° 41.247)</span>
        <span class="usa-tag bg-accent-warm-dark text-ink text-bold margin-right-1 margin-bottom-1 font-mono-3xs">4. ISO/IEC 27037 / 27042 / 27043</span>
        <span class="usa-tag bg-green margin-bottom-1 font-mono-3xs">5. NIST SP 800-86 / 800-88</span>
      </div>
    </SummaryBox>
  </div>

  <!-- Barra de Búsqueda y Filtros de Normas -->
  <div class="bg-white border-1px border-base-lighter padding-2 margin-bottom-3">
    <div class="grid-row grid-gap flex-align-end">
      <div class="tablet:grid-col-5">
        <!-- USWDS: Text input | https://designsystem.digital.gov/components/text-input/ -->
        <label class="usa-label margin-top-0" for="input-search-normas">
          Filtrar compendio normativo
        </label>
        <input
          class="usa-input"
          id="input-search-normas"
          type="search"
          placeholder="Buscar por código, nombre o descripción..."
        />
      </div>
      <div class="tablet:grid-col-7 margin-top-2 tablet:margin-top-0">
        <!-- USWDS: Button group flex-wrap | https://designsystem.digital.gov/components/button-group/ -->
        <ul class="usa-button-group flex-wrap" id="filtros-tipo-norma">
          <li class="usa-button-group__item">
            <button type="button" class="usa-button font-sans-2xs padding-x-105 padding-y-1 btn-filtro-norma" data-tipo="todos">
              Todas ({NORMATIVAS_INICIALES.length})
            </button>
          </li>
          <li class="usa-button-group__item">
            <button type="button" class="usa-button usa-button--outline font-sans-2xs padding-x-105 padding-y-1 btn-filtro-norma" data-tipo="ISO">
              ISO/IEC
            </button>
          </li>
          <li class="usa-button-group__item">
            <button type="button" class="usa-button usa-button--outline font-sans-2xs padding-x-105 padding-y-1 btn-filtro-norma" data-tipo="NIST">
              NIST
            </button>
          </li>
          <li class="usa-button-group__item">
            <button type="button" class="usa-button usa-button--outline font-sans-2xs padding-x-105 padding-y-1 btn-filtro-norma" data-tipo="LEY">
              Leyes
            </button>
          </li>
          <li class="usa-button-group__item">
            <button type="button" class="usa-button usa-button--outline font-sans-2xs padding-x-105 padding-y-1 btn-filtro-norma" data-tipo="MANUAL">
              Manuales
            </button>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- USWDS: Card | https://designsystem.digital.gov/components/card/ -->
  <ul class="usa-card-group" id="contenedor-normas">
    {NORMATIVAS_INICIALES.map((norma) => (
      <li class="usa-card tablet:grid-col-6 desktop:grid-col-4 card-norma" data-tipo={norma.tipo}>
        <div class="usa-card__container border-top-05 border-primary-darker overflow-hidden">
          <div class="usa-card__header">
            <div class="display-flex flex-justify flex-align-center margin-bottom-1">
              <span class="usa-tag bg-primary-darker font-mono-3xs">{norma.tipo}</span>
              <span class="font-mono-3xs text-base-dark">Vigencia: {norma.version}</span>
            </div>
            <h2 class="usa-card__heading font-heading-sm text-primary">{norma.codigo}</h2>
          </div>
          <div class="usa-card__body">
            <p class="text-bold text-primary-darker margin-top-0 margin-bottom-1 font-body-2xs">
              {norma.nombre}
            </p>
            <p class="font-body-2xs text-base-dark margin-top-0 margin-bottom-2">
              {norma.descripcion}
            </p>
            {norma.articulos && norma.articulos.length > 0 && (
              <div class="bg-base-lightest border-1px border-base-lighter padding-1">
                <p class="font-sans-3xs text-bold text-primary-darker text-uppercase margin-top-0 margin-bottom-05">
                  Artículos y Módulos Clave:
                </p>
                <ul class="usa-list margin-top-0 margin-bottom-0 font-body-3xs">
                  {norma.articulos.map((art) => (
                    <li>{art}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
          <div class="usa-card__footer border-top-1px border-base-lighter padding-top-1">
            <span class="font-mono-3xs text-base-dark">Referencia: {norma.urlReferencia}</span>
          </div>
        </div>
      </li>
    ))}
  </ul>
</AppLayout>

<script>
  const searchInput = document.getElementById('input-search-normas') as HTMLInputElement;
  const botonesFiltro = document.querySelectorAll('.btn-filtro-norma');
  const cards = document.querySelectorAll('.card-norma');

  let tipoActivo = 'todos';

  function filtrarNormas() {
    const q = (searchInput?.value || '').toLowerCase().trim();

    cards.forEach((card) => {
      const tipo = card.getAttribute('data-tipo') || '';
      const text = card.textContent?.toLowerCase() || '';

      const matchTipo = tipoActivo === 'todos' || tipo === tipoActivo;
      const matchText = !q || text.includes(q);

      (card as HTMLElement).hidden = !(matchTipo && matchText);
    });
  }

  if (searchInput) {
    searchInput.addEventListener('input', filtrarNormas);
  }

  botonesFiltro.forEach((btn) => {
    btn.addEventListener('click', () => {
      botonesFiltro.forEach((b) => {
        b.classList.add('usa-button--outline');
      });

      btn.classList.remove('usa-button--outline');

      tipoActivo = btn.getAttribute('data-tipo') || 'todos';
      filtrarNormas();
    });
  });
</script>
