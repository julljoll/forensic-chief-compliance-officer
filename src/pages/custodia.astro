---
/**
 * SHA256.US — Módulo de Cadena de Custodia (PRCC) del CMS de Cumplimiento
 * Cumplimiento estricto del MUCC-2017 (Gaceta Oficial N° 41.247) y COPP Art. 187.
 * Fuentes:
 * - https://designsystem.digital.gov/components/button-group/
 * - https://designsystem.digital.gov/components/alert/
 * - https://designsystem.digital.gov/components/card/
 * - https://designsystem.digital.gov/components/summary-box/
 * - https://designsystem.digital.gov/components/table/
 * - https://designsystem.digital.gov/components/tag/
 */
import AppLayout from '../layouts/AppLayout.astro';
import Alert from '../components/uswds/Alert.astro';
import SummaryBox from '../components/uswds/SummaryBox.astro';
---

<AppLayout title="Cadena de Custodia (PRCC) — SHA256.US" activeNav="custodia">
  <div class="grid-row grid-gap flex-align-center margin-bottom-3">
    <div class="tablet:grid-col-7">
      <h1 class="margin-top-0 margin-bottom-1">
        Cadena de Custodia de Evidencias Digitales
      </h1>
      <p class="usa-intro margin-top-0 margin-bottom-0">
        Control de trazabilidad física y digital ininterrumpida conforme al <strong>MUCC-2017</strong> y <strong>COPP Art. 187</strong>.
      </p>
    </div>

    <div class="tablet:grid-col-5">
      <!-- USWDS: Button group | https://designsystem.digital.gov/components/button-group/ -->
      <ul class="usa-button-group">
        <li class="usa-button-group__item">
          <a id="btn-ver-prcc" href="/planillas/planilla-prcc" class="usa-button">
            Generar Planilla PRCC (Folio)
          </a>
        </li>
        <li class="usa-button-group__item">
          <a id="btn-ver-desprecintado" href="/planillas/acta-desprecintado" class="usa-button usa-button--outline">
            Acta de Desprecintado
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Selector de Caso Activo -->
  <div class="bg-white padding-3 border border-base-lighter margin-bottom-3">
    <div class="grid-row grid-gap flex-align-center">
      <div class="tablet:grid-col-8">
        <p class="margin-0 text-base-dark text-uppercase text-bold font-sans-2xs">Expediente en Custodia</p>
        <h2 class="margin-0" id="custodia-caso-titulo">Expediente en Custodia...</h2>
      </div>
      <div class="tablet:grid-col-4">
        <label class="usa-label margin-top-0" for="select-custodia-caso">
          Seleccionar Expediente en Custodia
        </label>
        <select class="usa-select" id="select-custodia-caso" name="custodia-caso">
          <option value="">Consultando base de datos MySQL...</option>
        </select>
      </div>
    </div>
  </div>

  <!-- USWDS: Alert | https://designsystem.digital.gov/components/alert/ -->
  <Alert
    type="warning"
    heading="Garantía de Intangibilidad y Blindaje Penal (COPP Art. 187)"
    className="margin-bottom-3"
  >
    Toda ruptura en la trazabilidad del precinto, omisión de firmas en la Planilla PRCC o falta de registro en la entrega/recepción
    acarreará la nulidad absoluta de la evidencia digital conforme al artículo 181 y 187 del Código Orgánico Procesal Penal.
  </Alert>

  <!-- USWDS: Card | https://designsystem.digital.gov/components/card/ -->
  <ul class="usa-card-group margin-bottom-3">
    <li class="usa-card tablet:grid-col-6 desktop:grid-col-3">
      <div class="usa-card__container">
        <div class="usa-card__header">
          <h2 class="usa-card__heading">Planilla Oficial PRCC</h2>
        </div>
        <div class="usa-card__body">
          <p class="margin-y-1"><code id="prcc-numero">PRCC-2026-0042</code></p>
          <p class="margin-0"><span class="usa-tag bg-green">Abierta y Registrada</span></p>
        </div>
      </div>
    </li>

    <li class="usa-card tablet:grid-col-6 desktop:grid-col-3">
      <div class="usa-card__container">
        <div class="usa-card__header">
          <h2 class="usa-card__heading">Precinto de Seguridad</h2>
        </div>
        <div class="usa-card__body">
          <p class="margin-y-1"><code id="precinto-numero">PREC-99482-A</code></p>
          <p class="margin-0"><span class="usa-tag bg-accent-warm text-ink">Etiqueta Intacta</span></p>
        </div>
      </div>
    </li>

    <li class="usa-card tablet:grid-col-6 desktop:grid-col-3">
      <div class="usa-card__container">
        <div class="usa-card__header">
          <h2 class="usa-card__heading">Aislamiento RF</h2>
        </div>
        <div class="usa-card__body">
          <p class="margin-y-1"><strong id="aislamiento-rf">Bolsa Faraday Activa</strong></p>
          <p class="margin-0"><span class="usa-tag bg-green">Modo Avión y Blindaje</span></p>
        </div>
      </div>
    </li>

    <li class="usa-card tablet:grid-col-6 desktop:grid-col-3">
      <div class="usa-card__container">
        <div class="usa-card__header">
          <h2 class="usa-card__heading">Ubicación en Bóveda</h2>
        </div>
        <div class="usa-card__body">
          <p class="margin-y-1"><strong>Estante A3 · Gaveta 12</strong></p>
          <p class="margin-0"><span class="usa-tag">Bóveda Climatizada</span></p>
        </div>
      </div>
    </li>
  </ul>

  <!-- USWDS: Summary box | https://designsystem.digital.gov/components/summary-box/ -->
  <SummaryBox
    heading="Requisitos de Custodia — Manual Único de Cadena de Custodia (MUCC-2017)"
    headingId="summary-mucc-2017"
    className="margin-bottom-3"
  >
    <ul class="usa-list">
      <li>
        <strong>1. Modalidad de Obtención:</strong> Consignación formal directa por la víctima / fiscalía requirente.
      </li>
      <li>
        <strong>2. Tipología de Embalaje:</strong> Bolsa antiestática con barrera Faraday y precinto de alta seguridad.
      </li>
      <li>
        <strong>3. Resguardo Temporal:</strong> Depósito en Bóveda bajo llave del Perito Custodio Designado.
      </li>
    </ul>
  </SummaryBox>

  <!-- USWDS: Table | https://designsystem.digital.gov/components/table/ -->
  <div class="bg-white padding-3 border border-base-lighter margin-bottom-3">
    <div class="grid-row grid-gap flex-justify flex-align-center margin-bottom-2">
      <div class="tablet:grid-col-8">
        <h2 class="margin-0">Historial de Transferencias y Traspasos de Custodia</h2>
      </div>
      <div class="tablet:grid-col-4">
        <button id="btn-nueva-transferencia" type="button" class="usa-button usa-button--outline">
          Registrar Traspaso Formal
        </button>
      </div>
    </div>

    <div class="usa-table-container--scrollable" tabindex="0">
      <table class="usa-table usa-table--striped width-full">
        <caption>Bitácora oficial de eslabones de entrega y recepción de evidencia digital</caption>
        <thead>
          <tr>
            <th scope="col">Fecha y Hora</th>
            <th scope="col">Custodio Entrega (Consignante/Perito)</th>
            <th scope="col">Custodio Recibe (Perito/Analista)</th>
            <th scope="col">Propósito / Actividad</th>
            <th scope="col">Estado del Precinto</th>
            <th scope="col">Sello Hash</th>
          </tr>
        </thead>
        <tbody id="tbody-transferencias">
          <tr>
            <th scope="row"><code>2026-07-19 08:30</code></th>
            <td>
              <strong>Carlos Eduardo Méndez</strong><br />
              <span>C.I. V-18.452.901 (Consignante)</span>
            </td>
            <td>
              <strong>Jull Joll</strong><br />
              <span>C.I. V-15.890.123 (Perito Líder)</span>
            </td>
            <td>Recepción y Fijación Inicial en Sitio de Suceso</td>
            <td>
              <span class="usa-tag bg-green">PREC-99482-A (Íntegro)</span>
            </td>
            <td><code>7f83b165...7f04</code></td>
          </tr>
          <tr>
            <th scope="row"><code>2026-07-19 10:15</code></th>
            <td>
              <strong>Jull Joll</strong><br />
              <span>C.I. V-15.890.123 (Perito Líder)</span>
            </td>
            <td>
              <strong>Jull Joll</strong><br />
              <span>Laboratorio Forense SHA256.US</span>
            </td>
            <td>Desprecintado controlado y Clonación Bit-a-Bit E01</td>
            <td>
              <span class="usa-tag bg-accent-warm text-ink">Apertura Controlada</span>
            </td>
            <td><code>e3b0c442...9823</code></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</AppLayout>

<script>
  import { idbGetAll } from '../lib/data/idb';
  import { phpApi } from '../lib/data/phpApi';
  import type { CasoCMS } from '../lib/domain/types';

  const select = document.getElementById('select-custodia-caso') as HTMLSelectElement;
  const btnPrcc = document.getElementById('btn-ver-prcc') as HTMLAnchorElement;
  const btnDesp = document.getElementById('btn-ver-desprecintado') as HTMLAnchorElement;
  const casoTit = document.getElementById('custodia-caso-titulo');

  async function initCustodia() {
    let casos: CasoCMS[] = [];
    try {
      casos = await phpApi.listarCasos();
    } catch {
      casos = await idbGetAll('casos');
    }

    casos = (casos || []).filter((c) => !c.id.startsWith('caso-mock-'));

    if (select) {
      select.innerHTML = '';
      if (casos.length === 0) {
        select.innerHTML = '<option value="">Sin casos sincronizados en MySQL</option>';
        if (casoTit) casoTit.textContent = 'Sin expedientes sincronizados';
        return;
      }

      casos.forEach((c) => {
        const opt = document.createElement('option');
        opt.value = c.id;
        opt.textContent = `${c.numeroCaso} (${c.evidenciaMarca} ${c.evidenciaModelo})`;
        select.appendChild(opt);
      });

      const params = new URLSearchParams(window.location.search);
      const paramId = params.get('casoId');
      if (paramId && casos.some((x) => x.id === paramId)) {
        select.value = paramId;
      } else if (casos.length > 0) {
        select.value = casos[0].id;
      }

      actualizarCaso(select.value, casos);

      select.addEventListener('change', () => {
        actualizarCaso(select.value, casos);
      });
    }

    const btnNuevoTraspaso = document.getElementById('btn-nueva-transferencia');
    if (btnNuevoTraspaso) {
      btnNuevoTraspaso.addEventListener('click', () => {
        const motivo = prompt('Ingrese el motivo de la transferencia de custodia:');
        if (motivo) {
          alert('Transferencia registrada exitosamente en la Planilla PRCC.');
        }
      });
    }
  }

  function actualizarCaso(casoId: string, casos: CasoCMS[]) {
    const c = casos.find((x) => x.id === casoId);
    if (!c) return;

    if (casoTit) casoTit.textContent = `${c.numeroCaso} — ${c.titulo}`;
    if (btnPrcc) btnPrcc.href = `/planillas/planilla-prcc?casoId=${c.id}`;
    if (btnDesp) btnDesp.href = `/planillas/acta-desprecintado?casoId=${c.id}`;
  }

  if (typeof window !== 'undefined') {
    initCustodia();
  }
</script>

