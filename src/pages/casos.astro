---
/**
 * SHA256.US — Directorio de Expedientes Periciales y Apertura de Caso del CMS
 * Implementado con componentes USWDS Estricto (@uswds/uswds) y almacenamiento híbrido PHP/IndexedDB.
 * Fuentes:
 * - https://designsystem.digital.gov/components/modal/
 * - https://designsystem.digital.gov/components/table/
 * - https://designsystem.digital.gov/components/form/
 * - https://designsystem.digital.gov/components/checkbox/
 * - https://designsystem.digital.gov/components/button-group/
 * - https://designsystem.digital.gov/components/alert/
 * - https://designsystem.digital.gov/components/tag/
 */
import AppLayout from '../layouts/AppLayout.astro';
import Alert from '../components/uswds/Alert.astro';
---

<AppLayout title="Expedientes Periciales — SHA256.US" activeNav="casos">
  <div class="grid-row grid-gap flex-align-center margin-bottom-3">
    <div class="tablet:grid-col-8">
      <h1 class="margin-top-0 margin-bottom-1">
        Directorio de Expedientes Periciales
      </h1>
      <p class="usa-intro margin-top-0 margin-bottom-0">
        Gestión centralizada de investigaciones forenses, asignación pericial y control de evidencias digitales.
      </p>
    </div>
    <div class="tablet:grid-col-4">
      <!-- USWDS: Modal trigger | https://designsystem.digital.gov/components/modal/ -->
      <a
        href="#modal-nuevo-caso"
        id="btn-abrir-modal-nuevo"
        class="usa-button"
        aria-controls="modal-nuevo-caso"
        data-open-modal
      >
        Aperturar Nuevo Expediente
      </a>
    </div>
  </div>

  <!-- USWDS: Form controls for filtering | https://designsystem.digital.gov/components/form/ -->
  <div class="bg-white padding-3 border border-base-lighter margin-bottom-3">
    <div class="grid-row grid-gap flex-align-end">
      <div class="tablet:grid-col-6">
        <label class="usa-label margin-top-0" for="input-search">
          Buscar por N° Caso, Expediente, Consignante o Serial
        </label>
        <input
          class="usa-input"
          id="input-search"
          name="search"
          type="search"
        />
      </div>
      <div class="tablet:grid-col-4">
        <label class="usa-label margin-top-0" for="select-filtro-tipo">
          Tipología Pericial
        </label>
        <select class="usa-select" id="select-filtro-tipo" name="filtro-tipo">
          <option value="todos">Todas las tipologías</option>
          <option value="forense_whatsapp">WhatsApp Forense</option>
          <option value="forense_email">Email Forense (RFC 3227)</option>
          <option value="forense_discoduro">Disco Duro (E01/DD)</option>
          <option value="forense_imagen">Imagen Forense (ISO 27037)</option>
        </select>
      </div>
      <div class="tablet:grid-col-2">
        <p class="margin-bottom-1">
          Mostrando: <strong id="contador-casos">0</strong> expedientes
        </p>
      </div>
    </div>
  </div>

  <!-- USWDS: Table | https://designsystem.digital.gov/components/table/ -->
  <div class="bg-white padding-3 border border-base-lighter margin-bottom-4">
    <div class="usa-table-container--scrollable" tabindex="0">
      <table class="usa-table usa-table--striped width-full" id="tabla-expedientes">
        <caption>Directorio de expedientes periciales registrados en el CMS de cumplimiento</caption>
        <thead>
          <tr>
            <th scope="col">N° Expediente / Caso</th>
            <th scope="col">Tipología</th>
            <th scope="col">Consignante / C.I.</th>
            <th scope="col">Evidencia Incautada</th>
            <th scope="col">Fase ISO</th>
            <th scope="col">Estado Cripto</th>
            <th scope="col">Acciones de Gestión</th>
          </tr>
        </thead>
        <tbody id="tbody-casos">
          <tr>
            <td colspan="7">Consultando expedientes sincronizados en MySQL...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- USWDS: Modal (Large) | https://designsystem.digital.gov/components/modal/ -->
  <div
    class="usa-modal usa-modal--lg"
    id="modal-nuevo-caso"
    aria-labelledby="modal-nuevo-caso-heading"
    aria-describedby="modal-nuevo-caso-description"
  >
    <div class="usa-modal__content">
      <div class="usa-modal__main">
        <h2 class="usa-modal__heading" id="modal-nuevo-caso-heading">
          Apertura Oficial de Expediente Forense
        </h2>
        <div class="usa-prose">
          <p id="modal-nuevo-caso-description">
            Los datos ingresados se replicarán automáticamente en las 13 planillas oficiales legales (Folio 216mm × 330mm).
          </p>
        </div>

        <form id="form-nuevo-caso">
          <!-- Sección 1: Datos Procesales -->
          <fieldset class="usa-fieldset margin-top-2">
            <legend class="usa-legend text-bold">
              1. Identificación del Caso y Tipología
            </legend>
            <div class="grid-row grid-gap">
              <div class="tablet:grid-col-6">
                <label class="usa-label" for="nuevo-numeroCaso">
                  N° de Caso Interno <abbr title="obligatorio" class="usa-hint usa-hint--required">*</abbr>
                </label>
                <input class="usa-input" id="nuevo-numeroCaso" name="numeroCaso" required />
              </div>
              <div class="tablet:grid-col-6">
                <label class="usa-label" for="nuevo-expediente">
                  N° de Expediente Judicial / Fiscalía <abbr title="obligatorio" class="usa-hint usa-hint--required">*</abbr>
                </label>
                <input class="usa-input" id="nuevo-expediente" name="expediente" required />
              </div>
            </div>

            <div class="grid-row grid-gap">
              <div class="tablet:grid-col-6">
                <label class="usa-label" for="nuevo-tipoProyecto">
                  Tipología Forense <abbr title="obligatorio" class="usa-hint usa-hint--required">*</abbr>
                </label>
                <select class="usa-select" id="nuevo-tipoProyecto" name="tipoProyecto" required>
                  <option value="forense_whatsapp">WhatsApp Forense (msgstore.db)</option>
                  <option value="forense_email">Email Forense (SMTP/RFC 3227)</option>
                  <option value="forense_discoduro">Disco Duro (Clonado E01/DD)</option>
                  <option value="forense_imagen">Adquisición Imagen (ISO 27037)</option>
                </select>
              </div>
              <div class="tablet:grid-col-6">
                <label class="usa-label" for="nuevo-prioridad">Prioridad Procesal</label>
                <select class="usa-select" id="nuevo-prioridad" name="prioridad">
                  <option value="media">Media (Estándar)</option>
                  <option value="alta">Alta (Flagrancia / Notitia Criminis)</option>
                  <option value="urgente">Urgente (Riesgo de Destrucción)</option>
                </select>
              </div>
            </div>

            <label class="usa-label" for="nuevo-titulo">
              Título o Asunto del Peritaje <abbr title="obligatorio" class="usa-hint usa-hint--required">*</abbr>
            </label>
            <input class="usa-input" id="nuevo-titulo" name="titulo" required />

            <label class="usa-label" for="nuevo-descripcion">Objeto de la Peritación y Alcance</label>
            <textarea class="usa-textarea" id="nuevo-descripcion" name="descripcion" rows="2"></textarea>
          </fieldset>

          <!-- Sección 2: Consignante / Solicitante -->
          <fieldset class="usa-fieldset margin-top-3">
            <legend class="usa-legend text-bold">
              2. Datos del Consignante / Solicitante
            </legend>
            <div class="grid-row grid-gap">
              <div class="tablet:grid-col-8">
                <label class="usa-label" for="nuevo-consignanteNombre">
                  Nombre y Apellido <abbr title="obligatorio" class="usa-hint usa-hint--required">*</abbr>
                </label>
                <input class="usa-input" id="nuevo-consignanteNombre" name="consignanteNombre" required />
              </div>
              <div class="tablet:grid-col-4">
                <label class="usa-label" for="nuevo-consignanteCedula">
                  Cédula de Identidad <abbr title="obligatorio" class="usa-hint usa-hint--required">*</abbr>
                </label>
                <input class="usa-input" id="nuevo-consignanteCedula" name="consignanteCedula" required />
              </div>
            </div>

            <div class="grid-row grid-gap">
              <div class="tablet:grid-col-6">
                <label class="usa-label" for="nuevo-consignanteTelefono">Teléfono de Contacto</label>
                <input class="usa-input" id="nuevo-consignanteTelefono" name="consignanteTelefono" />
              </div>
              <div class="tablet:grid-col-6">
                <label class="usa-label" for="nuevo-consignanteEmail">Correo Electrónico</label>
                <input class="usa-input" id="nuevo-consignanteEmail" name="consignanteEmail" type="email" />
              </div>
            </div>

            <label class="usa-label" for="nuevo-consignanteDireccion">Dirección de Residencia / Despacho</label>
            <input class="usa-input" id="nuevo-consignanteDireccion" name="consignanteDireccion" />
          </fieldset>

          <!-- Sección 3: Evidencia Digital -->
          <fieldset class="usa-fieldset margin-top-3">
            <legend class="usa-legend text-bold">
              3. Registro Técnico de la Evidencia Digital
            </legend>
            <div class="grid-row grid-gap">
              <div class="tablet:grid-col-4">
                <label class="usa-label" for="nuevo-evidenciaTipo">Tipo Dispositivo</label>
                <input class="usa-input" id="nuevo-evidenciaTipo" name="evidenciaTipo" />
              </div>
              <div class="tablet:grid-col-4">
                <label class="usa-label" for="nuevo-evidenciaMarca">
                  Marca <abbr title="obligatorio" class="usa-hint usa-hint--required">*</abbr>
                </label>
                <input class="usa-input" id="nuevo-evidenciaMarca" name="evidenciaMarca" required />
              </div>
              <div class="tablet:grid-col-4">
                <label class="usa-label" for="nuevo-evidenciaModelo">
                  Modelo <abbr title="obligatorio" class="usa-hint usa-hint--required">*</abbr>
                </label>
                <input class="usa-input" id="nuevo-evidenciaModelo" name="evidenciaModelo" required />
              </div>
            </div>

            <div class="grid-row grid-gap">
              <div class="tablet:grid-col-4">
                <label class="usa-label" for="nuevo-evidenciaSerial">
                  Serial / IMEI <abbr title="obligatorio" class="usa-hint usa-hint--required">*</abbr>
                </label>
                <input class="usa-input" id="nuevo-evidenciaSerial" name="evidenciaSerial" required />
              </div>
              <div class="tablet:grid-col-4">
                <label class="usa-label" for="nuevo-evidenciaColor">Color / Aspecto</label>
                <input class="usa-input" id="nuevo-evidenciaColor" name="evidenciaColor" />
              </div>
              <div class="tablet:grid-col-4">
                <label class="usa-label" for="nuevo-evidenciaEstado">Estado Físico</label>
                <input class="usa-input" id="nuevo-evidenciaEstado" name="evidenciaEstado" />
              </div>
            </div>

            <!-- USWDS: Checkbox | https://designsystem.digital.gov/components/checkbox/ -->
            <div class="usa-checkbox margin-top-2">
              <input
                class="usa-checkbox__input"
                type="checkbox"
                id="nuevo-evidenciaAislamientoRF"
                name="evidenciaAislamientoRF"
              />
              <label class="usa-checkbox__label" for="nuevo-evidenciaAislamientoRF">
                Aislamiento RF Aplicado (Bolsa Faraday y Modo Avión obligatorio según ISO 27037)
              </label>
            </div>
          </fieldset>

          <div class="usa-modal__footer">
            <!-- USWDS: Button group | https://designsystem.digital.gov/components/button-group/ -->
            <ul class="usa-button-group">
              <li class="usa-button-group__item">
                <button type="submit" class="usa-button">
                  Registrar Expediente e Iniciar F0
                </button>
              </li>
              <li class="usa-button-group__item">
                <button
                  type="button"
                  id="btn-cancelar-modal"
                  class="usa-button usa-button--unstyled padding-105 text-center"
                  data-close-modal
                >
                  Cancelar
                </button>
              </li>
            </ul>
          </div>
        </form>
      </div>
      <button
        type="button"
        id="btn-cerrar-modal"
        class="usa-button usa-modal__close"
        aria-label="Cerrar esta ventana"
        data-close-modal
      >
        <svg class="usa-icon" aria-hidden="true" focusable="false" role="img">
          <use href="/assets/uswds/img/sprite.svg#close"></use>
        </svg>
      </button>
    </div>
  </div>
</AppLayout>

<script>
  import { phpApi } from '../lib/data/phpApi';
  import { idbPut } from '../lib/data/idb';
  import type { CasoCMS } from '../lib/domain/types';

  const btnAbrir = document.getElementById('btn-abrir-modal-nuevo');
  const form = document.getElementById('form-nuevo-caso') as HTMLFormElement;

  if (typeof window !== 'undefined') {
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('nuevo') === '1') {
      setTimeout(() => {
        btnAbrir?.click();
      }, 200);
    }
  }

  const searchInput = document.getElementById('input-search') as HTMLInputElement;
  const filterSelect = document.getElementById('select-filtro-tipo') as HTMLSelectElement;
  const tbody = document.getElementById('tbody-casos');
  const contador = document.getElementById('contador-casos');

  function aplicarFiltros() {
    if (!tbody) return;
    const q = (searchInput?.value || '').toLowerCase().trim();
    const tipo = filterSelect?.value || 'todos';

    let visibles = 0;
    const filas = tbody.querySelectorAll('tr');
    filas.forEach((tr) => {
      const text = tr.textContent?.toLowerCase() || '';
      const filaTipo = tr.getAttribute('data-tipo') || '';

      const coincideTexto = !q || text.includes(q);
      const coincideTipo = tipo === 'todos' || filaTipo === tipo;

      if (coincideTexto && coincideTipo) {
        tr.hidden = false;
        visibles++;
      } else {
        tr.hidden = true;
      }
    });

    if (contador) contador.textContent = String(visibles);
  }

  if (searchInput) searchInput.addEventListener('input', aplicarFiltros);
  if (filterSelect) filterSelect.addEventListener('change', aplicarFiltros);

  let casosSincronizados: CasoCMS[] = [];

  function renderizarFilaCaso(c: CasoCMS): string {
    const tipo = (c.tipoProyecto || '').replace('forense_', '').toUpperCase();
    return `
      <tr data-id="${c.id}" data-tipo="${c.tipoProyecto}">
        <th scope="row">
          <strong>${c.numeroCaso}</strong><br />
          <code>${c.expediente || 'S/E'}</code><br />
          <span>${c.titulo}</span>
        </th>
        <td>
          <span class="usa-tag">${tipo}</span>
        </td>
        <td>
          <strong>${c.consignanteNombre || 'Consignante no reg.'}</strong><br />
          <span>C.I. ${c.consignanteCedula || 'N/A'}</span><br />
          <span>Tlf: ${c.consignanteTelefono || 'N/A'}</span>
        </td>
        <td>
          <strong>${c.evidenciaMarca || ''} ${c.evidenciaModelo || ''}</strong><br />
          <code>S/N: ${c.evidenciaSerial || 'N/A'}</code><br />
          <span>Bolsa Faraday: ${c.evidenciaAislamientoRF ? 'Aislado RF' : 'No'}</span>
        </td>
        <td>
          <span class="usa-tag bg-primary">${c.faseIsoActual || 'F0'}</span>
        </td>
        <td>
          <span class="usa-tag bg-green">Sincronizado DB</span>
        </td>
        <td>
          <ul class="usa-button-group">
            <li class="usa-button-group__item">
              <a href="/flujo?casoId=${c.id}" class="usa-button">
                Fases ISO
              </a>
            </li>
            <li class="usa-button-group__item">
              <a href="/planillas/planilla-prcc?casoId=${c.id}" class="usa-button usa-button--outline">
                PRCC
              </a>
            </li>
            <li class="usa-button-group__item">
              <a href="/planillas?casoId=${c.id}" class="usa-button usa-button--outline">
                Planillas
              </a>
            </li>
          </ul>
        </td>
      </tr>
    `;
  }

  async function cargarCasosSincronizados() {
    try {
      const data = await phpApi.listarCasos();
      casosSincronizados = (data || []).filter((c) => !c.id.startsWith('caso-mock-'));

      if (!tbody) return;

      if (casosSincronizados.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7">
              <p><strong>No hay expedientes sincronizados en la base de datos MySQL.</strong></p>
              <p>Aperture un nuevo expediente pericial o importe el archivo <code>database.sql</code> en phpMyAdmin.</p>
            </td>
          </tr>
        `;
        if (contador) contador.textContent = '0';
        return;
      }

      tbody.innerHTML = casosSincronizados.map(renderizarFilaCaso).join('');
      if (contador) contador.textContent = String(casosSincronizados.length);
      aplicarFiltros();
    } catch (e) {
      console.error('Error cargando casos sincronizados:', e);
    }
  }

  if (typeof window !== 'undefined') {
    cargarCasosSincronizados();
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);

      const nuevoId = 'caso-' + Date.now();
      const nuevoCaso: CasoCMS = {
        id: nuevoId,
        numeroCaso: String(formData.get('numeroCaso') || ''),
        expediente: String(formData.get('expediente') || ''),
        tipoProyecto: (formData.get('tipoProyecto') as any) || 'forense_whatsapp',
        titulo: String(formData.get('titulo') || ''),
        descripcion: String(formData.get('descripcion') || ''),
        prioridad: (formData.get('prioridad') as any) || 'media',
        estado: 'iniciado',
        faseIsoActual: 'F0',
        fechaCreacion: new Date().toISOString(),
        fechaUltimaActualizacion: new Date().toISOString(),

        consignanteNombre: String(formData.get('consignanteNombre') || ''),
        consignanteCedula: String(formData.get('consignanteCedula') || ''),
        consignanteTelefono: String(formData.get('consignanteTelefono') || ''),
        consignanteEmail: String(formData.get('consignanteEmail') || ''),
        consignanteDireccion: String(formData.get('consignanteDireccion') || ''),

        evidenciaTipo: String(formData.get('evidenciaTipo') || 'Dispositivo'),
        evidenciaMarca: String(formData.get('evidenciaMarca') || ''),
        evidenciaModelo: String(formData.get('evidenciaModelo') || ''),
        evidenciaSerial: String(formData.get('evidenciaSerial') || ''),
        evidenciaColor: String(formData.get('evidenciaColor') || ''),
        evidenciaEstado: String(formData.get('evidenciaEstado') || 'Operativo'),
        evidenciaAislamientoRF: formData.get('evidenciaAislamientoRF') === 'on',

        fiscaliaTribunal: 'Ministerio Público / Tribunal de Control',
        peritoLiderNombre: 'Jull Joll',
        peritoLiderCedula: 'V-15.890.123',
        peritoLiderCiv: 'CIV-284910',
      };

      try {
        await phpApi.guardarCaso(nuevoCaso);
        await idbPut('casos', nuevoCaso);
        alert(`Expediente ${nuevoCaso.numeroCaso} registrado con éxito bajo normativa ISO/IEC 27037.`);
        window.location.href = `/flujo?casoId=${nuevoCaso.id}`;
      } catch (err: any) {
        console.error('Error guardando en backend:', err);
        await idbPut('casos', nuevoCaso);
        alert(`Expediente ${nuevoCaso.numeroCaso} guardado localmente (modo offline).`);
        window.location.href = `/flujo?casoId=${nuevoCaso.id}`;
      }
    });
  }
</script>

