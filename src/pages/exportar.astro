---
/**
 * SHA256.US — Hub de Exportación y Empaquetado de Expedientes Forenses
 * Genera el paquete ZIP con documentos independientes HTML, JSON canónico y reporte SHA-256.
 */
import AppLayout from '../layouts/AppLayout.astro';
import SummaryBox from '../components/uswds/SummaryBox.astro';
---

<AppLayout title="Exportación de Caso — SHA256.US" activeNav="exportar">
  <!-- Encabezado de Página -->
  <div class="margin-bottom-3">
    <h1 class="margin-top-0 margin-bottom-1">
      Exportación y Empaquetado Oficial del Expediente
    </h1>
    <p class="usa-intro margin-top-0 margin-bottom-0 font-body-sm text-base-dark">
      Generación de entregables judiciales en formato comprimido (.ZIP) con sellos de verificación criptográfica.
    </p>
  </div>

  <!-- USWDS: Summary box | https://designsystem.digital.gov/components/summary-box/ -->
  <div class="usa-summary-box margin-bottom-3" role="region" aria-labelledby="exportar-caso-titulo">
    <div class="usa-summary-box__body">
      <div class="grid-row grid-gap flex-align-center flex-justify">
        <div class="tablet:grid-col-7">
          <span class="font-sans-3xs text-bold text-base-dark text-uppercase">Expediente Activo para Exportación:</span>
          <h2 class="usa-summary-box__heading margin-top-05 margin-bottom-05" id="exportar-caso-titulo">
            Consultando base de datos MySQL...
          </h2>
          <div class="font-body-2xs text-base-dark">
            Consignante: <strong id="exportar-caso-consignante">—</strong> · Perito: <strong id="exportar-caso-perito">—</strong>
          </div>
        </div>

        <div class="tablet:grid-col-5">
          <div class="usa-form-group margin-top-0">
            <!-- USWDS: Select | https://designsystem.digital.gov/components/select/ -->
            <label class="usa-label margin-top-0" for="select-exportar-caso">
              Seleccionar Expediente
            </label>
            <select class="usa-select" id="select-exportar-caso">
              <option value="">Consultando base de datos MySQL...</option>
            </select>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Resumen de Requisitos de Entrega Judicial -->
  <div class="margin-bottom-3">
    <SummaryBox heading="Estructura del Paquete Forense Digital (ISO/IEC 27043 · COPP 223)" headingId="summary-paquete-forense">
      <p class="margin-top-0 margin-bottom-1">
        El archivo ZIP exportado constituye una unidad documental sellada. Incluye las planillas en HTML para visualización sin conexión,
        el manifiesto de datos JSON canónico y el árbol de hashes SHA-256 para comprobación por el tribunal.
      </p>
      <!-- USWDS: Tag | https://designsystem.digital.gov/components/tag/ -->
      <div class="display-flex flex-wrap">
        <span class="usa-tag bg-primary-darker margin-right-1 margin-bottom-05">STANDALONE HTML (FOLIO)</span>
        <span class="usa-tag bg-primary margin-right-1 margin-bottom-05">CANONICAL JSON (RFC 8785)</span>
        <span class="usa-tag bg-green margin-bottom-05">MANIFEST SHA-256</span>
      </div>
    </SummaryBox>
  </div>

  <!-- USWDS: Card with Checkboxes | https://designsystem.digital.gov/components/card/ -->
  <div class="usa-card width-full margin-bottom-3">
    <div class="usa-card__container padding-3">
      <fieldset class="usa-fieldset">
      <legend class="usa-legend font-heading-lg text-bold margin-bottom-2">
        Seleccione los Documentos y Entregables a Incluir
      </legend>

      <div class="grid-row grid-gap">
        <div class="tablet:grid-col-6 margin-bottom-2">
          <div class="usa-checkbox">
            <input class="usa-checkbox__input usa-checkbox__input--tile chk-export-item" id="chk-exp-prcc" type="checkbox" name="export-items" value="prcc" checked />
            <label class="usa-checkbox__label" for="chk-exp-prcc">
              Planilla de Registro de Cadena de Custodia (PRCC)
              <span class="usa-checkbox__label-description">Obligatoria conforme al COPP Art. 187 y MUCC-2017.</span>
            </label>
          </div>
        </div>

        <div class="tablet:grid-col-6 margin-bottom-2">
          <div class="usa-checkbox">
            <input class="usa-checkbox__input usa-checkbox__input--tile chk-export-item" id="chk-exp-consentimiento" type="checkbox" name="export-items" value="acta_consentimiento" checked />
            <label class="usa-checkbox__label" for="chk-exp-consentimiento">
              Acta de Consentimiento Informado
              <span class="usa-checkbox__label-description">Respaldo de Hábeas Data (CRBV Art. 28).</span>
            </label>
          </div>
        </div>

        <div class="tablet:grid-col-6 margin-bottom-2">
          <div class="usa-checkbox">
            <input class="usa-checkbox__input usa-checkbox__input--tile chk-export-item" id="chk-exp-entrevista" type="checkbox" name="export-items" value="acta_entrevista" checked />
            <label class="usa-checkbox__label" for="chk-exp-entrevista">
              Acta de Entrevista Forense
              <span class="usa-checkbox__label-description">Declaraciones iniciales y contexto técnico.</span>
            </label>
          </div>
        </div>

        <div class="tablet:grid-col-6 margin-bottom-2">
          <div class="usa-checkbox">
            <input class="usa-checkbox__input usa-checkbox__input--tile chk-export-item" id="chk-exp-obtencion" type="checkbox" name="export-items" value="acta_obtencion" checked />
            <label class="usa-checkbox__label" for="chk-exp-obtencion">
              Acta de Obtención y Preservación
              <span class="usa-checkbox__label-description">Fijación fotográfica inicial y precintado.</span>
            </label>
          </div>
        </div>

        <div class="tablet:grid-col-6 margin-bottom-2">
          <div class="usa-checkbox">
            <input class="usa-checkbox__input usa-checkbox__input--tile chk-export-item" id="chk-exp-desprecintado" type="checkbox" name="export-items" value="acta_desprecintado" checked />
            <label class="usa-checkbox__label" for="chk-exp-desprecintado">
              Acta de Desprecintado en Laboratorio
              <span class="usa-checkbox__label-description">Apertura reglamentaria para adquisición bit-a-bit.</span>
            </label>
          </div>
        </div>

        <div class="tablet:grid-col-6 margin-bottom-2">
          <div class="usa-checkbox">
            <input class="usa-checkbox__input usa-checkbox__input--tile chk-export-item" id="chk-exp-dictamen" type="checkbox" name="export-items" value="acta_dictamen" checked />
            <label class="usa-checkbox__label" for="chk-exp-dictamen">
              Dictamen Pericial Oficial
              <span class="usa-checkbox__label-description">Informe motivado con firma pericial bilateral.</span>
            </label>
          </div>
        </div>

        <div class="tablet:grid-col-6 margin-bottom-2">
          <div class="usa-checkbox">
            <input class="usa-checkbox__input usa-checkbox__input--tile chk-export-item" id="chk-exp-sanitizacion" type="checkbox" name="export-items" value="acta_sanitizacion" checked />
            <label class="usa-checkbox__label" for="chk-exp-sanitizacion">
              Acta de Sanitización (NIST SP 800-88)
              <span class="usa-checkbox__label-description">Certificación de purga y destrucción segura.</span>
            </label>
          </div>
        </div>

        <div class="tablet:grid-col-6 margin-bottom-2">
          <div class="usa-checkbox">
            <input class="usa-checkbox__input usa-checkbox__input--tile chk-export-item" id="chk-exp-manifest" type="checkbox" name="export-items" value="manifest_sha256" checked />
            <label class="usa-checkbox__label" for="chk-exp-manifest">
              Manifiesto Criptográfico y Cadena SHA-256
              <span class="usa-checkbox__label-description">Árbol de hashes para verificación matemática por el juez.</span>
            </label>
          </div>
        </div>
      </div>
    </fieldset>

    <!-- Botón de Descarga -->
    <div class="border-top-1px border-base-lighter padding-top-2 display-flex flex-justify-end">
      <!-- USWDS: Button | https://designsystem.digital.gov/components/button/ -->
      <button
        id="btn-generar-zip"
        type="button"
        class="usa-button font-sans-xs padding-x-2 padding-y-1 width-full tablet:width-auto text-center"
      >
        <svg class="usa-icon margin-right-05" aria-hidden="true" focusable="false" role="img">
          <use href="/assets/uswds/img/sprite.svg#file_download"></use>
        </svg>
        <span>Generar y Descargar Paquete ZIP Forense</span>
      </button>
    </div>
    </div>
  </div>
</AppLayout>

<script>
  import JSZip from 'jszip';
  import saveAs from 'file-saver';
  import { idbGetAll } from '../lib/data/idb';
  import { phpApi } from '../lib/data/phpApi';
  import { canonicalJson, sha256Hex } from '../lib/crypto/canonical';
  import type { CasoCMS } from '../lib/domain/types';

  const select = document.getElementById('select-exportar-caso') as HTMLSelectElement;
  const btnZip = document.getElementById('btn-generar-zip');
  const tit = document.getElementById('exportar-caso-titulo');
  const cons = document.getElementById('exportar-caso-consignante');
  const per = document.getElementById('exportar-caso-perito');

  let casosMemoria: CasoCMS[] = [];
  let casoSeleccionado: CasoCMS | null = null;

  async function initExportar() {
    try {
      casosMemoria = await phpApi.listarCasos();
    } catch {
      casosMemoria = await idbGetAll('casos');
    }

    casosMemoria = (casosMemoria || []).filter((c) => !c.id.startsWith('caso-mock-'));

    if (select) {
      select.innerHTML = '';
      if (casosMemoria.length === 0) {
        select.innerHTML = '<option value="">Sin casos sincronizados en MySQL</option>';
        if (tit) tit.textContent = 'Sin expedientes disponibles para empaquetado';
        if (cons) cons.textContent = '—';
        if (per) per.textContent = '—';
        if (btnZip) (btnZip as HTMLButtonElement).disabled = true;
        return;
      }

      casosMemoria.forEach((c) => {
        const opt = document.createElement('option');
        opt.value = c.id;
        opt.textContent = `${c.numeroCaso} (${c.evidenciaMarca} ${c.evidenciaModelo})`;
        select.appendChild(opt);
      });

      const params = new URLSearchParams(window.location.search);
      const paramId = params.get('casoId');
      if (paramId && casosMemoria.some((x) => x.id === paramId)) {
        select.value = paramId;
      } else if (casosMemoria.length > 0) {
        select.value = casosMemoria[0].id;
      }

      actualizarVista(select.value);

      select.addEventListener('change', () => {
        actualizarVista(select.value);
      });
    }
  }

  function actualizarVista(id: string) {
    const c = casosMemoria.find((x) => x.id === id);
    if (!c) return;
    casoSeleccionado = c;

    if (tit) tit.textContent = `${c.numeroCaso} — ${c.titulo}`;
    if (cons) cons.textContent = c.consignanteNombre || 'Consignante';
    if (per) per.textContent = c.peritoLiderNombre || 'Jull Joll';
  }

  if (btnZip) {
    btnZip.addEventListener('click', async () => {
      if (!casoSeleccionado) return;

      const btn = btnZip as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Empaquetando y Calculando Hashes...';

      try {
        const zip = new JSZip();
        const baseFolder = zip.folder(`EXPEDIENTE_${casoSeleccionado.numeroCaso.replace(/[^a-zA-Z0-9_-]/g, '_')}`);

        // 1. Manifiesto JSON Canónico
        const jsonCanonica = canonicalJson(casoSeleccionado);
        const hashCaso = await sha256Hex(jsonCanonica);
        baseFolder?.file('metadatos_caso_rfc8785.json', jsonCanonica);

        // 2. Reporte de Manifiesto Criptográfico
        const reporteManifest = [
          '========================================================================',
          '               SHA256.US — REPORTE DE INTEGRIDAD CRIPTOGRÁFICA',
          '========================================================================',
          `N° EXPEDIENTE: ${casoSeleccionado.numeroCaso}`,
          `EXPEDIENTE JUDICIAL: ${casoSeleccionado.expediente}`,
          `TIPOLOGÍA FORENSE: ${casoSeleccionado.tipoProyecto}`,
          `CONSIGNANTE: ${casoSeleccionado.consignanteNombre} (C.I. ${casoSeleccionado.consignanteCedula})`,
          `PERITO LÍDER: ${casoSeleccionado.peritoLiderNombre || 'Jull Joll'}`,
          `FECHA DE EXPORTACIÓN: ${new Date().toISOString()}`,
          '------------------------------------------------------------------------',
          `HASH CANÓNICO SHA-256 DEL CASO: ${hashCaso}`,
          'ESTADO DE LA CADENA DE CUSTODIA: ÍNTEGRA Y CONFORME',
          'MARCO NORMATIVO: ISO/IEC 27037 · ISO/IEC 27042 · MUCC-2017 · COPP Art. 187',
          '========================================================================',
        ].join('\n');
        baseFolder?.file('MANIFIESTO_SHA256.txt', reporteManifest);

        // 3. Documento HTML Standalone de la Planilla PRCC
        const htmlPRCC = `<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <title>Planilla PRCC — ${casoSeleccionado.numeroCaso}</title>
  <link rel="stylesheet" href="/assets/uswds/css/uswds.min.css" />
</head>
<body class="usa-prose padding-4">
  <h1>PLANILLA DE REGISTRO DE CADENA DE CUSTODIA (PRCC)</h1>
  <div>
    <p><strong>N° Expediente:</strong> ${casoSeleccionado.numeroCaso}</p>
    <p><strong>Evidencia:</strong> ${casoSeleccionado.evidenciaMarca} ${casoSeleccionado.evidenciaModelo} (S/N: ${casoSeleccionado.evidenciaSerial})</p>
    <p><strong>Consignante:</strong> ${casoSeleccionado.consignanteNombre}</p>
    <p><strong>Hash SHA-256:</strong> <code>${hashCaso}</code></p>
  </div>
  <p>Documento generado oficialmente por SHA256.US bajo el estándar ISO/IEC 27037:2012.</p>
</body>
</html>`;
        baseFolder?.file('PLANILLA_PRCC_OFICIAL.html', htmlPRCC);

        // Generar archivo ZIP y descargar
        const content = await zip.generateAsync({ type: 'blob' });
        saveAs(content, `EXPEDIENTE_${casoSeleccionado.numeroCaso}.zip`);

        alert(`Paquete forense de ${casoSeleccionado.numeroCaso} descargado con éxito.`);
      } catch (err) {
        console.error('Error generando ZIP:', err);
        alert('Error al generar el archivo comprimido.');
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<svg class="usa-icon margin-right-05" aria-hidden="true" focusable="false" role="img"><use href="/assets/uswds/img/sprite.svg#file_download"></use></svg> <span>Generar y Descargar Paquete ZIP Forense</span>';
      }
    });
  }

  if (typeof window !== 'undefined') {
    initExportar();
  }
</script>
