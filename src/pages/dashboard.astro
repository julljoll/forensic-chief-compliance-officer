---
/**
 * SHA256.US — Panel General del CMS de Cumplimiento Forense
 * Implementado con USWDS Estricto (@uswds/uswds) y datos reactivos (PHP/MySQL + IndexedDB).
 * Fuentes:
 * - https://designsystem.digital.gov/components/button-group/
 * - https://designsystem.digital.gov/components/alert/
 * - https://designsystem.digital.gov/components/card/
 * - https://designsystem.digital.gov/components/summary-box/
 * - https://designsystem.digital.gov/components/table/
 * - https://designsystem.digital.gov/components/tag/
 */
import AppLayout from '../layouts/AppLayout.astro';
import SummaryBox from '../components/uswds/SummaryBox.astro';
import Alert from '../components/uswds/Alert.astro';
---

<AppLayout title="Forensic Chief Compliance Officer — Panel General" activeNav="dashboard">
  <div class="grid-row grid-gap flex-align-center margin-bottom-3">
    <div class="tablet:grid-col-7">
      <h1 class="margin-top-0 margin-bottom-1">
        Forensic Chief Compliance Officer — Panel General
      </h1>
      <p class="usa-intro margin-top-0 margin-bottom-0 font-body-sm text-base-dark">
        CMS de monitoreo de expedientes periciales, sellos criptográficos SHA-256 y cumplimiento ISO/IEC.
      </p>
    </div>
    <div class="tablet:grid-col-5">
      <!-- USWDS: Button group | https://designsystem.digital.gov/components/button-group/ -->
      <ul class="usa-button-group flex-wrap tablet:flex-justify-end">
        <li class="usa-button-group__item">
          <a href="/casos?nuevo=1" class="usa-button font-sans-xs padding-x-2 padding-y-1">
            Aperturar Nuevo Expediente
          </a>
        </li>
        <li class="usa-button-group__item">
          <a href="/auditoria" class="usa-button usa-button--outline font-sans-xs padding-x-2 padding-y-1">
            Verificar Cadena
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- USWDS: Alert | https://designsystem.digital.gov/components/alert/ -->
  <Alert type="info" heading="Laboratorio Forense Certificado · Entorno Auditado" className="margin-bottom-3">
    Todos los procedimientos registrados en este CMS de cumplimiento están respaldados por sellos criptográficos
    <strong>SHA-256</strong> bajo la cadena de custodia reglamentaria <strong>MUCC-2017</strong> (Gaceta N° 41.247)
    y el estándar internacional <strong>ISO/IEC 27037:2012</strong>.
  </Alert>

  <!-- USWDS: Card | https://designsystem.digital.gov/components/card/ -->
  <ul class="usa-card-group margin-bottom-3">
    <li class="usa-card tablet:grid-col-6 desktop:grid-col-3">
      <div class="usa-card__container">
        <div class="usa-card__header">
          <h2 class="usa-card__heading font-heading-sm">Expedientes Activos</h2>
        </div>
        <div class="usa-card__body">
          <p class="font-sans-2xl text-bold margin-y-1" id="kpi-total-casos">0</p>
          <p class="margin-0"><span class="usa-tag">En curso procesal</span></p>
        </div>
      </div>
    </li>

    <li class="usa-card tablet:grid-col-6 desktop:grid-col-3">
      <div class="usa-card__container">
        <div class="usa-card__header">
          <h2 class="usa-card__heading font-heading-sm">Evidencias Custodiadas</h2>
        </div>
        <div class="usa-card__body">
          <p class="font-sans-2xl text-bold margin-y-1" id="kpi-evidencias">0</p>
          <p class="margin-0"><span class="usa-tag">Con precinto PRCC</span></p>
        </div>
      </div>
    </li>

    <li class="usa-card tablet:grid-col-6 desktop:grid-col-3">
      <div class="usa-card__container">
        <div class="usa-card__header">
          <h2 class="usa-card__heading font-heading-sm">Fases ISO Validadas</h2>
        </div>
        <div class="usa-card__body">
          <p class="font-sans-2xl text-bold margin-y-1" id="kpi-fases">12 / 18</p>
          <p class="margin-0"><span class="usa-tag">Gating superado</span></p>
        </div>
      </div>
    </li>

    <li class="usa-card tablet:grid-col-6 desktop:grid-col-3">
      <div class="usa-card__container">
        <div class="usa-card__header">
          <h2 class="usa-card__heading font-heading-sm">Integridad SHA-256</h2>
        </div>
        <div class="usa-card__body">
          <p class="font-sans-2xl text-bold margin-y-1" id="kpi-integridad">100%</p>
          <p class="margin-0"><span class="usa-tag">Cadena verificada</span></p>
        </div>
      </div>
    </li>
  </ul>

  <!-- USWDS: Summary box | https://designsystem.digital.gov/components/summary-box/ -->
  <SummaryBox
    heading="Control de Calidad Pericial — Ciclo ISO 6 Fases (F0 - F5)"
    headingId="summary-ciclo-iso"
    className="margin-bottom-3"
  >
    <p class="margin-top-0 margin-bottom-1">
      El CMS opera bajo un flujo determinista cerrado: ninguna etapa puede cerrarse sin que el perito
      adjunte los requisitos de fijación, adquiera la imagen forense con hardware de bloqueo de escritura
      y selle criptográficamente el hash génesis.
    </p>
    <!-- USWDS: Tag | https://designsystem.digital.gov/components/tag/ -->
    <div class="display-flex flex-wrap">
      <span class="usa-tag bg-primary-darker margin-right-1 margin-bottom-05">ISO/IEC 27037:2012</span>
      <span class="usa-tag bg-primary-darker margin-right-1 margin-bottom-05">ISO/IEC 27042:2015</span>
      <span class="usa-tag bg-primary margin-right-1 margin-bottom-05">NIST SP 800-86</span>
      <span class="usa-tag bg-accent-warm-dark text-ink text-bold margin-right-1 margin-bottom-05">MUCC-2017</span>
      <span class="usa-tag bg-green margin-bottom-05">COPP Art. 187</span>
    </div>
  </SummaryBox>

  <!-- USWDS: Table | https://designsystem.digital.gov/components/table/ -->
  <section class="margin-bottom-4" aria-labelledby="expedientes-curso-heading">
    <div class="grid-row flex-justify flex-align-center margin-bottom-2">
      <h2 class="margin-0 font-heading-md" id="expedientes-curso-heading">Expedientes Periciales en Curso</h2>
      <a href="/casos" class="usa-link font-sans-2xs">Ver todos los casos</a>
    </div>

    <div class="usa-table-container--scrollable" tabindex="0">
      <table class="usa-table usa-table--striped usa-table--compact width-full">
        <caption>Listado de expedientes forenses activos sincronizados en base de datos</caption>
        <thead>
          <tr>
            <th scope="col">N° Expediente</th>
            <th scope="col">Tipología Forense</th>
            <th scope="col">Consignante / C.I.</th>
            <th scope="col">Dispositivo Evidencia</th>
            <th scope="col">Fase Actual</th>
            <th scope="col">Integridad</th>
            <th scope="col">Acciones</th>
          </tr>
        </thead>
        <tbody id="tabla-casos-body">
          <tr>
            <td colspan="7">Consultando expedientes sincronizados en MySQL...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- USWDS: Card | https://designsystem.digital.gov/components/card/ -->
  <ul class="usa-card-group">
    <li class="usa-card tablet:grid-col-6">
      <div class="usa-card__container">
        <div class="usa-card__header">
          <h2 class="usa-card__heading font-heading-md">Planillas Oficiales en Folio (216mm × 330mm)</h2>
        </div>
        <div class="usa-card__body">
          <p class="font-body-2xs text-base-dark margin-top-0 margin-bottom-1">
            Formatos reglamentarios con membrete oficial, dactiloscopía bilateral y márgenes de impresión exactos:
          </p>
          <ul class="usa-list font-body-2xs">
            <li><a href="/planillas/acta-consentimiento" class="usa-link">Acta de Consentimiento Informado</a></li>
            <li><a href="/planillas/acta-entrevista" class="usa-link">Acta de Entrevista Forense al Consignante</a></li>
            <li><a href="/planillas/acta-obtencion" class="usa-link">Acta de Obtención y Preservación Inicial</a></li>
            <li><a href="/planillas/planilla-prcc" class="usa-link">Planilla de Registro de Cadena de Custodia (PRCC)</a></li>
            <li><a href="/planillas/acta-desprecintado" class="usa-link">Acta de Desprecintado y Apertura en Laboratorio</a></li>
            <li><a href="/planillas/acta-dictamen" class="usa-link">Dictamen Pericial Oficial de Informática Forense</a></li>
          </ul>
        </div>
        <div class="usa-card__footer border-top-1px border-base-lighter padding-top-2">
          <a href="/planillas" class="usa-button usa-button--outline font-sans-xs padding-x-2 padding-y-1">
            Ver catálogo de 13 planillas
          </a>
        </div>
      </div>
    </li>

    <li class="usa-card tablet:grid-col-6">
      <div class="usa-card__container">
        <div class="usa-card__header">
          <h2 class="usa-card__heading font-heading-md">Admisibilidad y Blindaje Procesal</h2>
        </div>
        <div class="usa-card__body">
          <p class="font-body-2xs text-base-dark margin-top-0 margin-bottom-1">
            Garantías procesales activas para evitar la nulidad conforme al Art. 187 del COPP:
          </p>
          <ul class="usa-list font-body-2xs">
            <li>
              <strong>Bloqueadores de Escritura (Write-Blockers):</strong> Obligatorios para la clonación bit-a-bit en ISO 27037.
            </li>
            <li>
              <strong>Sellado Génesis SHA-256:</strong> Cálculo bit-a-bit antes de cualquier análisis o triaje.
            </li>
            <li>
              <strong>Dactiloscopía Bilateral:</strong> Pulgar izquierdo y derecho en todas las actas impresas.
            </li>
          </ul>
        </div>
        <div class="usa-card__footer border-top-1px border-base-lighter padding-top-2">
          <a href="/normativa" class="usa-button usa-button--outline font-sans-xs padding-x-2 padding-y-1">
            Consultar Base Normativa RAG (77 normas)
          </a>
        </div>
      </div>
    </li>
  </ul>
</AppLayout>

<script>
  import { phpApi } from '../lib/data/phpApi';
  import type { CasoCMS } from '../lib/domain/types';

  function renderizarFilaDashboard(c: CasoCMS): string {
    const tipo = (c.tipoProyecto || '').replace('forense_', '').toUpperCase();
    return `
      <tr>
        <th scope="row">
          <strong>${c.numeroCaso}</strong><br />
          <code>${c.expediente || 'S/E'}</code>
        </th>
        <td>
          <span class="usa-tag">${tipo}</span>
        </td>
        <td>
          ${c.consignanteNombre || 'Consignante no reg.'}<br />
          <span>C.I. ${c.consignanteCedula || 'N/A'}</span>
        </td>
        <td>
          ${c.evidenciaMarca || ''} ${c.evidenciaModelo || ''}<br />
          <code>S/N: ${c.evidenciaSerial || 'S/N'}</code>
        </td>
        <td>
          <span class="usa-tag bg-primary">${c.faseIsoActual || 'F0'}</span>
        </td>
        <td>
          <span class="usa-tag bg-green">Sincronizado DB</span>
        </td>
        <td>
          <ul class="usa-button-group flex-wrap">
            <li class="usa-button-group__item">
              <a href="/flujo?casoId=${c.id}" class="usa-button usa-button--outline font-sans-2xs padding-x-1 padding-y-05">
                Ciclo ISO
              </a>
            </li>
            <li class="usa-button-group__item">
              <a href="/planillas/planilla-prcc?casoId=${c.id}" class="usa-button usa-button--outline font-sans-2xs padding-x-1 padding-y-05">
                PRCC
              </a>
            </li>
          </ul>
        </td>
      </tr>
    `;
  }

  async function cargarDatosDashboard() {
    const tbody = document.getElementById('tabla-casos-body');
    const kpiCasos = document.getElementById('kpi-total-casos');
    const kpiEvidencias = document.getElementById('kpi-evidencias');

    try {
      const data = await phpApi.listarCasos();
      const sincronizados = (data || []).filter((c) => !c.id.startsWith('caso-mock-'));

      if (kpiCasos) kpiCasos.textContent = String(sincronizados.length);
      if (kpiEvidencias) kpiEvidencias.textContent = String(sincronizados.length);

      if (!tbody) return;

      if (sincronizados.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7">
              No hay expedientes sincronizados en MySQL. Inicie un caso en <a href="/casos?nuevo=1" class="usa-link">Expedientes Periciales</a>.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = sincronizados.map(renderizarFilaDashboard).join('');
    } catch (e) {
      console.warn('Error cargando datos del dashboard:', e);
      if (tbody) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7">
              No hay conexión activa con la base de datos MySQL en cPanel.
            </td>
          </tr>
        `;
      }
    }
  }

  if (typeof window !== 'undefined') {
    cargarDatosDashboard();
  }
</script>
