---
/**
 * SHA256.US — Ciclo Pericial ISO (F0 - F5) del CMS con Gating Criptográfico y USWDS Estricto
 * Control estricto de cumplimiento: ISO/IEC 27037, 27042, 27043, 37301 y MUCC-2017.
 * Fuentes:
 * - https://designsystem.digital.gov/components/step-indicator/
 * - https://designsystem.digital.gov/components/button-group/
 * - https://designsystem.digital.gov/components/summary-box/
 * - https://designsystem.digital.gov/components/collection/
 * - https://designsystem.digital.gov/components/checkbox/
 * - https://designsystem.digital.gov/components/tag/
 */
import AppLayout from '../layouts/AppLayout.astro';
import StepIndicator from '../components/uswds/StepIndicator.astro';
import SummaryBox from '../components/uswds/SummaryBox.astro';
import { FASES_ISO } from '../lib/domain/gating';

const PLANILLAS_MAP: Record<string, { titulo: string; slug: string }> = {
  acta_consentimiento: { titulo: 'Acta de Consentimiento Informado', slug: 'acta-consentimiento' },
  acta_entrevista: { titulo: 'Acta de Entrevista Forense', slug: 'acta-entrevista' },
  acta_obtencion: { titulo: 'Acta de Obtención y Preservación', slug: 'acta-obtencion' },
  prcc: { titulo: 'Planilla de Registro de Cadena de Custodia (PRCC)', slug: 'planilla-prcc' },
  acta_desprecintado: { titulo: 'Acta de Desprecintado en Laboratorio', slug: 'acta-desprecintado' },
  informe_audio_sonic: { titulo: 'Planilla Análisis Audio Sonic Visualiser', slug: 'planilla-audio-sonic' },
  planilla_evaluacion_ux: { titulo: 'Planilla de Evaluación de Calidad UX', slug: 'planilla-evaluacion-ux' },
  acta_dictamen: { titulo: 'Dictamen Pericial Oficial', slug: 'acta-dictamen' },
  dictamen_imagenes: { titulo: 'Dictamen Especializado de Imágenes', slug: 'dictamen-imagenes' },
  dictamen_audios: { titulo: 'Dictamen Especializado de Audios', slug: 'dictamen-audios' },
  acta_entrega_resultados: { titulo: 'Acta de Entrega de Resultados', slug: 'acta-entrega-resultados' },
  acta_sanitizacion: { titulo: 'Acta de Sanitización de Medios (NIST 800-88)', slug: 'acta-sanitizacion' },
  acta_auditoria_timeline: { titulo: 'Acta de Auditoría y Cadena Inmutable', slug: 'acta-auditoria-timeline' },
};
---

<AppLayout title="Ciclo Pericial ISO — SHA256.US" activeNav="flujo">
  <!-- Selector y Encabezado del Expediente Activo -->
  <div class="bg-white padding-3 border border-base-lighter margin-bottom-3">
    <div class="grid-row grid-gap flex-align-center margin-bottom-2">
      <div class="tablet:grid-col-8">
        <p class="margin-0 text-base-dark text-uppercase text-bold font-sans-2xs">
          Expediente Pericial Seleccionado
        </p>
        <h1 class="margin-y-05" id="caso-titulo">
          Expediente Pericial en Sincronización...
        </h1>
        <p class="margin-0">
          N° Caso: <strong id="caso-numero">Consultando...</strong> · Expediente: <strong id="caso-expediente">...</strong> ·{' '}
          <span class="usa-tag" id="caso-tipo">PERITAJE</span>
        </p>
      </div>

      <div class="tablet:grid-col-4">
        <label class="usa-label margin-top-0" for="select-cambiar-caso">
          Cambiar Expediente Activo
        </label>
        <select class="usa-select" id="select-cambiar-caso" name="cambiar-caso">
          <option value="">Consultando base de datos MySQL...</option>
        </select>
      </div>
    </div>

    <div class="grid-row grid-gap border-top border-base-lighter padding-top-2">
      <div class="tablet:grid-col-3">
        <span class="text-base-dark">Consignante:</span>
        <p class="margin-0 text-bold" id="caso-consignante">Cargando datos...</p>
      </div>
      <div class="tablet:grid-col-3">
        <span class="text-base-dark">Dispositivo / Evidencia:</span>
        <p class="margin-0 text-bold" id="caso-evidencia">Cargando evidencia...</p>
      </div>
      <div class="tablet:grid-col-3">
        <span class="text-base-dark">Aislamiento Faraday:</span>
        <p class="margin-0 text-bold" id="caso-aislamiento">Consultando estado...</p>
      </div>
      <div class="tablet:grid-col-3">
        <span class="text-base-dark">Perito Líder Designado:</span>
        <p class="margin-0 text-bold" id="caso-perito">Consultando asignación...</p>
      </div>
    </div>
  </div>

  <!-- USWDS Step Indicator de las 6 Fases ISO -->
  <div class="bg-white padding-3 border border-base-lighter margin-bottom-3">
    <div id="step-indicator-container">
      <StepIndicator faseActual="F0" />
    </div>

    <!-- USWDS: Button group segmented | https://designsystem.digital.gov/components/button-group/ -->
    <ul class="usa-button-group usa-button-group--segmented margin-top-2">
      {FASES_ISO.map((f, i) => (
        <li class="usa-button-group__item">
          <button
            type="button"
            class={`usa-button btn-fase-tab ${i === 0 ? '' : 'usa-button--outline'}`.trim()}
            data-fase={f.id}
          >
            {f.id}: {f.corto}
          </button>
        </li>
      ))}
    </ul>
  </div>

  <!-- Vista Detallada de la Fase Seleccionada -->
  <div id="fase-panel" class="bg-white padding-3 border border-base-lighter margin-bottom-3">
    <div class="grid-row grid-gap flex-align-center margin-bottom-2">
      <div class="tablet:grid-col-9">
        <p class="margin-top-0 margin-bottom-05">
          <span class="usa-tag bg-primary" id="fase-badge-id">FASE F0</span>{' '}
          <span class="text-base-dark" id="fase-normas">
            ISO 37301 §8.1 · ISO/IEC 27043 §8 · CRBV Arts. 28 y 60
          </span>
        </p>
        <h2 class="margin-0" id="fase-nombre">
          {FASES_ISO[0].nombre}
        </h2>
      </div>

      <div class="tablet:grid-col-3" id="fase-estado-badge">
        <span class="usa-tag bg-accent-warm text-ink">EN CURSO</span>
      </div>
    </div>

    <SummaryBox
      heading="Objetivo Pericial y Alcance Normativo"
      headingId="summary-fase-objetivo"
      className="margin-bottom-3"
    >
      <p class="margin-0" id="fase-objetivo">
        {FASES_ISO[0].objetivo}
      </p>
    </SummaryBox>

    <!-- Rejilla de Dos Columnas: Planillas Oficiales vs Controles Obligatorios -->
    <div class="grid-row grid-gap">
      <!-- Columna 1: Planillas Obligatorias de la Fase -->
      <div class="tablet:grid-col-6">
        <h3 class="margin-top-0">Planillas Oficiales Folio (216mm × 330mm)</h3>
        <p class="text-base-dark">
          Documentos reglamentarios que deben completarse, rubricarse e imprimirse en esta etapa:
        </p>

        <!-- USWDS: Collection | https://designsystem.digital.gov/components/collection/ -->
        <ul class="usa-collection" id="fase-planillas-lista">
          {FASES_ISO[0].planillas.map((pId) => {
            const pInfo = PLANILLAS_MAP[pId] || { titulo: pId, slug: pId };
            return (
              <li class="usa-collection__item">
                <div class="usa-collection__body">
                  <h4 class="usa-collection__heading">
                    <a
                      href={`/planillas/${pInfo.slug}`}
                      class="usa-link btn-link-planilla"
                      data-base-slug={pInfo.slug}
                    >
                      {pInfo.titulo}
                    </a>
                  </h4>
                  <p class="usa-collection__description">
                    Formato Folio Oficial (216mm × 330mm) · Cierre Bilateral y Dactiloscopía
                  </p>
                </div>
              </li>
            );
          })}
        </ul>
      </div>

      <!-- Columna 2: Lista de Verificación de Controles ISO -->
      <div class="tablet:grid-col-6">
        <fieldset class="usa-fieldset">
          <legend class="usa-legend text-bold">
            Controles de Cumplimiento ISO Obligatorios
          </legend>
          <p class="text-base-dark">
            Requisitos mandantes para habilitar el sellado criptográfico SHA-256 de la fase:
          </p>

          <!-- USWDS: Checkbox | https://designsystem.digital.gov/components/checkbox/ -->
          <div id="fase-controles-lista">
            {FASES_ISO[0].controles.map((ctrl) => (
              <div class="usa-checkbox margin-bottom-2">
                <input
                  class="usa-checkbox__input chk-control-iso"
                  type="checkbox"
                  id={`chk-${ctrl.id}`}
                  data-control-id={ctrl.id}
                />
                <label class="usa-checkbox__label" for={`chk-${ctrl.id}`}>
                  {ctrl.texto}
                  <span class="usa-checkbox__label-description">
                    Norma: <code>{ctrl.norma}</code>
                  </span>
                </label>
              </div>
            ))}
          </div>
        </fieldset>
      </div>
    </div>

    <!-- Sección de Sello Criptográfico SHA-256 y Cierre de Fase -->
    <div class="margin-top-3 padding-top-2 border-top border-base-lighter">
      <div class="bg-base-lightest padding-3 border border-base-lighter">
        <div class="grid-row grid-gap flex-align-center">
          <div class="tablet:grid-col-8">
            <h3 class="margin-top-0 margin-bottom-05">
              Encadenamiento y Sello Criptográfico SHA-256
            </h3>
            <p class="margin-0">
              Al sellar la fase, se calculará el hash canónico del estado y se encadenará al bloque previo de auditoría.
            </p>
            <p id="sello-info-hash" class="margin-top-1 margin-bottom-0" hidden>
              Hash Génesis: <code id="sello-hash-valor"></code>
            </p>
          </div>

          <div class="tablet:grid-col-4">
            <button id="btn-sellar-fase" type="button" class="usa-button">
              Sellar Fase con Hash SHA-256
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</AppLayout>

<script>
  import { FASES_ISO } from '../lib/domain/gating';
  import { phpApi } from '../lib/data/phpApi';
  import { idbPut, idbGetAll } from '../lib/data/idb';
  import type { CasoCMS } from '../lib/domain/types';

  const PLANILLAS_MAP_CLIENT: Record<string, { titulo: string; slug: string }> = {
    acta_consentimiento: { titulo: 'Acta de Consentimiento Informado', slug: 'acta-consentimiento' },
    acta_entrevista: { titulo: 'Acta de Entrevista Forense', slug: 'acta-entrevista' },
    acta_obtencion: { titulo: 'Acta de Obtención y Preservación', slug: 'acta-obtencion' },
    prcc: { titulo: 'Planilla de Registro de Cadena de Custodia (PRCC)', slug: 'planilla-prcc' },
    acta_desprecintado: { titulo: 'Acta de Desprecintado en Laboratorio', slug: 'acta-desprecintado' },
    informe_audio_sonic: { titulo: 'Planilla Análisis Audio Sonic Visualiser', slug: 'planilla-audio-sonic' },
    planilla_evaluacion_ux: { titulo: 'Planilla de Evaluación de Calidad UX', slug: 'planilla-evaluacion-ux' },
    acta_dictamen: { titulo: 'Dictamen Pericial Oficial', slug: 'acta-dictamen' },
    dictamen_imagenes: { titulo: 'Dictamen Especializado de Imágenes', slug: 'dictamen-imagenes' },
    dictamen_audios: { titulo: 'Dictamen Especializado de Audios', slug: 'dictamen-audios' },
    acta_entrega_resultados: { titulo: 'Acta de Entrega de Resultados', slug: 'acta-entrega-resultados' },
    acta_sanitizacion: { titulo: 'Acta de Sanitización de Medios (NIST 800-88)', slug: 'acta-sanitizacion' },
    acta_auditoria_timeline: { titulo: 'Acta de Auditoría y Cadena Inmutable', slug: 'acta-auditoria-timeline' },
  };

  let casoActual: CasoCMS | null = null;
  let faseSeleccionadaId = 'F0';

  async function cargarCasosYSeleccionar() {
    let casos: CasoCMS[] = [];
    try {
      const data = await phpApi.listarCasos();
      casos = (data || []).filter((c) => !c.id.startsWith('caso-mock-'));
    } catch {
      const data = await idbGetAll('casos');
      casos = (data || []).filter((c) => !c.id.startsWith('caso-mock-'));
    }

    const select = document.getElementById('select-cambiar-caso') as HTMLSelectElement;

    if (!casos || casos.length === 0) {
      const tit = document.getElementById('caso-titulo');
      if (tit) tit.textContent = 'No hay expedientes sincronizados en MySQL';
      if (select) select.innerHTML = '<option value="">Sin expedientes en base de datos</option>';
      return;
    }

    if (select) {
      select.innerHTML = '';
      casos.forEach((c) => {
        const opt = document.createElement('option');
        opt.value = c.id;
        opt.textContent = `${c.numeroCaso} — ${c.titulo.substring(0, 30)}...`;
        select.appendChild(opt);
      });
    }

    const params = new URLSearchParams(window.location.search);
    const paramId = params.get('casoId');
    const seleccionado = (paramId && casos.find((c) => c.id === paramId)) || casos[0];
    seleccionarCaso(seleccionado);
  }

  function seleccionarCaso(caso: CasoCMS) {
    casoActual = caso;
    const select = document.getElementById('select-cambiar-caso') as HTMLSelectElement;
    if (select) select.value = caso.id;

    const tit = document.getElementById('caso-titulo');
    const num = document.getElementById('caso-numero');
    const exp = document.getElementById('caso-expediente');
    const tipo = document.getElementById('caso-tipo');
    const cons = document.getElementById('caso-consignante');
    const evid = document.getElementById('caso-evidencia');
    const aisl = document.getElementById('caso-aislamiento');
    const per = document.getElementById('caso-perito');

    if (tit) tit.textContent = caso.titulo;
    if (num) num.textContent = caso.numeroCaso;
    if (exp) exp.textContent = caso.expediente;
    if (tipo) tipo.textContent = caso.tipoProyecto.replace('forense_', '').toUpperCase();
    if (cons) cons.textContent = `${caso.consignanteNombre || 'Consignante'} (C.I. ${caso.consignanteCedula || 'N/A'})`;
    if (evid) evid.textContent = `${caso.evidenciaMarca} ${caso.evidenciaModelo} (S/N: ${caso.evidenciaSerial || 'N/A'})`;
    if (aisl) aisl.textContent = caso.evidenciaAislamientoRF ? 'Aislado RF (Modo Avión)' : 'No Aislado';
    if (per) per.textContent = caso.peritoLiderNombre || 'Jull Joll';

    faseSeleccionadaId = (caso.faseIsoActual as string) || 'F0';
    renderizarFase(faseSeleccionadaId);
  }

  function renderizarFase(faseId: string) {
    faseSeleccionadaId = faseId;
    const faseObj = FASES_ISO.find((f) => f.id === faseId);
    if (!faseObj || !casoActual) return;

    document.querySelectorAll('.btn-fase-tab').forEach((btn) => {
      const fId = btn.getAttribute('data-fase');
      if (fId === faseId) {
        btn.classList.remove('usa-button--outline');
      } else {
        btn.classList.add('usa-button--outline');
      }
    });

    const badgeId = document.getElementById('fase-badge-id');
    const normas = document.getElementById('fase-normas');
    const nombre = document.getElementById('fase-nombre');
    const objetivo = document.getElementById('fase-objetivo');

    if (badgeId) badgeId.textContent = `FASE ${faseObj.id}`;
    if (normas) normas.textContent = faseObj.normas.join(' · ');
    if (nombre) nombre.textContent = faseObj.nombre;
    if (objetivo) objetivo.textContent = faseObj.objetivo;

    const listaPlanillas = document.getElementById('fase-planillas-lista');
    if (listaPlanillas) {
      listaPlanillas.innerHTML = '';
      faseObj.planillas.forEach((pId) => {
        const info = PLANILLAS_MAP_CLIENT[pId] || { titulo: pId, slug: pId };
        const li = document.createElement('li');
        li.className = 'usa-collection__item';
        li.innerHTML = `
          <div class="usa-collection__body">
            <h4 class="usa-collection__heading">
              <a href="/planillas/${info.slug}?casoId=${casoActual?.id}" class="usa-link">
                ${info.titulo}
              </a>
            </h4>
            <p class="usa-collection__description">
              Formato Folio Oficial (216mm × 330mm) · Cierre Bilateral y Dactiloscopía
            </p>
          </div>
        `;
        listaPlanillas.appendChild(li);
      });
    }

    const listaControles = document.getElementById('fase-controles-lista');
    if (listaControles) {
      listaControles.innerHTML = '';
      const aplicables = faseObj.controles.filter(
        (c) => !c.tipologias || c.tipologias.length === 0 || c.tipologias.includes(casoActual?.tipoProyecto as any)
      );

      aplicables.forEach((ctrl) => {
        const row = document.createElement('div');
        row.className = 'usa-checkbox margin-bottom-2';
        row.innerHTML = `
          <input
            class="usa-checkbox__input chk-control-iso"
            type="checkbox"
            id="chk-${ctrl.id}"
            data-control-id="${ctrl.id}"
          />
          <label class="usa-checkbox__label" for="chk-${ctrl.id}">
            ${ctrl.texto}
            <span class="usa-checkbox__label-description">
              Norma: <code>${ctrl.norma}</code>
            </span>
          </label>
        `;
        listaControles.appendChild(row);
      });
    }

    const btnSellar = document.getElementById('btn-sellar-fase') as HTMLButtonElement;
    const selloInfo = document.getElementById('sello-info-hash');
    const selloHash = document.getElementById('sello-hash-valor');

    const ordenActual = FASES_ISO.findIndex((f) => f.id === casoActual?.faseIsoActual);
    const ordenSeleccionado = FASES_ISO.findIndex((f) => f.id === faseId);

    if (ordenSeleccionado < ordenActual) {
      if (btnSellar) {
        btnSellar.textContent = 'Fase Completada y Sellada';
        btnSellar.disabled = true;
      }
      if (selloInfo) selloInfo.hidden = false;
      if (selloHash) selloHash.textContent = 'SHA-256 VERIFICADO E INMUTABLE';
    } else if (ordenSeleccionado === ordenActual) {
      if (btnSellar) {
        btnSellar.textContent = 'Sellar Fase con Hash SHA-256';
        btnSellar.disabled = false;
      }
      if (selloInfo) selloInfo.hidden = true;
    } else {
      if (btnSellar) {
        btnSellar.textContent = 'Bloqueada (Complete fases previas)';
        btnSellar.disabled = true;
      }
      if (selloInfo) selloInfo.hidden = true;
    }
  }

  const selectCaso = document.getElementById('select-cambiar-caso');
  if (selectCaso) {
    selectCaso.addEventListener('change', async (e) => {
      const id = (e.target as HTMLSelectElement).value;
      const casos = await idbGetAll('casos');
      const c = casos.find((x) => x.id === id);
      if (c) seleccionarCaso(c);
    });
  }

  document.querySelectorAll('.btn-fase-tab').forEach((btn) => {
    btn.addEventListener('click', () => {
      const fId = btn.getAttribute('data-fase');
      if (fId) renderizarFase(fId);
    });
  });

  const btnSellar = document.getElementById('btn-sellar-fase');
  if (btnSellar) {
    btnSellar.addEventListener('click', async () => {
      if (!casoActual) return;

      const chks = document.querySelectorAll('.chk-control-iso:checked');
      const controles: Record<string, boolean> = {};
      chks.forEach((c) => {
        const id = c.getAttribute('data-control-id');
        if (id) controles[id] = true;
      });

      const confirmacion = confirm(
        `¿Confirma el sellado criptográfico SHA-256 de la ${faseSeleccionadaId} para el caso ${casoActual.numeroCaso}? Esta acción es inmutable y registrará su firma pericial.`
      );
      if (!confirmacion) return;

      try {
        const res = await phpApi.avanzarEtapa({
          casoId: casoActual.id,
          faseOrigen: faseSeleccionadaId,
          controles,
          peritoActor: casoActual.peritoLiderNombre || 'Jull Joll',
        });

        alert(`¡Fase ${faseSeleccionadaId} sellada exitosamente!\nHash SHA-256: ${res.hash}\nExpediente avanzado.`);
        window.location.reload();
      } catch (err: any) {
        console.warn('Fallo en API PHP, aplicando avance offline en IndexedDB:', err);
        const fIdx = FASES_ISO.findIndex((f) => f.id === faseSeleccionadaId);
        const sigFase = FASES_ISO[fIdx + 1]?.id || faseSeleccionadaId;
        casoActual.faseIsoActual = sigFase;
        await idbPut('casos', casoActual);
        alert(`Fase sellada localmente en IndexedDB. Nuevo estado: ${sigFase}.`);
        window.location.reload();
      }
    });
  }

  if (typeof window !== 'undefined') {
    cargarCasosYSeleccionar();
  }
</script>

