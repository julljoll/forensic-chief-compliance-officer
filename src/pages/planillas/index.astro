---
/**
 * SHA256.US — Catálogo Canónico de las 13 Planillas Oficiales en Folio (216mm × 330mm)
 * Formato físico reglamentario para documentos legales en Venezuela (Oficio).
 * Modelo Operativo: Consignación Voluntaria y Adquisición Lógica de Mensajería Digital.
 * Monocromático B&W puro · Encabezado y pie unificados · Modo Plantilla en Blanco para llenado manual.
 */
import AppLayout from '../../layouts/AppLayout.astro';
import Alert from '../../components/uswds/Alert.astro';

const PLANILLAS = [
  {
    slug: 'acta-consentimiento',
    fase: 'F0',
    titulo: 'Acta de Consentimiento Informado y Autorización',
    norma: 'CRBV Arts. 28, 48, 60 · LEDCI Arts. 20, 21 · ISO 27037',
    descripcion: 'Autorización legal expresa del titular o interlocutor legítimo para la extracción lógica forense de mensajería y exclusión de antijuridicidad.',
    hojas: '1 Hoja Folio',
  },
  {
    slug: 'acta-entrevista',
    fase: 'F0',
    titulo: 'Acta de Entrevista Técnico-Pericial al Consignante',
    norma: 'MUCC-2017 · CRBV Art. 49 ord. 5° · CP Art. 242',
    descripcion: 'Fijación formal de las declaraciones, credenciales de acceso, interlocutores y contexto con advertencia de no autoincriminación.',
    hojas: '1 Hoja Folio',
  },
  {
    slug: 'acta-obtencion',
    fase: 'F1',
    titulo: 'Acta de Obtención por Consignación y Preservación',
    norma: 'MUCC-2017 Modelo 3 (G.O. 41.247) · COPP Art. 187',
    descripcion: 'Recepción física y técnica del teléfono inteligente con fijación fotográfica 360°, aislamiento Faraday y precintado numerado.',
    hojas: '2 Hojas Folio',
  },
  {
    slug: 'planilla-prcc',
    fase: 'F1',
    titulo: 'Planilla de Registro de Cadena de Custodia (PRCC)',
    norma: 'COPP Art. 187 · MUCC-2017 §I-V · LMDFE Art. 7',
    descripcion: 'Instrumento matriz de trazabilidad ininterrumpida del dispositivo consignado y contenedores lógicos derivados.',
    hojas: '2 Hojas Folio',
  },
  {
    slug: 'acta-desprecintado',
    fase: 'F2',
    titulo: 'Acta de Desprecintado y Adquisición Lógica',
    norma: 'NIST SP 800-101 Nivel 2 · ISO 27037 §5.4.3 · COPP 187',
    descripcion: 'Constancia de apertura en laboratorio, extracción lógica de SQLite msgstore.db, Hash SHA-256 y Nuevo Precinto de Resguardo.',
    hojas: '1 Hoja Folio',
  },
  {
    slug: 'planilla-audio-sonic',
    fase: 'F3',
    titulo: 'Planilla de Análisis Forense de Audio (Notas de Voz)',
    norma: 'LMDFE Arts. 4 y 7 · SWGDE · ISO/IEC 27042',
    descripcion: 'Espectrograma FFT, decodificación Opus 48 kHz, formantes vocálicos, traza ENF 60 Hz y verificación anti-deepfake.',
    hojas: '1 Hoja Folio',
  },
  {
    slug: 'planilla-evaluacion-ux',
    fase: 'F3',
    titulo: 'Planilla de Evaluación de Interfaz UX y Software',
    norma: 'ISO/IEC 25010 · ISO/IEC 27042 §8 · LMDFE Art. 4',
    descripcion: 'Cotejo heurístico de coincidencia unívoca entre la interfaz visual en pantalla y los registros crudos en SQLite msgstore.db.',
    hojas: '1 Hoja Folio',
  },
  {
    slug: 'acta-dictamen',
    fase: 'F4',
    titulo: 'Dictamen Pericial Oficial de Informática Forense',
    norma: 'COPP Arts. 187, 223–225 · LMDFE 4, 7 · CENIF G.O. 39.847',
    descripcion: 'Informe científico motivado colegiado por dos peritos titulados y juramentados, con plena eficacia probatoria judicial.',
    hojas: '2 Hojas Folio',
  },
  {
    slug: 'dictamen-imagenes',
    fase: 'F4',
    titulo: 'Dictamen Especializado en Evidencia Fotográfica',
    norma: 'COPP Arts. 223–225 · LMDFE Arts. 4 y 7 · ISO 27042',
    descripcion: 'Análisis de metadatos EXIF, ELA (Error Level Analysis), integridad de píxeles y descarte de fotomontajes.',
    hojas: '1 Hoja Folio',
  },
  {
    slug: 'dictamen-audios',
    fase: 'F4',
    titulo: 'Dictamen Especializado de Notas de Voz y Audio',
    norma: 'COPP Arts. 223–225 · LMDFE 4, 7 · CENIF (G.O. 39.847)',
    descripcion: 'Cotejo biométrico acústico, continuidad de onda Opus, no edición y autenticidad del mensaje de voz como interlocutor legítimo.',
    hojas: '1 Hoja Folio',
  },
  {
    slug: 'acta-entrega-resultados',
    fase: 'F5',
    titulo: 'Acta de Disposición Final y Devolución al Titular',
    norma: 'MUCC-2017 Disposición Final (G.O. 41.247) · COPP 187',
    descripcion: 'Constancia formal de remisión del dictamen pericial colegiado en Folio y devolución física del smartphone con precinto intacto.',
    hojas: '1 Hoja Folio',
  },
  {
    slug: 'acta-sanitizacion',
    fase: 'F5',
    titulo: 'Acta de Sanitización de Copias Lógicas Temporales',
    norma: 'NIST SP 800-88 Rev. 1 · LEDCI Arts. 20 y 22 · ISO 27001',
    descripcion: 'Certificación de purga irreversible (Crypto-Erase) de copias de trabajo en servidores del laboratorio por deber de confidencialidad.',
    hojas: '1 Hoja Folio',
  },
  {
    slug: 'acta-auditoria-timeline',
    fase: 'F5',
    titulo: 'Acta de Auditoría y Trazabilidad Criptográfica',
    norma: 'ISO/IEC 27037 · LMDFE Arts. 4, 7 y 16 · RFC 8785',
    descripcion: 'Historial criptográfico inmutable de todas las actuaciones periciales con cadena de hashes concatenados SHA-256.',
    hojas: '1 Hoja Folio',
  },
];
---

<AppLayout title="Planillas Oficiales en Folio — SHA256.US" activeNav="planillas">
  <!-- Encabezado de Página -->
  <div class="grid-row grid-gap flex-align-end flex-justify margin-bottom-3">
    <div class="tablet:grid-col-7">
      <h1 class="margin-top-0 margin-bottom-1">
        Catálogo de Planillas Oficiales en Folio (216mm × 330mm)
      </h1>
      <p class="usa-intro margin-top-0 margin-bottom-0 font-body-sm text-base-dark">
        13 instrumentos periciales de informática forense con estándar canónico B&amp;W, membrete unificado de la República, dactiloscopía bilateral y cierre formal.
      </p>
    </div>

    <!-- Selector de Modo / Expediente -->
    <div class="tablet:grid-col-5 margin-top-2 tablet:margin-top-0">
      <!-- USWDS: Select | https://designsystem.digital.gov/components/select/ -->
      <label class="usa-label margin-top-0" for="select-caso-planillas">
        Modo de Emisión
      </label>
      <select class="usa-select" id="select-caso-planillas">
        <option value="blanco" selected>
          Formato en Blanco (Llenado Manual con Bolígrafo)
        </option>
      </select>
    </div>
  </div>

  <!-- Alerta de Especificaciones de Impresión Folio -->
  <div class="margin-bottom-3">
    <Alert type="info" heading="Consignación Privada y Adquisición Lógica (NIST SP 800-101 Nivel 2 · LMDFE Arts. 4 y 7)">
      Este catálogo opera bajo el modelo de <strong>Consignación Voluntaria y Adquisición Lógica Forense</strong> de dispositivos móviles y mensajería (WhatsApp SQLite <code>msgstore.db</code>). Todas las planillas están estrictamente adaptadas al <strong>Manual Único de Cadena de Custodia (MUCC-2017)</strong> y a la <strong>Ley sobre Mensajes de Datos y Firmas Electrónicas</strong>, imprimiéndose por defecto en <strong>Modo Plantilla en Blanco</strong> en hojas tamaño Folio (216mm × 330mm) en Blanco y Negro puro con 25mm de margen de encuadernación.
    </Alert>
  </div>

  <!-- USWDS: Card | https://designsystem.digital.gov/components/card/ -->
  <ul class="usa-card-group">
    {PLANILLAS.map((p) => (
      <li class="usa-card tablet:grid-col-6 desktop:grid-col-4 planilla-card-item" data-fase={p.fase}>
        <div class="usa-card__container overflow-hidden">
          <div class="usa-card__header">
            <div class="display-flex flex-justify flex-align-center margin-bottom-1">
              <span class="usa-tag font-mono-3xs">FASE {p.fase}</span>
              <span class="usa-tag font-mono-3xs">{p.hojas}</span>
            </div>
            <h2 class="usa-card__heading font-heading-sm">{p.titulo}</h2>
          </div>

          <div class="usa-card__body">
            <p class="font-mono-3xs text-bold text-accent-warm-dark margin-top-0 margin-bottom-1">
              ESTÁNDAR: {p.norma}
            </p>
            <p class="font-body-2xs text-base-dark margin-top-0 margin-bottom-0">
              {p.descripcion}
            </p>
          </div>

          <div class="usa-card__footer border-top-1px border-base-lighter padding-top-2">
            <!-- USWDS: Button group flex-wrap | https://designsystem.digital.gov/components/button-group/ -->
            <ul class="usa-button-group flex-wrap width-full">
              <li class="usa-button-group__item flex-1">
                <a
                  href={`/planillas/${p.slug}?modo=blanco`}
                  class="usa-button usa-button--outline font-sans-2xs padding-x-1 padding-y-05 width-full text-center link-abrir-planilla"
                  data-slug={p.slug}
                >
                  Ver Formato
                </a>
              </li>
              <li class="usa-button-group__item flex-1">
                <a
                  href={`/planillas/${p.slug}?modo=blanco&imprimir=1`}
                  target="_blank"
                  class="usa-button font-sans-2xs padding-x-1 padding-y-05 width-full text-center link-imprimir-planilla"
                  data-slug={p.slug}
                  title="Imprimir directamente en Folio en blanco"
                >
                  <svg class="usa-icon margin-right-05" aria-hidden="true" focusable="false" role="img">
                    <use href="/assets/uswds/img/sprite.svg#print"></use>
                  </svg>
                  <span>Imprimir</span>
                </a>
              </li>
              <li class="usa-button-group__item width-full margin-top-1">
                <button
                  type="button"
                  class="usa-button usa-button--base font-sans-2xs padding-x-1 padding-y-05 width-full text-center btn-descargar-docx"
                  data-slug={p.slug}
                  data-titulo={p.titulo}
                  title="Descargar esta planilla en formato Microsoft Word (.docx)"
                >
                  <svg class="usa-icon margin-right-05" aria-hidden="true" focusable="false" role="img">
                    <use href="/assets/uswds/img/sprite.svg#file_download"></use>
                  </svg>
                  <span class="txt-descargar-docx">Word (.docx)</span>
                </button>
              </li>
            </ul>
          </div>
        </div>
      </li>
    ))}
  </ul>
</AppLayout>

<script>
  import { idbGetAll } from '../../lib/data/idb';
  import { phpApi } from '../../lib/data/phpApi';
  import { descargarPlanillaPorSlug } from '../../lib/export/exportWordDocx';
  import type { CasoCMS } from '../../lib/domain/types';

  const select = document.getElementById('select-caso-planillas') as HTMLSelectElement;

  async function initCatalogo() {
    let casos: CasoCMS[] = [];
    try {
      casos = await phpApi.listarCasos();
    } catch {
      casos = await idbGetAll('casos');
    }

    casos = (casos || []).filter((c) => !c.id.startsWith('caso-mock-'));

    if (select) {
      select.innerHTML = '';
      
      // Opción 1: Plantilla en blanco
      const optBlanco = document.createElement('option');
      optBlanco.value = 'blanco';
      optBlanco.textContent = 'Formato en Blanco (Llenado Manual con Bolígrafo)';
      optBlanco.selected = true;
      select.appendChild(optBlanco);

      if (casos.length > 0) {
        // Grupo con casos reales sincronizados
        const optGroup = document.createElement('optgroup');
        optGroup.label = 'Expedientes Sincronizados en MySQL:';
        casos.forEach((c) => {
          const opt = document.createElement('option');
          opt.value = c.id;
          opt.textContent = `${c.numeroCaso} — ${c.evidenciaMarca} (${c.estado})`;
          optGroup.appendChild(opt);
        });
        select.appendChild(optGroup);
      }

      const params = new URLSearchParams(window.location.search);
      const paramId = params.get('casoId');
      if (paramId && (paramId === 'blanco' || casos.some((x) => x.id === paramId))) {
        select.value = paramId;
      }

      actualizarLinks(select.value);

      select.addEventListener('change', () => {
        actualizarLinks(select.value);
      });
    }

    // Configurar listeners de descarga directa Microsoft Word (.docx)
    document.querySelectorAll('.btn-descargar-docx').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        const button = btn as HTMLButtonElement;
        const slug = button.getAttribute('data-slug') || '';
        const titulo = button.getAttribute('data-titulo') || '';
        const spanTxt = button.querySelector('.txt-descargar-docx');
        const valorCaso = select?.value || 'blanco';
        const isBlanco = valorCaso === 'blanco';

        if (spanTxt) spanTxt.textContent = 'Generando...';
        button.disabled = true;

        try {
          await descargarPlanillaPorSlug(
            slug,
            isBlanco ? 'blanco' : 'datos',
            isBlanco ? undefined : valorCaso,
            titulo
          );
        } catch (err) {
          console.error('Error al descargar Word:', err);
          alert('Hubo un inconveniente al generar la planilla en formato Word.');
        } finally {
          if (spanTxt) spanTxt.textContent = 'Word (.docx)';
          button.disabled = false;
        }
      });
    });
  }

  function actualizarLinks(valor: string) {
    const isBlanco = valor === 'blanco';

    document.querySelectorAll('.link-abrir-planilla').forEach((a) => {
      const slug = a.getAttribute('data-slug');
      const anchor = a as HTMLAnchorElement;
      if (isBlanco) {
        anchor.href = `/planillas/${slug}?modo=blanco`;
        anchor.textContent = 'Ver Formato';
      } else {
        anchor.href = `/planillas/${slug}?casoId=${valor}&modo=datos`;
        anchor.textContent = 'Ver con Datos';
      }
    });

    document.querySelectorAll('.link-imprimir-planilla').forEach((a) => {
      const slug = a.getAttribute('data-slug');
      const anchor = a as HTMLAnchorElement;
      if (isBlanco) {
        anchor.href = `/planillas/${slug}?modo=blanco&imprimir=1`;
        anchor.textContent = 'Imprimir';
      } else {
        anchor.href = `/planillas/${slug}?casoId=${valor}&modo=datos&imprimir=1`;
        anchor.textContent = 'Imprimir';
      }
    });
  }

  if (typeof window !== 'undefined') {
    initCatalogo();
  }
</script>
