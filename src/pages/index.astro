---
/**
 * SHA256.US — Pantalla de Acceso Oficial al CMS de Cumplimiento Forense
 * Autenticación de Peritos mediante Contraseña o Google Authenticator (TOTP RFC 6238).
 * Fuentes:
 * - https://designsystem.digital.gov/components/banner/
 * - https://designsystem.digital.gov/components/header/
 * - https://designsystem.digital.gov/components/form/
 * - https://designsystem.digital.gov/components/button-group/
 * - https://designsystem.digital.gov/components/alert/
 * - https://designsystem.digital.gov/components/identifier/
 */
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acceso Pericial Oficial — SHA256.US</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="stylesheet" href="/assets/uswds/css/uswds.min.css" />
    <script is:inline src="/assets/uswds/js/uswds-init.min.js"></script>
  </head>
  <body>
    <!-- USWDS: Skipnav | https://designsystem.digital.gov/components/skip-navigation/ -->
    <a class="usa-skipnav" href="#main-content">Saltar al contenido principal</a>
    <div class="usa-overlay"></div>

    <!-- USWDS: Banner | https://designsystem.digital.gov/components/banner/ -->
    <section class="usa-banner" aria-label="Sistema Oficial de Cumplimiento Forense">
      <div class="usa-accordion">
        <header class="usa-banner__header">
          <div class="usa-banner__inner">
            <div class="grid-col-auto">
              <img aria-hidden="true" class="usa-banner__header-flag" src="/logo.png" alt="" />
            </div>
            <div class="grid-col-fill tablet:grid-col-auto" aria-hidden="true">
              <p class="usa-banner__header-text">
                CMS Oficial de Cumplimiento Forense y Cadena de Custodia Digital — SHA256.US
              </p>
              <p class="usa-banner__header-action">Así es como usted puede verificarlo</p>
            </div>
            <button
              type="button"
              class="usa-accordion__button usa-banner__button"
              aria-expanded="false"
              aria-controls="gov-banner-login"
            >
              <span class="usa-banner__button-text">Así es como usted puede verificarlo</span>
            </button>
          </div>
        </header>
        <div class="usa-banner__content usa-accordion__content" id="gov-banner-login" hidden>
          <div class="grid-row grid-gap-lg">
            <div class="usa-banner__guidance tablet:grid-col-6">
              <img
                class="usa-banner__icon usa-media-block__img"
                src="/assets/uswds/img/icon-dot-gov.svg"
                role="img"
                alt=""
                aria-hidden="true"
              />
              <div class="usa-media-block__body">
                <p>
                  <strong>Acceso restringido a peritos y custodios acreditados</strong><br />
                  Toda sesión se audita bajo los controles ISO/IEC 27001 A.8.15 y el Manual Único de Cadena de Custodia (MUCC-2017).
                </p>
              </div>
            </div>
            <div class="usa-banner__guidance tablet:grid-col-6">
              <img
                class="usa-banner__icon usa-media-block__img"
                src="/assets/uswds/img/icon-https.svg"
                role="img"
                alt=""
                aria-hidden="true"
              />
              <div class="usa-media-block__body">
                <p>
                  <strong>Autenticación multifactor (TOTP RFC 6238)</strong><br />
                  Los operadores pueden autenticar su identidad pericial mediante contraseña cifrada o código dinámico de 6 dígitos.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- USWDS: Header Basic | https://designsystem.digital.gov/components/header/ -->
    <header class="usa-header usa-header--basic">
      <div class="usa-nav-container">
        <div class="usa-navbar">
          <div class="usa-logo">
            <em class="usa-logo__text font-heading-sm tablet:font-heading-md">
              <a href="/" title="SHA256.US — Forensic Chief Compliance Officer">
                SHA256.US — Forensic Chief Compliance Officer
              </a>
            </em>
          </div>
        </div>
      </div>
    </header>

    <main id="main-content">
      <div class="bg-base-lightest">
        <section class="grid-container usa-section padding-y-3 tablet:padding-y-6">
          <div class="grid-row flex-justify-center">
            <div class="grid-col-12 tablet:grid-col-10 desktop:grid-col-7 widescreen:grid-col-6">
              <div class="bg-white padding-2 tablet:padding-4 desktop:padding-5 border border-base-lighter">
                <h1 class="margin-top-0 margin-bottom-1 font-heading-lg text-primary-darker">
                  Acceso a Bóveda Pericial
                </h1>
                <p class="usa-intro margin-top-0 margin-bottom-3 font-body-sm text-base-dark">
                  CMS de Cumplimiento Normativo ISO/IEC 27037 y Cadena de Custodia MUCC-2017.
                </p>

                <!-- USWDS: Button group segmented | https://designsystem.digital.gov/components/button-group/ -->
                <ul class="usa-button-group usa-button-group--segmented margin-bottom-3 width-full">
                  <li class="usa-button-group__item flex-1">
                    <button type="button" id="tab-pass" class="usa-button width-full font-sans-xs padding-x-1 padding-y-1 text-center">
                      Contraseña
                    </button>
                  </li>
                  <li class="usa-button-group__item flex-1">
                    <button type="button" id="tab-totp" class="usa-button usa-button--outline width-full font-sans-xs padding-x-1 padding-y-1 text-center">
                      Google 2FA (TOTP)
                    </button>
                  </li>
                </ul>

                <!-- USWDS: Alert | https://designsystem.digital.gov/components/alert/ -->
                <div
                  id="login-error-alert"
                  class="usa-alert usa-alert--error usa-alert--slim margin-bottom-2"
                  role="alert"
                  hidden
                >
                  <div class="usa-alert__body">
                    <p class="usa-alert__text" id="login-error-msg">Credenciales inválidas</p>
                  </div>
                </div>

                <!-- USWDS: Sign-in form | https://designsystem.digital.gov/templates/sign-in-page/ -->
                <form class="usa-form width-full maxw-full" id="login-form">
                  <fieldset class="usa-fieldset">
                    <legend class="usa-legend usa-legend--large font-heading-md text-primary-darker">
                      Credenciales del Operador Forense
                    </legend>

                    <label class="usa-label" for="email">
                      Correo electrónico institucional <abbr title="obligatorio" class="usa-hint usa-hint--required">*</abbr>
                    </label>
                    <input
                      class="usa-input"
                      id="email"
                      name="email"
                      type="email"
                      autocapitalize="off"
                      autocorrect="off"
                      required
                    />

                    <div id="campo-password-wrap">
                      <label class="usa-label" for="password">
                        Contraseña de seguridad <abbr title="obligatorio" class="usa-hint usa-hint--required">*</abbr>
                      </label>
                      <input
                        class="usa-input"
                        id="password"
                        name="password"
                        type="password"
                        required
                      />
                    </div>

                    <div id="campo-totp-wrap" hidden>
                      <label class="usa-label" for="totp-code">
                        Código de Google Authenticator (6 dígitos) <abbr title="obligatorio" class="usa-hint usa-hint--required">*</abbr>
                      </label>
                      <div class="usa-hint" id="totp-hint">Ingrese el código numérico temporal de 6 dígitos</div>
                      <input
                        class="usa-input font-mono-lg"
                        id="totp-code"
                        name="totpCode"
                        type="text"
                        inputmode="numeric"
                        pattern="[0-9]*"
                        maxlength="6"
                        aria-describedby="totp-hint"
                      />

                      <!-- USWDS: Summary box | https://designsystem.digital.gov/components/summary-box/ -->
                      <div class="usa-summary-box margin-top-2" role="region" aria-labelledby="totp-config-heading">
                        <div class="usa-summary-box__body">
                          <h2 class="usa-summary-box__heading" id="totp-config-heading">
                            Configuración de clave secreta TOTP
                          </h2>
                          <div class="usa-summary-box__text">
                            <ul class="usa-list">
                              <li>Perito Analizador: <code>JULLJOLLFCCO2FA1</code></li>
                              <li>Encargado Adquisición: <code>SHA256USFCCO2FA2</code></li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>

                    <input
                      class="usa-button margin-top-3 width-full font-sans-xs padding-y-1"
                      type="submit"
                      id="btn-submit"
                      value="Ingresar al Sistema Forense"
                    />
                  </fieldset>
                </form>
              </div>
            </div>
          </div>
        </section>
      </div>
    </main>

    <!-- USWDS: Identifier | https://designsystem.digital.gov/components/identifier/ -->
    <div class="usa-identifier">
      <section
        class="usa-identifier__section usa-identifier__section--masthead"
        aria-label="Identificación institucional del laboratorio"
      >
        <div class="usa-identifier__container">
          <div class="usa-identifier__logos">
            <a href="/" class="usa-identifier__logo">
              <img
                class="usa-identifier__logo-img"
                src="/logo.png"
                alt="Logo Laboratorio Forense SHA256.US"
                role="img"
              />
            </a>
          </div>
          <section class="usa-identifier__identity" aria-label="Descripción de la institución">
            <p class="usa-identifier__identity-domain">sha256.us</p>
            <p class="usa-identifier__identity-disclaimer">
              Sistema Oficial de Gestión de Cumplimiento Forense de{' '}
              <a href="/">Forensic Chief Compliance Officer (FCCO)</a>.
              El uso del U.S. Web Design System responde a estándares de accesibilidad WCAG 2.1 AA y no implica afiliación con el gobierno de EE. UU.
            </p>
          </section>
        </div>
      </section>
    </div>

    <script>
      import { phpApi } from '../lib/data/phpApi';
      import { useAuthStore } from '../store/authStore';

      const form = document.getElementById('login-form');
      const errorAlert = document.getElementById('login-error-alert');
      const errorMsg = document.getElementById('login-error-msg');
      const btnSubmit = document.getElementById('btn-submit') as HTMLInputElement;

      const tabPass = document.getElementById('tab-pass');
      const tabTotp = document.getElementById('tab-totp');
      const wrapPass = document.getElementById('campo-password-wrap');
      const wrapTotp = document.getElementById('campo-totp-wrap');
      const passwordInput = document.getElementById('password') as HTMLInputElement;
      const totpInput = document.getElementById('totp-code') as HTMLInputElement;

      let authMode: 'pass' | 'totp' = 'pass';

      function setMode(mode: 'pass' | 'totp') {
        authMode = mode;
        if (mode === 'pass') {
          tabPass?.classList.remove('usa-button--outline');
          tabTotp?.classList.add('usa-button--outline');
          if (wrapPass) wrapPass.hidden = false;
          if (wrapTotp) wrapTotp.hidden = true;
          if (passwordInput) passwordInput.required = true;
          if (totpInput) totpInput.required = false;
        } else {
          tabPass?.classList.add('usa-button--outline');
          tabTotp?.classList.remove('usa-button--outline');
          if (wrapPass) wrapPass.hidden = true;
          if (wrapTotp) wrapTotp.hidden = false;
          if (passwordInput) passwordInput.required = false;
          if (totpInput) {
            totpInput.required = true;
            totpInput.focus();
          }
        }
      }

      if (tabPass) tabPass.addEventListener('click', () => setMode('pass'));
      if (tabTotp) tabTotp.addEventListener('click', () => setMode('totp'));

      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const emailInput = document.getElementById('email') as HTMLInputElement;

          if (btnSubmit) btnSubmit.value = 'Verificando credenciales...';

          const email = (emailInput?.value || '').trim();
          const pass = authMode === 'pass' ? (passwordInput?.value || '').trim() : '';
          const totp = authMode === 'totp' ? (totpInput?.value || '').trim() : '';

          const res = await phpApi.login(email, pass, totp);

          if (res.ok) {
            window.location.href = '/dashboard';
            return;
          }

          const localOk = await useAuthStore.getState().login(email, pass, totp);
          if (localOk) {
            window.location.href = '/dashboard';
            return;
          }

          if (errorAlert && errorMsg) {
            errorMsg.textContent =
              res.error || useAuthStore.getState().error || 'Credenciales no autorizadas o código 2FA erróneo';
            errorAlert.hidden = false;
          }
          if (btnSubmit) btnSubmit.value = 'Ingresar al Sistema Forense';
        });
      }
    </script>
    <script is:inline src="/assets/uswds/js/uswds.min.js"></script>
  </body>
</html>
