---
/**
 * SHA256.US — Acta de Desprecintado, Apertura y Adquisición Lógica en Laboratorio
 * Fundamentación: ISO/IEC 27037 §5.4.4 / §7.1.3 · NIST SP 800-101 Nivel 2 · COPP Art. 187 · LMDFE Art. 7.
 * Formato Oficial: Tamaño Folio (216mm x 330mm) · 1 Hoja Física · Monocromático B&W Puro.
 */
import PlanillaHeader from './PlanillaHeader.astro';
import PlanillaFooter from './PlanillaFooter.astro';
import PlanillaFirmasBilaterales from './PlanillaFirmasBilaterales.astro';
import type { CasoCMS } from '../../lib/domain/types';

interface Props {
  caso?: Partial<CasoCMS>;
  modo?: 'blanco' | 'datos';
}

const { caso = {}, modo = 'blanco' } = Astro.props;
const isBlanco = true;

const dispositivoDesc = caso.dispositivo_marca
  ? `${caso.dispositivo_marca} ${caso.dispositivo_modelo || ''}`
  : caso.discoduro_marca
    ? `${caso.discoduro_marca} ${caso.discoduro_modelo || ''}`
    : '';
---

<div class="folio-forense-aislado">
  <div class="page">
    <div class="watermark">DESPRECINTADO</div>

    <PlanillaHeader
      title="Acta de Desprecintado y Adquisición Lógica en Laboratorio"
      norma="ISO/IEC 27037 §5.4.4 / §7.1.3 · NIST SP 800-101 NIVEL 2 · COPP ART. 187"
      codigoDoc="FO-F2-05"
      numeroCaso={caso.numeroCaso}
      numeroPRCC={caso.numero_prcc || caso.numeroPRCC}
      modo={modo}
      hojaActual={1}
      totalHojas={1}
    />

    <div class="planilla-body">
      <!-- 1.0 CONDICIONES DE APERTURA -->
      <div class="section-block">
        <div class="section-heading">1.0 DATOS DE APERTURA Y MEDIO CONTROLADO DE LABORATORIO</div>
        <table class="forense-cell-table">
          <tbody>
            <tr>
              <td class="forense-cell-label" style="width: 25%;">Lugar de Apertura:</td>
              <td class="forense-cell-value" style="width: 35%;">
                {isBlanco ? <span class="linea-manual" data-default="Área Pericial Aislada — Laboratorio SHA256.US"></span> : <span>Área Pericial Aislada — Laboratorio SHA256.US</span>}
              </td>
              <td class="forense-cell-label" style="width: 20%;">Fecha y Hora:</td>
              <td class="forense-cell-value font-mono" style="width: 20%;">
                {isBlanco ? <span class="linea-manual" data-field="fecha" data-default={`${new Date().toLocaleDateString('es-VE')} · 11:30 VET`}></span> : <span>{new Date().toLocaleDateString('es-VE')} · 11:30 VET</span>}
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 2.0 VERIFICACIÓN PREVIA DEL PRECINTO Y NUEVO PRECINTO -->
      <div class="section-block">
        <div class="section-heading">2.0 TRAZABILIDAD DE PRECINTOS: INICIAL Y REEMBALAJE (MUCC-2017)</div>
        <table class="forense-table">
          <tbody>
            <tr>
              <th style="width: 28%;">Dispositivo Móvil / Medio Digital:</th>
              <td style="width: 72%;">{isBlanco ? <span class="linea-manual" data-field="dispositivo_descripcion" data-default="Smartphone Samsung Galaxy A54 (S/N o IMEI: 354928110948271)"></span> : <span>{dispositivoDesc || 'Smartphone'} (S/N o IMEI: {caso.dispositivo_imei || caso.discoduro_serial || 'N/A'})</span>}</td>
            </tr>
            <tr>
              <th>Precinto Inicial Roto N°:</th>
              <td class="font-mono">{isBlanco ? <span class="linea-manual" data-field="precinto_numero" data-default="PREC-2026-991"></span> : <span data-field="precinto_numero">{caso.precinto_numero || 'PREC-2026-991'}</span>}</td>
            </tr>
            <tr>
              <th>Estado Físico del Precinto:</th>
              <td>{isBlanco ? <span data-default="[ X ] ÍNTEGRO, SIN SIGNOS DE APERTURA PREVIA NI ADULTERACIÓN">[&nbsp;&nbsp;] Íntegro sin apertura previa &nbsp;&nbsp;&nbsp; [&nbsp;&nbsp;] Dañado / Violado</span> : <span>[&nbsp;X&nbsp;] ÍNTEGRO, SIN SIGNOS DE APERTURA PREVIA NI ADULTERACIÓN</span>}</td>
            </tr>
            <tr>
              <th>Nuevo Precinto de Reembalaje N°:</th>
              <td class="font-mono">{isBlanco ? <span class="linea-manual" data-default="PREC-REEMB-2026-992 (Asignado tras extracción)"></span> : <span>PREC-REEMB-2026-992 (Asignado tras extracción)</span>}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 3.0 PROCEDIMIENTO DE ADQUISICIÓN LÓGICA Y HASH -->
      <div class="section-block">
        <div class="section-heading">3.0 ADQUISICIÓN LÓGICA / BIT-A-BIT FORENSE Y CÁLCULO DE HASH (NIST SP 800-101 · NIST SP 800-86)</div>
        <table class="forense-table">
          <tbody>
            <tr>
              <th style="width: 32%;">Modalidad de Adquisición:</th>
              <td>{isBlanco ? <span class="linea-manual" data-default="Extracción Lógica Móvil (NIST 800-101 Nivel 2) / Adquisición con Bloqueo de Escritura (NIST 800-86)"></span> : <span>Extracción Lógica de Contenedor y Bases de Datos SQLite (NIST Nivel 2)</span>}</td>
            </tr>
            <tr>
              <th>Herramienta Forense Empleada:</th>
              <td>{isBlanco ? <span class="linea-manual" data-default="ALEAPP CLI / Andriller / Avilla Forensics / FTK Imager (Validadas CENIF G.O. 39.847)"></span> : <span>ALEAPP CLI / Andriller / Protocolo de Respaldo Lógico Auditado</span>}</td>
            </tr>
            <tr>
              <th>Base de Datos / Medio Extraído:</th>
              <td class="font-mono">{isBlanco ? <span class="linea-manual" data-default="msgstore.db / wa.db (WhatsApp/Redes), Imágenes, Notas de Voz, Capturas o Contenedor (.E01/.RAW)"></span> : <span>msgstore.db / wa.db (Comunicaciones de WhatsApp)</span>}</td>
            </tr>
            <tr>
              <th>Hash SHA-256 de la Evidencia:</th>
              <td class="font-mono">{isBlanco ? <span class="linea-manual" data-field="hashSHA256" data-default="b5f2a3e8c9d1047f6a2d3e8c9b5f1e2d7a4c0f3b8e5d2a9c6b3f0e7d1a2c3b4e"></span> : <span data-field="hashSHA256">{caso.hashSHA256 || 'Pendiente por cálculo'}</span>}</td>
            </tr>
            <tr>
              <th>Verificación de Integridad:</th>
              <td style="font-weight: 700;">{isBlanco ? <span data-default="[ X ] MATCH (100% ÍNTEGRO — VALIDEZ DE ORIGINAL ART. 7 LMDFE)">[&nbsp;&nbsp;] MATCH (100% ÍNTEGRO) &nbsp;&nbsp;&nbsp; [&nbsp;&nbsp;] MISMATCH (ALERTA)</span> : <span>[&nbsp;X&nbsp;] MATCH (100% ÍNTEGRO — VALIDEZ DE ORIGINAL ART. 7 LMDFE)</span>}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 4.0 REEMBALAJE Y RESGUARDO -->
      <div class="legal-clause">
        <strong>4.0 CONSTANCIA DE REEMBALAJE Y RESGUARDO (MUCC-2017):</strong> Culminada con éxito la extracción lógica forense de la base de datos de mensajería o contenedor del medio digital consignado y calculado su Hash SHA-256, se reembaló el teléfono celular o soporte original en bolsa Faraday / empaque de seguridad y se le aplicó el Nuevo Precinto de Seguridad supra registrado, garantizando su indemnidad para posterior cotejo o devolución formal.
      </div>
    </div>

    <!-- 5.0 CIERRE LEGAL: FIRMAS Y HUELLAS DACTILARES -->
    <PlanillaFirmasBilaterales
      leftRole="perito"
      coPeritoTitulo="PERITO EXTRACTOR / ADQUISIDOR"
      peritoTitulo="CO-PERITO DE CONTROL DE CALIDAD"
      coPeritoNombre={caso.peritoLider || 'Ing. Jull Joll'}
      coPeritoCedula={caso.perito_cedula || 'V-18.999.001'}
      coPeritoCiv={caso.perito_civ || '299410'}
      coPeritoCargo="Perito Informático Forense (Extracción Lógica)"
      peritoNombre="Ing. Christopher V. Vance"
      peritoCedula="V-15.816.003"
      peritoCiv="CIV-310520"
      peritoInpre="INPRE-201450"
      peritoCargo="Especialista en Adquisición Lógica"
      rolIso="DEFR / DES · ISO/IEC 27037"
      modo={modo}
    />

    <div class="sig-line" style="display: none;"></div>

    <PlanillaFooter
      hashSha256={caso.hashSHA256}
      hojaActual={1}
      totalHojas={1}
      modo={modo}
    />
  </div>
</div>
