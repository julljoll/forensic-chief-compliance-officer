---
/**
 * SHA256.US — Planilla de Registro de Cadena de Custodia (PRCC)
 * Fundamentación: MUCC-2017 & COPP Art. 187 · LMDFE Art. 7 · ISO/IEC 27037.
 * Formato Oficial: Tamaño Folio (216mm x 330mm) · 2 Hojas Físicas (Anverso y Reverso) · Monocromático B&W Puro.
 */
import PlanillaHeader from './PlanillaHeader.astro';
import PlanillaFooter from './PlanillaFooter.astro';
import PlanillaFirmasBilaterales from './PlanillaFirmasBilaterales.astro';
import type { CasoCMS } from '../../lib/domain/types';

interface Props {
  caso?: Partial<CasoCMS>;
  modo?: 'blanco' | 'datos';
}

const { caso = {}, modo = 'blanco' } = Astro.props;
const isBlanco = modo === 'blanco' || !caso.numeroCaso;

const prccNum = caso.numero_prcc || caso.numeroPRCC || '';
const dispositivoDesc = caso.dispositivo_marca
  ? `${caso.dispositivo_marca} ${caso.dispositivo_modelo || ''}`
  : caso.discoduro_marca
    ? `${caso.discoduro_marca} ${caso.discoduro_modelo || ''}`
    : '';
---

<div class="folio-forense-aislado">
  <!-- ==================== HOJA 1 DE 2 (ANVERSO) ==================== -->
  <div class="page">
    <div class="watermark">CADENA CUSTODIA</div>

    <PlanillaHeader
      title="Planilla de Registro de Cadena de Custodia (PRCC)"
      norma="MANUAL ÚNICO DE CADENA DE CUSTODIA (MUCC-2017) · COPP ART. 187"
      codigoDoc="FO-F1-04"
      numeroCaso={caso.numeroCaso}
      numeroPRCC={prccNum}
      modo={modo}
      hojaActual={1}
      totalHojas={2}
    />

    <div class="planilla-body">
      <!-- I. DATOS GENERALES -->
      <div class="section-block">
        <div class="section-heading">I. DATOS GENERALES DE LA CAUSA Y DESPACHO INSTRUCTOR (MUCC-2017)</div>
        <table class="forense-cell-table">
          <tbody>
            <tr>
              <td class="forense-cell-label" style="width: 25%;">N° Expediente / Causa:</td>
              <td class="forense-cell-value font-mono" style="width: 25%;">
                {isBlanco ? <span class="linea-manual" data-field="numeroCaso" data-default="MP-01-2026-WA"></span> : <span data-field="numeroCaso">{caso.numeroCaso}</span>}
              </td>
              <td class="forense-cell-label" style="width: 25%;">N° Registro PRCC:</td>
              <td class="forense-cell-value font-mono" style="width: 25%;">
                {isBlanco ? <span class="linea-manual" data-field="numero_prcc" data-default="PRCC-2026-001"></span> : <span data-field="numero_prcc">{prccNum}</span>}
              </td>
            </tr>
            <tr>
              <td class="forense-cell-label">N° Oficio / Memorando:</td>
              <td class="forense-cell-value font-mono">
                {isBlanco ? <span class="linea-manual" data-field="numero_comunicacion" data-default="OFIC-2026-F11-094"></span> : <span>OFIC-2026-F11-094</span>}
              </td>
              <td class="forense-cell-label">Despacho / Fiscalía:</td>
              <td class="forense-cell-value">
                {isBlanco ? <span class="linea-manual" data-field="despachoFiscal" data-default="Fiscalía / Tribunal de Control"></span> : <span data-field="despachoFiscal">{caso.despachoFiscal || 'Fiscalía Décima Primera del MP'}</span>}
              </td>
            </tr>
            <tr>
              <td class="forense-cell-label">Organismo que Apertura:</td>
              <td class="forense-cell-value">
                {isBlanco ? <span class="linea-manual" data-field="organismoOrdenante" data-default="Laboratorio Forense SHA256.US"></span> : <span data-field="organismoOrdenante">Laboratorio Forense SHA256.US</span>}
              </td>
              <td class="forense-cell-label">Sede de Obtención:</td>
              <td class="forense-cell-value">
                {isBlanco ? <span class="linea-manual" data-field="solicitante_direccion" data-default="Sede Central Forense SHA256.US"></span> : <span data-field="solicitante_direccion">Sede Central Forense SHA256.US</span>}
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- II. FORMAS DE OBTENCIÓN SEGÚN MUCC-2017 -->
      <div class="section-block">
        <div class="section-heading">II. FORMAS DE OBTENCIÓN DE LA EVIDENCIA (MUCC-2017 §II)</div>
        <div style="display: flex; justify-content: space-around; font-size: 7.5pt; padding: 3px 0; font-weight: 700;">
          <span>[&nbsp;&nbsp;] 1. Técnica</span>
          <span>[&nbsp;&nbsp;] 2. Aseguramiento</span>
          <span data-default="[ X ] 3. Consignación">{isBlanco ? '[   ] 3. Consignación' : '[ X ] 3. Consignación'}</span>
          <span>[&nbsp;&nbsp;] 4. Derivación</span>
        </div>
      </div>

      <!-- III. OPERARIOS QUE OBTIENEN LA EVIDENCIA -->
      <div class="section-block">
        <div class="section-heading">III. OPERARIOS ACTUANTES EN LA OBTENCIÓN Y PRESERVACIÓN</div>
        <div class="form-grid-2">
          <!-- A. Fijación -->
          <div style="border: 1px solid #000; padding: 4px;">
            <div style="font-weight: 800; font-size: 7pt; border-bottom: 1px solid #000; margin-bottom: 3px; background: #F0F0F0; padding: 1px 3px;">
              A. FIJACIÓN FOTOGRÁFICA 360°
            </div>
            <div class="field-row">
              <span class="field-label">Nombres y Apellidos:</span>
              <div class="field-value">{isBlanco ? <span class="linea-manual" data-field="peritoLider" data-default="Jull Joll (Perito Principal)"></span> : <span>{caso.peritoLider || 'Perito Oficial'}</span>}</div>
            </div>
            <div class="field-row">
              <span class="field-label">C.I. / Credencial N°:</span>
              <div class="field-value font-mono">{isBlanco ? <span class="linea-manual" data-field="perito_cedula" data-default="V-18.999.001 · CIV-299410"></span> : <span>{caso.perito_cedula || 'V-18.999.001'}</span>}</div>
            </div>
            <div class="sig-line-solid sig-line" style="margin-top: 10px;"></div>
            <div style="font-size: 6pt; text-align: center; font-weight: 700;">Firma de Fijación</div>
          </div>

          <!-- B. Colección / Recepción -->
          <div style="border: 1px solid #000; padding: 4px;">
            <div style="font-weight: 800; font-size: 7pt; border-bottom: 1px solid #000; margin-bottom: 3px; background: #F0F0F0; padding: 1px 3px;">
              B. RECEPCIÓN Y EMBALAJE FARADAY
            </div>
            <div class="field-row">
              <span class="field-label">Nombres y Apellidos:</span>
              <div class="field-value">{isBlanco ? <span class="linea-manual" data-field="peritoLider" data-default="Jull Joll (Perito Principal)"></span> : <span>{caso.peritoLider || 'Perito Oficial'}</span>}</div>
            </div>
            <div class="field-row">
              <span class="field-label">C.I. / Credencial N°:</span>
              <div class="field-value font-mono">{isBlanco ? <span class="linea-manual" data-field="perito_cedula" data-default="V-18.999.001 · CIV-299410"></span> : <span>{caso.perito_cedula || 'V-18.999.001'}</span>}</div>
            </div>
            <div class="sig-line-solid sig-line" style="margin-top: 10px;"></div>
            <div style="font-size: 6pt; text-align: center; font-weight: 700;">Firma de Recepción</div>
          </div>
        </div>
      </div>

      <!-- IV. DESCRIPCIÓN DETALLADA DE LA EVIDENCIA -->
      <div class="section-block">
        <div class="section-heading">IV. DESCRIPCIÓN DETALLADA DE LA EVIDENCIA Y HASH DEL CONTENEDOR LÓGICO</div>
        <table class="forense-table">
          <tbody>
            <tr>
              <th style="width: 25%;">Dispositivo / Medio Consignado:</th>
              <td style="width: 75%;">{isBlanco ? <span class="linea-manual" data-field="dispositivo_descripcion" data-default="Smartphone Samsung Galaxy A54 · S/N o IMEI: 354928110948271"></span> : <span>{dispositivoDesc || 'Smartphone'} · IMEI: <span class="font-mono">{caso.dispositivo_imei || caso.discoduro_serial || 'N/A'}</span></span>}</td>
            </tr>
            <tr>
              <th>Tipo de Evidencia:</th>
              <td>{isBlanco ? <span class="linea-manual" data-default="[ X ] Evidencia Física (Móvil / CD / Disco / Reloj / PC / Servidor / Cámara)   [ X ] Evidencia Lógica (Redes / Imágenes / Audios / Capturas / SQLite)"></span> : <span>[ X ] Evidencia Física Principal (Teléfono) &nbsp;&nbsp;&nbsp; [ X ] Evidencia Lógica Derivada (SQLite msgstore.db)</span>}</td>
            </tr>
            <tr>
              <th>Bolsa Faraday y Precinto:</th>
              <td class="font-mono">{isBlanco ? <span class="linea-manual" data-field="precinto_numero" data-default="Bolsa: FARADAY-2026-001 · Precinto: PREC-2026-991"></span> : <span>Bolsa: <span data-field="bolsa_faraday_numero">{caso.bolsa_faraday_numero || 'FARADAY-01'}</span> · Precinto: <span data-field="precinto_numero">{caso.precinto_numero || 'PREC-991'}</span></span>}</td>
            </tr>
            <tr>
              <th>Hash SHA-256 de Extracción Lógica:</th>
              <td class="font-mono">{isBlanco ? <span class="linea-manual" data-field="hashSHA256" data-default="b5f2a3e8c9d1047f6a2d3e8c9b5f1e2d7a4c0f3b8e5d2a9c6b3f0e7d1a2c3b4e"></span> : <span data-field="hashSHA256">{caso.hashSHA256 || 'Pendiente por cálculo en extracción F2'}</span>}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <PlanillaFooter
      hashSha256={caso.hashSHA256}
      hojaActual={1}
      totalHojas={2}
      modo={modo}
    />
  </div>

  <!-- ==================== HOJA 2 DE 2 (REVERSO) ==================== -->
  <div class="page">
    <div class="watermark">TRAZABILIDAD</div>

    <PlanillaHeader
      title="PRCC — Trazabilidad y Transferencias Cronológicas"
      norma="MANUAL ÚNICO DE CADENA DE CUSTODIA (MUCC-2017) · COPP ART. 187"
      codigoDoc="FO-F1-04-REV"
      numeroCaso={caso.numeroCaso}
      numeroPRCC={prccNum}
      modo={modo}
      hojaActual={2}
      totalHojas={2}
    />

    <div class="planilla-body">
      <!-- V. REGISTRO CRONOLÓGICO DE TRANSFERENCIAS (MUCC-2017) -->
      <div class="section-block">
        <div class="section-heading">V. REGISTRO CRONOLÓGICO DE TRANSFERENCIAS DE CUSTODIA (MUCC-2017 §TRASPASOS)</div>
        <table class="forense-table">
          <thead>
            <tr>
              <th style="width: 3%;">N°</th>
              <th style="width: 12%;">Fecha / Hora</th>
              <th style="width: 25%;">Entrega (Nombres, C.I., Cred./CIV, Firma)</th>
              <th style="width: 25%;">Recibe (Nombres, C.I., Cred./CIV, Firma)</th>
              <th style="width: 20%;">Motivo / N° Oficio / Despacho</th>
              <th style="width: 15%;">Precinto (N° y Condición)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td style="text-align: center; font-weight: 700;">1</td>
              <td class="font-mono">{isBlanco ? <span class="linea-manual" data-default={new Date().toLocaleDateString('es-VE')}></span> : new Date().toLocaleDateString('es-VE')}</td>
              <td>{isBlanco ? <span class="linea-manual" data-field="solicitante_nombre" data-default="Insp. Jefe Luis Ortega (Consignante)"></span> : <span>{caso.solicitante_nombre || 'Consignante'} (C.I. {caso.solicitante_cedula || ''})</span>}</td>
              <td>{isBlanco ? <span class="linea-manual" data-field="peritoLider" data-default="Jull Joll (CIV 299410 · SHA256.US)"></span> : <span>{caso.peritoLider || 'Perito SHA256.US'} (CIV {caso.perito_civ || '299410'})</span>}</td>
              <td>{isBlanco ? <span class="linea-manual" data-default="Consignación e ingreso a laboratorio"></span> : <span>Consignación e ingreso a laboratorio</span>}</td>
              <td class="font-mono">{isBlanco ? <span data-default="N° PREC-991 [X] Intacto">[&nbsp;&nbsp;] Intacto [&nbsp;&nbsp;] Reemp.</span> : `N° ${caso.precinto_numero || 'PREC-991'} [X] Intacto`}</td>
            </tr>
            <tr>
              <td style="text-align: center; font-weight: 700;">2</td>
              <td><span class="linea-manual"></span></td>
              <td><span class="linea-manual"></span></td>
              <td><span class="linea-manual"></span></td>
              <td><span class="linea-manual"></span></td>
              <td>[&nbsp;&nbsp;] Intacto [&nbsp;&nbsp;] Reemp.</td>
            </tr>
            <tr>
              <td style="text-align: center; font-weight: 700;">3</td>
              <td><span class="linea-manual"></span></td>
              <td><span class="linea-manual"></span></td>
              <td><span class="linea-manual"></span></td>
              <td><span class="linea-manual"></span></td>
              <td>[&nbsp;&nbsp;] Intacto [&nbsp;&nbsp;] Reemp.</td>
            </tr>
            <tr>
              <td style="text-align: center; font-weight: 700;">4</td>
              <td><span class="linea-manual"></span></td>
              <td><span class="linea-manual"></span></td>
              <td><span class="linea-manual"></span></td>
              <td><span class="linea-manual"></span></td>
              <td>[&nbsp;&nbsp;] Intacto [&nbsp;&nbsp;] Reemp.</td>
            </tr>
            <tr>
              <td style="text-align: center; font-weight: 700;">5</td>
              <td><span class="linea-manual"></span></td>
              <td><span class="linea-manual"></span></td>
              <td><span class="linea-manual"></span></td>
              <td><span class="linea-manual"></span></td>
              <td>[&nbsp;&nbsp;] Intacto [&nbsp;&nbsp;] Reemp.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- VI. OBSERVACIONES Y DISPOSICIÓN FINAL -->
      <div class="legal-clause">
        <strong>VI. DISPOSICIÓN FINAL Y CONDICIÓN DE RESGUARDO (MUCC-2017 §DISPOSICIÓN FINAL):</strong> El teléfono inteligente o medio digital consignado y los contenedores lógicos extraídos quedan preservados en condiciones controladas de laboratorio. Todo cambio de precinto por desprecintado pericial o reembalaje debe registrarse en la tabla supra para garantizar la trazabilidad ininterrumpida exigida por el Art. 187 del COPP.
      </div>
    </div>

    <!-- VII. CIERRE LEGAL Y FIRMAS -->
    <PlanillaFirmasBilaterales
      consignanteTitulo="QUIEN ENTREGA CUSTODIA"
      peritoTitulo="QUIEN RECIBE CUSTODIA (SHA256.US)"
      solicitanteNombre={caso.solicitante_nombre}
      solicitanteCedula={caso.solicitante_cedula}
      solicitanteTelefono={caso.solicitante_telefono}
      solicitanteDireccion={caso.solicitante_direccion}
      peritoNombre={caso.peritoLider}
      peritoCedula={caso.perito_cedula}
      peritoCiv={caso.perito_civ}
      peritoInpre={caso.perito_inpre}
      peritoCargo={caso.perito_cargo}
      rolIso="DEFR · Custodio Responsable"
      modo={modo}
    />

    <div class="sig-line" style="display: none;"></div>

    <PlanillaFooter
      hashSha256={caso.hashSHA256}
      hojaActual={2}
      totalHojas={2}
      modo={modo}
    />
  </div>
</div>
