---
/**
 * SHA256.US — Acta de Entrevista Forense al Consignante
 * Fundamentación: MUCC-2017 & ISO/IEC 27042 · CRBV Art. 49 ord. 5° · Código Penal Arts. 243 y 246.
 * Formato Oficial: Tamaño Folio (216mm x 330mm) · 1 Hoja Física · Monocromático B&W Puro.
 */
import PlanillaHeader from './PlanillaHeader.astro';
import PlanillaFooter from './PlanillaFooter.astro';
import PlanillaFirmasBilaterales from './PlanillaFirmasBilaterales.astro';
import type { CasoCMS } from '../../lib/domain/types';

interface Props {
  caso?: Partial<CasoCMS>;
  modo?: 'blanco' | 'datos';
}

const { caso = {}, modo = 'blanco' } = Astro.props;
const isBlanco = true;
---

<div class="folio-forense-aislado">
  <div class="page">
    <div class="watermark">ENTREVISTA · SHA256.US</div>

    <PlanillaHeader
      title="Acta de Entrevista Técnico-Pericial al Consignante"
      norma="MUCC-2017 · CRBV ART. 49 ORD. 5° · CP ARTS. 243 Y 246 · ISO/IEC 27042"
      codigoDoc="FO-F0-02"
      numeroCaso={caso.numeroCaso}
      numeroPRCC={caso.numero_prcc || caso.numeroPRCC}
      modo={modo}
      hojaActual={1}
      totalHojas={1}
    />

    <div class="planilla-body">
      <!-- 1.0 DATOS DE IDENTIFICACIÓN -->
      <div class="section-block">
        <div class="section-heading">1.0 IDENTIFICACIÓN DEL CONSIGNANTE Y NOTIFICACIÓN CONSTITUCIONAL (CONSIGNACIÓN)</div>
        <table class="forense-cell-table">
          <tbody>
            <tr>
              <td class="forense-cell-label" style="width: 22%;">Apellidos y Nombres:</td>
              <td class="forense-cell-value" style="width: 28%;">
                {isBlanco ? <span class="linea-manual" data-field="solicitante_nombre" data-default="Insp. Jefe Luis Ortega"></span> : <span data-field="solicitante_nombre">{caso.solicitante_nombre}</span>}
              </td>
              <td class="forense-cell-label" style="width: 22%;">Cédula de Identidad / RIF:</td>
              <td class="forense-cell-value font-mono" style="width: 28%;">
                {isBlanco ? <span class="linea-manual" data-field="solicitante_cedula" data-default="V-12.345.678"></span> : <span data-field="solicitante_cedula">{caso.solicitante_cedula}</span>}
              </td>
            </tr>
            <tr>
              <td class="forense-cell-label">Teléfono de Contacto:</td>
              <td class="forense-cell-value font-mono">
                {isBlanco ? <span class="linea-manual" data-field="solicitante_telefono" data-default="+58 412-5551234"></span> : <span data-field="solicitante_telefono">{caso.solicitante_telefono}</span>}
              </td>
              <td class="forense-cell-label">Dirección de Habitación:</td>
              <td class="forense-cell-value">
                {isBlanco ? <span class="linea-manual" data-field="solicitante_direccion" data-default="Domicilio Procesal / Sede"></span> : <span data-field="solicitante_direccion">{caso.solicitante_direccion}</span>}
              </td>
            </tr>
            <tr>
              <td class="forense-cell-label">Garantía Constitucional:</td>
              <td class="forense-cell-value" colspan="3" style="font-size: 6.8pt; line-height: 1.25;">
                Notificación expresa de la garantía contra la autoincriminación (CRBV Art. 49 ord. 5°). El consignante declara libre y voluntariamente bajo juramento de ley.
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 2.0 CUESTIONARIO FORENSE ESTRUCTURADO -->
      <div class="section-block">
        <div class="section-heading">2.0 CUESTIONARIO TÉCNICO DIRIGIDO A LA EXTRACCIÓN Y VALIDACIÓN JUDICIAL (ISO/IEC 27042 · NIST 800-101 / 800-86)</div>
        <table class="forense-table">
          <thead>
            <tr>
              <th style="width: 5%;">N°</th>
              <th style="width: 45%;">Pregunta Técnica Formulada</th>
              <th style="width: 50%;">Declaración / Respuesta del Consignante</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td style="text-align: center; font-weight: 700;">1</td>
              <td>¿Cuál es el objeto pericial y qué pruebas (imágenes, redes sociales, chats, notas de voz, capturas de pantalla o medios: móvil, CD, disco duro, reloj, PC, servidor, cámara) son de interés?</td>
              <td>
                {isBlanco ? (
                  <div class="lineas-pautadas-2" data-field="descripcion" data-default="Extracción y validación judicial de autenticidad de imágenes, redes sociales, capturas de pantalla, chats y notas de voz en el dispositivo o medio digital consignado.">
                    <span class="renglon-manual"></span>
                    <span class="renglon-manual"></span>
                  </div>
                ) : (
                  <span data-field="descripcion">{caso.descripcion || 'Extracción y validación de autenticidad de chats y audios WhatsApp'}</span>
                )}
              </td>
            </tr>
            <tr>
              <td style="text-align: center; font-weight: 700;">2</td>
              <td>¿Suministra voluntariamente el PIN, patrón o contraseña de desbloqueo del móvil o medio consignado?</td>
              <td>
                {isBlanco ? (
                  <span data-default="[ X ] SÍ — Suministrado voluntariamente en sobre lacrado para acceso pericial">[&nbsp;&nbsp;] SÍ &nbsp;&nbsp; [&nbsp;&nbsp;] NO &nbsp;&nbsp; Credencial:</span>
                ) : (
                  <span>[ X ] Suministrado voluntariamente en sobre lacrado</span>
                )}
              </td>
            </tr>
            <tr>
              <td style="text-align: center; font-weight: 700;">3</td>
              <td>¿Cuál es el rango de fechas, horas aproximadas y cuentas/interlocutores de las comunicaciones o registros?</td>
              <td>
                {isBlanco ? (
                  <span class="linea-manual" data-default="Rango cronológico activo delimitado en el encargo pericial por consignación"></span>
                ) : (
                  <span>Rango activo delimitado en el encargo pericial</span>
                )}
              </td>
            </tr>
            <tr>
              <td style="text-align: center; font-weight: 700;">4</td>
              <td>¿El dispositivo móvil, aplicación o medio digital sufrió desinstalaciones, caídas, formateo o manipulación?</td>
              <td>
                {isBlanco ? (
                  <span data-default="[ X ] NO — Sistema operativo, almacenamiento y bases de datos íntegros">[&nbsp;&nbsp;] NO &nbsp;&nbsp; [&nbsp;&nbsp;] SÍ &nbsp;&nbsp; Observación:</span>
                ) : (
                  <span>[ X ] Negativo; sistema operativo y base de datos íntegros</span>
                )}
              </td>
            </tr>
            <tr>
              <td style="text-align: center; font-weight: 700;">5</td>
              <td>¿Autoriza la preservación forense y generación de copia con Hash SHA-256 para validación en tribunales?</td>
              <td>
                {isBlanco ? (
                  <span data-default="[ X ] SÍ AUTORIZA (Adquisición Forense NIST SP 800-101 / 800-86 · LMDFE Art. 7)">[&nbsp;&nbsp;] SÍ AUTORIZO &nbsp;&nbsp;&nbsp;&nbsp; [&nbsp;&nbsp;] NO AUTORIZO</span>
                ) : (
                  <span>[ X ] SÍ AUTORIZA (Extracción Lógica NIST Nivel 2)</span>
                )}
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 3.0 DECLARACIÓN DE VERACIDAD -->
      <div class="legal-clause">
        <strong>3.0 DECLARACIÓN DE VERACIDAD Y CONFORMIDAD LEGAL:</strong> El entrevistado manifiesta bajo fe de juramento que los datos y credenciales aportados son fidedignos, con pleno conocimiento de las sanciones legales por falso testimonio y perjurio previstas en los Arts. 243 y 246 del Código Penal Venezolano, autorizando la incorporación de esta acta al expediente técnico para sustentar la licitud de la prueba digital.
      </div>
    </div>

    <!-- 4.0 CIERRE LEGAL: FIRMAS Y HUELLAS DACTILARES -->
    <PlanillaFirmasBilaterales
      consignanteTitulo="DECLARANTE / ENTREVISTADO"
      peritoTitulo="PERITO ENTREVISTADOR SHA256.US"
      solicitanteNombre={caso.solicitante_nombre}
      solicitanteCedula={caso.solicitante_cedula}
      solicitanteTelefono={caso.solicitante_telefono}
      solicitanteDireccion={caso.solicitante_direccion}
      peritoNombre={caso.peritoLider}
      peritoCedula={caso.perito_cedula}
      peritoCiv={caso.perito_civ}
      peritoInpre={caso.perito_inpre}
      peritoCargo={caso.perito_cargo}
      rolIso="DEFR · ISO/IEC 27037"
      modo={modo}
    />

    <div class="sig-line" style="display: none;"></div>

    <PlanillaFooter
      hashSha256={caso.hashSHA256}
      hojaActual={1}
      totalHojas={1}
      modo={modo}
    />
  </div>
</div>
