---
/**
 * SHA256.US — Dictamen Pericial Especializado en Autenticidad de Audios Digitales
 * Fundamentación: COPP Arts. 223–225 · LMDFE Arts. 4 y 7 · CENIF (G.O. 39.847 Art. 2.1)
 * Decodificación Opus (RFC 6716) · Espectrograma FFT · SWGDE & Daubert FRE 702.
 * Formato Oficial: Tamaño Folio (216mm x 330mm) · 1 Hoja Física · Monocromático B&W Puro.
 */
import PlanillaHeader from './PlanillaHeader.astro';
import PlanillaFooter from './PlanillaFooter.astro';
import PlanillaFirmasBilaterales from './PlanillaFirmasBilaterales.astro';
import type { CasoCMS } from '../../lib/domain/types';

interface Props {
  caso?: Partial<CasoCMS>;
  modo?: 'blanco' | 'datos';
}

const { caso = {}, modo = 'blanco' } = Astro.props;
const isBlanco = true;
---

<div class="folio-forense-aislado">
  <div class="page">
    <div class="watermark">AUDIOS</div>

    <PlanillaHeader
      title="Dictamen Pericial de Autenticidad de Audios Digitales"
      norma="COPP ARTS. 223–225 · LMDFE ARTS. 4 Y 7 · SWGDE AUDIO"
      codigoDoc="FO-F4-10"
      numeroCaso={caso.numeroCaso}
      numeroPRCC={caso.numero_prcc || caso.numeroPRCC}
      modo={modo}
      hojaActual={1}
      totalHojas={1}
    />

    <div class="planilla-body">
      <!-- 1.0 MOTIVO Y DESCRIPCIÓN DEL OBJETO PERITADO (COPP ART. 225.1) -->
      <div class="section-block">
        <div class="section-heading">1.0 MOTIVO Y ESPECIFICACIÓN TÉCNICA DEL OBJETO PERITADO (COPP ART. 225 NUM. 1 · LMDFE ART. 7)</div>
        <table class="forense-table">
          <tbody>
            <tr>
              <th style="width: 28%;">Archivo de Audio / Nota:</th>
              <td style="width: 72%;">{isBlanco ? <span class="linea-manual" data-default="AUD_WHATSAPP_NOTA_VOZ.opus (Nota de Voz / Audio extraído de Móvil o Medio Digital Consignado)"></span> : <span>AUD_WHATSAPP_NOTA_VOZ.opus (Flujo nativo extraído de msgstore.db)</span>}</td>
            </tr>
            <tr>
              <th>Hash SHA-256 del Audio:</th>
              <td class="font-mono">{isBlanco ? <span class="linea-manual" data-field="hashSHA256" data-default="b5f2a3e8c9d1047f6a2d3e8c9b5f1e2d7a4c0f3b8e5d2a9c6b3f0e7d1a2c3b4e"></span> : <span data-field="hashSHA256">{caso.hashSHA256 || 'Pendiente por cálculo'}</span>}</td>
            </tr>
            <tr>
              <th>Frecuencia / Formato:</th>
              <td class="font-mono">{isBlanco ? <span class="linea-manual" data-default="Opus Interactive Audio Codec (RFC 6716) @ 48,000 Hz · 16-bit Mono"></span> : <span>Opus Interactive Audio Codec (RFC 6716) @ 48,000 Hz · 16-bit Mono</span>}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 2.0 OPERACIONES TÉCNICAS PRACTICADAS (COPP ART. 225.2) -->
      <div class="section-block">
        <div class="section-heading">2.0 OPERACIONES TÉCNICAS PRACTICADAS: ESPECTROGRAMA FFT Y FORMANTES (COPP ART. 225 NUM. 2)</div>
        <table class="forense-table">
          <thead>
            <tr>
              <th style="width: 30%;">Parámetro Acústico</th>
              <th style="width: 35%;">Valor / Medición Observada</th>
              <th style="width: 35%;">Conclusión Forense</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Formantes Vocálicos (F1, F2, F3)</td>
              <td class="font-mono">{isBlanco ? <span class="linea-manual" data-default="F1: 520 Hz · F2: 1740 Hz · F3: 2600 Hz"></span> : 'F1: 520 Hz · F2: 1740 Hz · F3: 2600 Hz'}</td>
              <td>{isBlanco ? <span class="linea-manual" data-default="Continuidad armónica sin cortes abruptos ni empalmes."></span> : <span>Continuidad armónica sin cortes abruptos ni empalmes.</span>}</td>
            </tr>
            <tr>
              <td>Piso de Ruido Acústico (Noise Floor)</td>
              <td class="font-mono">{isBlanco ? <span class="linea-manual" data-default="-54 dBFS a -48 dBFS (Constante)"></span> : '-54 dBFS a -48 dBFS (Constante)'}</td>
              <td>{isBlanco ? <span class="linea-manual" data-default="Ausencia de inserciones o empalmes de tomas ajenas."></span> : <span>Ausencia de inserciones o empalmes de tomas ajenas.</span>}</td>
            </tr>
            <tr>
              <td>Traza de Red Eléctrica (ENF 60 Hz)</td>
              <td class="font-mono">{isBlanco ? <span class="linea-manual" data-default="Frecuencia continua 59.98 Hz ± 0.02 Hz"></span> : 'Frecuencia continua 59.98 Hz ± 0.02 Hz'}</td>
              <td>{isBlanco ? <span class="linea-manual" data-default="Continuidad temporal ininterrumpida comprobada."></span> : <span>Continuidad temporal ininterrumpida comprobada.</span>}</td>
            </tr>
            <tr>
              <td>Biometría Vocal Anti-Deepfake</td>
              <td class="font-mono">{isBlanco ? <span class="linea-manual" data-default="Algoritmo YIN (Pitch F0 biológico)"></span> : 'Algoritmo YIN (Pitch F0 biológico)'}</td>
              <td>{isBlanco ? <span class="linea-manual" data-default="Voz humana auténtica; sin síntesis por IA generativa."></span> : <span>Voz humana auténtica; sin síntesis por IA generativa.</span>}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 3.0 RESULTADOS PARTICULARES Y REPRODUCIBILIDAD (COPP ART. 225.2) -->
      <div class="section-block">
        <div class="section-heading">3.0 RESULTADOS PARTICULARES Y REPRODUCIBILIDAD CIENTÍFICA (COPP ART. 225 NUM. 2 · DAUBERT)</div>
        <div style="font-size: 7.2pt; line-height: 1.35; padding: 2px;">
          {isBlanco ? (
            <div class="lineas-pautadas-2" data-default="El cotejo espectrográfico realizado mediante FFT (Fast Fourier Transform, ventana Hanning 2048 pts) demuestra la plena coherencia acústica de la señal. Los formantes vocálicos presentan micro-temblores y fluctuaciones de jitter/shimmer propios de la emisión laríngea humana biológica no reproducible mediante modelos sintéticos TTS o clonación neuronal de voz.">
              <span class="renglon-manual"></span>
              <span class="renglon-manual"></span>
            </div>
          ) : (
            <span>El cotejo espectrográfico realizado mediante FFT (Fast Fourier Transform, ventana Hanning 2048 pts) demuestra la plena coherencia acústica de la señal. Los formantes vocálicos presentan micro-temblores y fluctuaciones de jitter/shimmer propios de la emisión laríngea humana biológica no reproducible mediante modelos sintéticos TTS o clonación neuronal de voz.</span>
          )}
        </div>
      </div>

      <!-- 4.0 CONCLUSIONES Y DICTAMEN MOTIVADO (COPP ART. 225.3) -->
      <div class="legal-clause">
        <strong>4.0 CONCLUSIONES Y DICTAMEN MOTIVADO (COPP ART. 225 NUM. 3):</strong> Con arreglo a los principios de la acústica forense y el método científico colegiado (COPP Art. 223), los peritos dictaminan categóricamente que la nota de voz o grabación de audio peritada es <strong>AUTÉNTICA, ÍNTEGRA Y NO MANIPULADA</strong>, satisfaciendo el estándar de original de los Arts. 4 y 7 de la LMDFE y habiendo sido aportada por el interlocutor o titular legítimo sin violar la privacidad de terceros (Art. 21 LEDCI).
      </div>
    </div>

    <!-- 5.0 CIERRE LEGAL: FIRMAS Y HUELLAS DACTILARES (COPP ART. 223 - DOS PERITOS) -->
    <PlanillaFirmasBilaterales
      leftRole="perito"
      coPeritoTitulo="PERITO EN ACÚSTICA FORENSE (CO-PERITO)"
      consignanteTitulo="PERITO EN ACÚSTICA FORENSE (CO-PERITO)"
      peritoTitulo="PERITO PRINCIPAL / COORDINADOR FORENSE"
      coPeritoNombre={caso.co_perito_nombre || caso.perito_coadyuvante || "Ing. SHA256 Adquisición"}
      coPeritoCedula={caso.co_perito_cedula || caso.perito_coadyuvante_cedula || "V-15.816.003"}
      coPeritoCiv="310520"
      coPeritoInpre="201450"
      coPeritoCargo="Especialista en Acústica Forense"
      peritoNombre={caso.peritoLider || "Jull Joll (Perito Principal)"}
      peritoCedula={caso.perito_cedula || "V-18.999.001"}
      peritoCiv={caso.perito_civ || "299410"}
      peritoInpre={caso.perito_inpre || "184920"}
      peritoCargo={caso.perito_cargo || "Perito Informático Forense"}
      rolIso="DES (Digital Evidence Specialist) · ISO 27042"
      modo={modo}
    />

    <div class="sig-line" style="display: none;"></div>

    <PlanillaFooter
      hashSha256={caso.hashSHA256}
      hojaActual={1}
      totalHojas={1}
      modo={modo}
    />
  </div>
</div>
