---
/**
 * SHA256.US — Pie de Página Oficial Canónico Monocromático (Folio 216mm x 330mm)
 * Cumplimiento Estricto: Cero estilos inline · Tipografía Federal USWDS · Inmutabilidad SHA-256
 * Presente idénticamente al pie de cada hoja física de las 13 planillas oficiales.
 */
interface Props {
  hashSha256?: string;
  hojaActual?: number;
  totalHojas?: number;
  modo?: 'blanco' | 'datos';
}

const {
  hashSha256 = '',
  hojaActual = 1,
  totalHojas = 1,
  modo = 'blanco',
} = Astro.props;

const displayHash = '';
---

<footer class="canonical-footer">
  <div class="footer-top-line">
    <span class="footer-legal-tag">
      DOCUMENTO PERICIAL JUDICIAL · VALIDEZ COPP ARTS. 187 / 223–225 · LMDFE ARTS. 4, 7 · MUCC-2017 · ISO/IEC 27037 / 27042 · NIST SP 800-86 / 800-101
    </span>
    <span class="footer-folio-tag font-mono">
      HOJA {hojaActual} DE {totalHojas}
    </span>
  </div>

  <div class="footer-crypto-line">
    <span class="footer-crypto-label">SELLO CRIPTOGRÁFICO DE AUDITORÍA SHA-256 (RFC 8785):</span>
    <span class="footer-crypto-hash font-mono" data-field="hashSHA256" data-qr-sha256="" data-default="">{displayHash}</span>
  </div>

  <address class="footer-address-line">
    Laboratorio de Informática Forense SHA256.US · Avenida 6 con Calle 7, Edificio Mercantil La Ceiba, Piso 1, Ofic. N° 8, Quíbor, Municipio Jiménez, Estado Lara, Venezuela.
  </address>
</footer>
