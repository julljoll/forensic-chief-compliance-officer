---
/**
 * SHA256.US — Encabezado Oficial Canónico Monocromático (Folio 216mm x 330mm)
 * Estándar Federal Institucional EE.UU. (NIST SP 800-86 / FBI FD-1004 / OMB Style Control Block)
 * Vector Monocromático /logo-mono.svg · Banda de Título Federal · Grid de Metadatos.
 */
interface Props {
  title: string;
  norma: string;
  codigoDoc?: string;
  numeroCaso?: string;
  numeroPRCC?: string;
  fecha?: string;
  hora?: string;
  modo?: 'blanco' | 'datos';
  hojaActual?: number;
  totalHojas?: number;
}

const {
  title,
  norma,
  codigoDoc = 'FO-FOR-01',
  numeroCaso = '',
  numeroPRCC = '',
  fecha = '',
  hora = '',
  modo = 'blanco',
  hojaActual = 1,
  totalHojas = 1,
} = Astro.props;

const isBlanco = modo === 'blanco' || (!numeroCaso && !numeroPRCC);
---

<header class="canonical-header">
  <!-- Fila Institucional Superior: Emblema Oficial + Control Box Estilo FBI FD-1004 / OMB -->
  <div class="header-institution-row">
    <div class="header-logo-group">
      <img src="/logo-mono.svg" alt="SHA256.US Forensic Seal" class="header-logo" width="36" height="36" />
      <div class="header-rep-text">
        <span class="header-rep-country">REPÚBLICA BOLIVARIANA DE VENEZUELA</span>
        <span class="header-rep-lab">LABORATORIO DE INFORMÁTICA FORENSE SHA256.US</span>
        <span class="header-rep-sub">DIVISIÓN PERICIAL DE EVIDENCIA DIGITAL &amp; AUDITORÍA DE CUMPLIMIENTO</span>
      </div>
    </div>

    <!-- FBI FD-1004 / OMB Federal Form Control Box -->
    <div class="header-control-box">
      <div class="control-box-row">
        <span class="control-box-lbl">FORM CODE:</span>
        <strong class="control-box-val font-mono">{codigoDoc}</strong>
      </div>
      <div class="control-box-row">
        <span class="control-box-lbl">JURISDICTION:</span>
        <span class="control-box-val">COPP ART. 187 / 223</span>
      </div>
      <div class="control-box-row">
        <span class="control-box-lbl">FOLIO:</span>
        <strong class="control-box-val font-mono">HOJA {hojaActual} DE {totalHojas}</strong>
      </div>
    </div>
  </div>

  <!-- Banda de Título Federal de Alto Contraste (#1B1B1B) -->
  <div class="header-title-box">
    <h1 class="canonical-doc-title">{title}</h1>
    <div class="canonical-doc-norm">{norma}</div>
  </div>

  <!-- Grid Micro-Label de Metadatos de la Causa (ISO/IEC 27037 §7.1) -->
  <table class="header-meta-table">
    <tbody>
      <tr>
        <td class="header-meta-label">EXPEDIENTE N°:</td>
        <td class="header-meta-val">
          {isBlanco ? (
            <span class="linea-manual" data-field="numeroCaso"></span>
          ) : (
            <span data-field="numeroCaso">{numeroCaso || '_________________________'}</span>
          )}
        </td>
        <td class="header-meta-label">FECHA DE ACTUACIÓN:</td>
        <td class="header-meta-val">
          {isBlanco ? (
            <span class="linea-manual" data-field="fecha"></span>
          ) : (
            <span data-field="fecha">{fecha || new Date().toLocaleDateString('es-VE')}</span>
          )}
        </td>
      </tr>
      <tr>
        <td class="header-meta-label">REGISTRO PRCC N°:</td>
        <td class="header-meta-val">
          {isBlanco ? (
            <span class="linea-manual" data-field="numero_prcc"></span>
          ) : (
            <span data-field="numero_prcc">{numeroPRCC || '_________________________'}</span>
          )}
        </td>
        <td class="header-meta-label">HORA / SEDE FORENSE:</td>
        <td class="header-meta-val">
          {isBlanco ? (
            <span class="linea-manual"></span>
          ) : (
            <span>{hora || '10:00 VET · SEDE PRINCIPAL QUÍBOR'}</span>
          )}
        </td>
      </tr>
    </tbody>
  </table>
</header>
