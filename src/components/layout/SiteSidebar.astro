---
/**
 * SHA256.US — Panel de Control Lateral Izquierdo (Compliance Officer CMS Side Panel)
 * Componente canónico USWDS (.usa-sidenav) adaptado para panel pericial ejecutivo de 2 columnas.
 * Iconografía oficial: Sistema de Diseño USWDS (@uswds/uswds / sprite.svg)
 * Color y Tipografía Oficial: Public Sans Web / USWDS 3.14+
 */
import Icon from '../uswds/Icon.astro';

interface Props {
  activeNav?: string;
}

const { activeNav = '' } = Astro.props;

const operacionItems = [
  { href: '/dashboard', label: 'Panel General', iconName: 'assessment', key: 'dashboard' },
  { href: '/casos', label: 'Expedientes Periciales', iconName: 'folder', key: 'casos' },
  { href: '/flujo', label: 'Ciclo Pericial ISO', iconName: 'autorenew', key: 'flujo' },
  { href: '/custodia', label: 'Cadena de Custodia (PRCC)', iconName: 'verified_user', key: 'custodia' },
];

const dictamenItems = [
  { href: '/planillas', label: 'Planillas Folio (13)', iconName: 'file_present', key: 'planillas' },
  { href: '/normativa', label: 'Base Normativa RAG', iconName: 'account_balance', key: 'normativa' },
  { href: '/auditoria', label: 'Auditoría SHA-256', iconName: 'fingerprint', key: 'auditoria' },
  { href: '/exportar', label: 'Exportación de Caso', iconName: 'file_download', key: 'exportar' },
];

const sistemaItems = [
  { href: '/seguridad', label: 'Seguridad & MFA / TOTP', iconName: 'lock', key: 'seguridad' },
];
---

<div class="fcco-side-panel bg-white padding-2 radius-md border-1px border-base-lighter shadow-1 sticky-side-panel">
  <!-- Tarjeta de Acreditación del Perito / Compliance Officer -->
  <div class="fcco-side-officer border-bottom-1px border-base-lighter padding-bottom-2 margin-bottom-2">
    <div class="display-flex flex-align-center flex-justify margin-bottom-1">
      <span class="usa-tag bg-primary-darker text-white font-mono-3xs text-bold" id="user-civ-badge-sidebar">
        CIV-299410
      </span>
      <span class="usa-tag bg-success-dark text-white font-mono-3xs text-bold padding-x-1 padding-y-2px radius-pill">
        AUDITORÍA ACTIVA
      </span>
    </div>
    <div class="font-sans-xs text-bold text-ink" id="user-name-sidebar">
      Perito: Jull Joll (FCCO)
    </div>
    <div class="font-sans-3xs text-base-dark margin-top-05">
      Oficial Jefe de Cumplimiento Pericial
    </div>
  </div>

  <!-- Menú de Navegación Vertical Canónico USWDS (.usa-sidenav) -->
  <nav aria-label="Menú del Panel de Control CMS">
    <!-- Grupo 1: Operación Pericial -->
    <div class="font-mono-3xs text-bold text-base-dark text-uppercase margin-bottom-1 tracking-1">
      OPERACIÓN PERICIAL
    </div>
    <ul class="usa-sidenav margin-bottom-2">
      {operacionItems.map((item) => (
        <li class="usa-sidenav__item">
          <a
            href={item.href}
            class={activeNav === item.key ? 'usa-current' : ''}
          >
            <Icon name={item.iconName} className="fcco-nav-icon margin-right-1" />
            <span>{item.label}</span>
          </a>
        </li>
      ))}
    </ul>

    <!-- Grupo 2: Dictámenes & Compliance -->
    <div class="font-mono-3xs text-bold text-base-dark text-uppercase margin-bottom-1 tracking-1">
      DICTÁMENES &amp; AUDITORÍA
    </div>
    <ul class="usa-sidenav margin-bottom-2">
      {dictamenItems.map((item) => (
        <li class="usa-sidenav__item">
          <a
            href={item.href}
            class={activeNav === item.key ? 'usa-current' : ''}
          >
            <Icon name={item.iconName} className="fcco-nav-icon margin-right-1" />
            <span>{item.label}</span>
          </a>
        </li>
      ))}
    </ul>

    <!-- Grupo 3: Sistema & Seguridad -->
    <div class="font-mono-3xs text-bold text-base-dark text-uppercase margin-bottom-1 tracking-1">
      CONTROL &amp; SEGURIDAD
    </div>
    <ul class="usa-sidenav">
      {sistemaItems.map((item) => (
        <li class="usa-sidenav__item">
          <a
            href={item.href}
            class={activeNav === item.key ? 'usa-current' : ''}
          >
            <Icon name={item.iconName} className="fcco-nav-icon margin-right-1" />
            <span>{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- Sello Inmutable y Cerrar Sesión en Sidebar -->
  <div class="border-top-1px border-base-lighter padding-top-2 margin-top-2">
    <div class="display-flex flex-justify-between flex-align-center font-mono-3xs text-base-dark margin-bottom-1">
      <span>RFC 8785 · Inmutable</span>
      <span>v1.0.0</span>
    </div>
    <button
      type="button"
      id="btn-logout"
      class="usa-button usa-button--outline width-full font-sans-2xs text-bold padding-1 display-flex flex-align-center flex-justify-center btn-logout"
      style="cursor: pointer;"
    >
      <Icon name="logout" className="fcco-nav-icon margin-right-1" />
      <span>Cerrar Sesión</span>
    </button>
  </div>
</div>
