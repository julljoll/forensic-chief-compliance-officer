---
/**
 * SHA256.US — Componente de Guarda de Sesión y Sincronización Cliente
 * Valida la autenticación contra el backend PHP y actualiza el estado del perito.
 */
---
<script>
  import { phpApi } from '../../lib/data/phpApi';
  import { idbGetAll, idbDelete } from '../../lib/data/idb';
  import type { CasoCMS } from '../../lib/domain/types';

  async function checkSessionAndSync() {
    try {
      // 1. Limpieza de datos mock legacy en IndexedDB
      const locales = await idbGetAll<CasoCMS>('casos');
      for (const c of locales) {
        if (c.id && c.id.startsWith('caso-mock-')) {
          await idbDelete('casos', c.id);
        }
      }

      // 2. Comprobar sesión en API PHP
      const authRes = await phpApi.checkAuth();
      if (!authRes.ok) {
        // Redirigir a login si no está autenticado
        if (window.location.pathname !== '/' && !window.location.pathname.endsWith('/index.html')) {
          window.location.href = '/?msg=sesion_requerida';
          return;
        }
      } else if (authRes.data?.user) {
        // Actualizar nombre de perito en el header
        const userEl = document.getElementById('user-name');
        if (userEl) {
          const u = authRes.data.user;
          userEl.textContent = `Perito: ${u.nombre || u.email} (FCCO)`;
        }
      }

      // 3. Sincronizar catálogo de casos en segundo plano
      await phpApi.listarCasos();
    } catch (e) {
      console.warn('FCCO AuthGuard: Modo offline o sincronización pendiente:', e);
    }
  }

  // Vincular botón de cerrar sesión
  function bindLogout() {
    const btn = document.getElementById('btn-logout');
    if (btn) {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        try {
          await phpApi.logout();
        } catch {
          // continuar con redirección
        }
        window.location.href = '/';
      });
    }
  }

  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        checkSessionAndSync();
        bindLogout();
      });
    } else {
      checkSessionAndSync();
      bindLogout();
    }
  }
</script>
