---
/**
 * SHA256.US — Guarda de Sesión Fail-Closed Absoluto (Acceso por Código OTP / Enlace Mágico)
 *
 * REGLA INQUEBRANTABLE:
 * Ningún contenido protegido puede revelarse sin una respuesta autoritativa
 * HTTP 200 con `authenticated === true` y `user` válido desde `/api/auth.php`.
 * Cualquier fallo de red, respuesta 401/403/5xx o excepción destruye las
 * credenciales de cliente y redirige inmediatamente a `/?msg=sesion_requerida`.
 */
---
<script>
  import { phpApi } from '../../lib/data/phpApi';
  import { idbGetAll, idbDelete } from '../../lib/data/idb';
  import type { CasoCMS } from '../../lib/domain/types';

  function isPublicPage(): boolean {
    const p = window.location.pathname;
    return (
      p === '/' ||
      p.endsWith('/index.html') ||
      p === '' ||
      p === '/verificar' ||
      p === '/verificar/' ||
      p.endsWith('/verificar.html')
    );
  }

  function redirectLogin() {
    sessionStorage.removeItem('fcco_auth_active');
    sessionStorage.removeItem('fcco_auth_user');
    sessionStorage.removeItem('fcco_csrf_token');
    if (!isPublicPage()) {
      window.location.replace('/?msg=sesion_requerida');
    }
  }

  function revealContent() {
    const cloak = document.getElementById('fcco-auth-cloak');
    if (cloak) cloak.remove();
    document.documentElement.classList.remove('fcco-auth-loading');
  }

  async function checkSessionAndSync() {
    if (isPublicPage()) {
      return;
    }

    try {
      // 1. Verificación autoritativa obligatoria contra /api/auth.php (sin fallback offline)
      const authRes = await phpApi.checkAuth();
      const isAuth =
        authRes.status === 200 &&
        authRes.ok &&
        authRes.data?.authenticated === true &&
        !!authRes.data?.user;

      if (!isAuth) {
        redirectLogin();
        return;
      }

      // 2. Sesión confirmada por servidor (Google OIDC + TOTP verificado): hidratar UI y revelar contenido
      const u = authRes.data!.user!;
      sessionStorage.setItem('fcco_auth_active', '1');
      sessionStorage.setItem('fcco_auth_user', JSON.stringify(u));

      const fullName = [u.nombre, u.apellido].filter(Boolean).join(' ') || u.email;
      const peritoStr = `Perito: ${fullName} (FCCO)`;

      document.querySelectorAll('#user-name, #user-name-sidebar').forEach((el) => {
        el.textContent = peritoStr;
      });

      if (u.civ) {
        document.querySelectorAll('#user-civ-badge, #user-civ-badge-sidebar').forEach((el) => {
          el.textContent = String(u.civ);
        });
      }

      if (u.cargo) {
        const cargoEl = document.getElementById('user-cargo-sidebar');
        if (cargoEl) cargoEl.textContent = String(u.cargo);
      }

      revealContent();

      // 3. Tareas secundarias de sincronización (aisladas para no alterar el estado de autenticación)
      try {
        const locales = await idbGetAll<CasoCMS>('casos');
        for (const c of locales) {
          if (c.id && c.id.startsWith('caso-mock-')) {
            await idbDelete('casos', c.id);
          }
        }
        await phpApi.listarCasos();
      } catch {
        // Sincronización de casos secundaria omitida sin comprometer sesión verificada
      }
    } catch {
      // Fail-closed absoluto: ante cualquier error de red o excepción, jamás revelar contenido
      redirectLogin();
    }
  }

  // Vincular botones de cerrar sesión (con token CSRF)
  function bindLogout() {
    const btns = document.querySelectorAll('#btn-logout, #btn-logout-sidebar, .btn-logout');
    btns.forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        try {
          await phpApi.logout();
        } catch {
          // continuar con limpieza local y redirección
        }
        sessionStorage.removeItem('fcco_auth_active');
        sessionStorage.removeItem('fcco_auth_user');
        sessionStorage.removeItem('fcco_csrf_token');
        window.location.replace('/?msg=sesion_cerrada');
      });
    });
  }

  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        checkSessionAndSync();
        bindLogout();
      });
    } else {
      checkSessionAndSync();
      bindLogout();
    }
  }
</script>
