---
/**
 * SHA256.US — Componente de Guarda de Sesión y Sincronización Cliente
 * Valida la autenticación contra el backend PHP y actualiza el estado del perito.
 * Bloquea de forma determinante cualquier acceso no autenticado a rutas protegidas.
 */
---
<script>
  import { phpApi } from '../../lib/data/phpApi';
  import { idbGetAll, idbDelete } from '../../lib/data/idb';
  import type { CasoCMS } from '../../lib/domain/types';

  function isPublicPage(): boolean {
    const p = window.location.pathname;
    return p === '/' || p.endsWith('/index.html') || p === '';
  }

  function redirectLogin() {
    sessionStorage.removeItem('fcco_auth_active');
    sessionStorage.removeItem('fcco_auth_user');
    if (!isPublicPage()) {
      window.location.replace('/?msg=sesion_requerida');
    }
  }

  function revealContent() {
    const cloak = document.getElementById('fcco-auth-cloak');
    if (cloak) cloak.remove();
    document.documentElement.classList.remove('fcco-auth-loading');
  }

  async function checkSessionAndSync() {
    if (isPublicPage()) {
      return;
    }

    // 1. Verificación instantánea en almacenamiento de sesión
    const localActive = sessionStorage.getItem('fcco_auth_active');
    if (localActive !== '1') {
      redirectLogin();
      return;
    }

    try {
      // 2. Limpieza de datos mock legacy en IndexedDB
      const locales = await idbGetAll<CasoCMS>('casos');
      for (const c of locales) {
        if (c.id && c.id.startsWith('caso-mock-')) {
          await idbDelete('casos', c.id);
        }
      }

      // 3. Comprobar sesión autoritativa en API PHP
      const authRes = await phpApi.checkAuth();
      const isAuth = authRes.ok && authRes.data?.authenticated === true && !!authRes.data?.user;

      if (!isAuth) {
        // Si el backend no confirma autenticación, denegar inmediatamente
        redirectLogin();
        return;
      }

      // 4. Usuario autenticado y confirmado: revelar contenido y actualizar UI
      sessionStorage.setItem('fcco_auth_active', '1');
      if (authRes.data?.user) {
        sessionStorage.setItem('fcco_auth_user', JSON.stringify(authRes.data.user));
        const u = authRes.data.user;
        const fullName = [u.nombre, u.apellido].filter(Boolean).join(' ') || u.email;
        const peritoStr = `Perito: ${fullName} (FCCO)`;

        const userEls = document.querySelectorAll('#user-name, #user-name-sidebar');
        userEls.forEach((el) => {
          el.textContent = peritoStr;
        });

        if (u.civ) {
          const civEls = document.querySelectorAll('#user-civ-badge, #user-civ-badge-sidebar');
          civEls.forEach((el) => {
            el.textContent = String(u.civ);
          });
        }
      }

      revealContent();

      // 5. Sincronizar catálogo de casos en segundo plano
      await phpApi.listarCasos();
    } catch (e) {
      console.warn('FCCO AuthGuard: Verificación de sesión offline:', e);
      // En modo offline estricto: si no hay sesión activa local confirmada, expulsar
      if (sessionStorage.getItem('fcco_auth_active') !== '1') {
        redirectLogin();
      } else {
        revealContent();
      }
    }
  }

  // Vincular botones de cerrar sesión
  function bindLogout() {
    const btns = document.querySelectorAll('#btn-logout, #btn-logout-sidebar, .btn-logout');
    btns.forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        sessionStorage.removeItem('fcco_auth_active');
        sessionStorage.removeItem('fcco_auth_user');
        try {
          await phpApi.logout();
        } catch {
          // continuar con redirección
        }
        window.location.replace('/?msg=sesion_cerrada');
      });
    });
  }

  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        checkSessionAndSync();
        bindLogout();
      });
    } else {
      checkSessionAndSync();
      bindLogout();
    }
  }
</script>
