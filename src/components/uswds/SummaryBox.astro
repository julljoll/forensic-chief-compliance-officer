---
/**
 * SHA256.US — USWDS Summary Box
 * Fuente: https://designsystem.digital.gov/components/summary-box/
 */
interface Props {
  heading?: string;
  headingId?: string;
  className?: string;
}

const {
  heading = 'Marco Normativo y Requisitos Obligatorios',
  headingId = 'summary-box-key-information',
  className = '',
} = Astro.props;
---

<!-- USWDS: Summary box | https://designsystem.digital.gov/components/summary-box/ -->
<div class={`usa-summary-box ${className}`.trim()} role="region" aria-labelledby={headingId}>
  <div class="usa-summary-box__body">
    <h3 class="usa-summary-box__heading" id={headingId}>
      {heading}
    </h3>
    <div class="usa-summary-box__text">
      <slot />
    </div>
  </div>
</div>

