---
/**
 * SHA256.US — Indicador de Estado Semántico USWDS (Componente Nativo Astro)
 */
interface Props {
  status?: 'online' | 'offline' | 'busy' | 'away' | null;
  label?: string;
  size?: number;
}

const { status = 'online', label, size = 8 } = Astro.props;

const colorClass =
  status === 'online'
    ? 'bg-success'
    : status === 'offline'
      ? 'bg-error'
      : status === 'busy'
        ? 'bg-warning'
        : 'bg-base';

const labelText =
  label ||
  (status === 'online'
    ? 'Activo'
    : status === 'offline'
      ? 'Sin conexión'
      : status === 'busy'
        ? 'En proceso'
        : 'En espera');
---
<span class="display-inline-flex flex-align-center">
  <span
    class={`usa-status-dot display-inline-block radius-pill ${colorClass}`}
    style={`width: ${size}px; height: ${size}px;`}
    aria-hidden="true"
  ></span>
  <span class="usa-sr-only">{status || 'unknown'}</span>
  {label && <span class="margin-left-05 font-sans-3xs text-ink">{labelText}</span>}
</span>
