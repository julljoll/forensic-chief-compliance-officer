---
/**
 * SHA256.US — USWDS Official Icon Component (@uswds/uswds)
 * Fuente: https://designsystem.digital.gov/components/icon/
 */
interface Props {
  name: string;
  size?: '3' | '4' | '5' | '6' | '7' | '8' | '9';
  className?: string;
  ariaLabel?: string;
  ariaHidden?: boolean;
}

const {
  name,
  size,
  className = '',
  ariaLabel,
  ariaHidden = true,
} = Astro.props;

const sizeClass = size ? `usa-icon--size-${size}` : '';
---

<!-- USWDS: Icon | https://designsystem.digital.gov/components/icon/ -->
<svg
  class={`usa-icon ${sizeClass} ${className}`.trim()}
  aria-hidden={ariaHidden ? 'true' : 'false'}
  aria-label={ariaLabel}
  focusable="false"
  role="img"
>
  <use href={`/assets/uswds/img/sprite.svg#${name}`}></use>
</svg>

