---
/**
 * SHA256.US — USWDS Alert Component
 * Fuente: https://designsystem.digital.gov/components/alert/
 */
interface Props {
  type?: 'info' | 'warning' | 'success' | 'error';
  heading?: string;
  slim?: boolean;
  noIcon?: boolean;
  id?: string;
  className?: string;
}

const { type = 'info', heading, slim = false, noIcon = false, id, className = '' } = Astro.props;
const typeClass = `usa-alert--${type}`;
const slimClass = slim ? 'usa-alert--slim' : '';
const noIconClass = noIcon ? 'usa-alert--no-icon' : '';
const headingId = heading && id ? `${id}-heading` : undefined;
---

<!-- USWDS: Alert | https://designsystem.digital.gov/components/alert/ -->
<div
  id={id}
  class={`usa-alert ${typeClass} ${slimClass} ${noIconClass} ${className}`.trim()}
  role={type === 'error' ? 'alert' : 'region'}
  aria-labelledby={headingId}
>
  <div class="usa-alert__body">
    {heading && <h4 class="usa-alert__heading" id={headingId}>{heading}</h4>}
    <div class="usa-alert__text">
      <slot />
    </div>
  </div>
</div>

