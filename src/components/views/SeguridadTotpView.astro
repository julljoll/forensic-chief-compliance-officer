---
/**
 * SHA256.US — Vista de Seguridad de Acceso (Código OTP 6 Dígitos + Enlace Mágico por Correo)
 * Cumplimiento: NIST SP 800-63B · OWASP ASVS v4.0.3 · ISO/IEC 27001 A.9.4.2
 */
import PageHeader from '../uswds/PageHeader.astro';
import SummaryBox from '../uswds/SummaryBox.astro';
import Icon from '../uswds/Icon.astro';
---

<PageHeader
  title="Seguridad de Acceso sin Contraseña (OTP por Correo y Enlace Mágico)"
  subtitle="Autenticación simplificada de un solo uso para los 2 peritos autorizados en lista blanca, con protección fail-closed y auditoría inmutable SHA-256."
  tag="SIN CONTRASEÑAS · OTP 6 DÍGITOS"
  tagColor="bg-primary-darker"
/>

<!-- 1. Resumen del Estado de Seguridad Actual -->
<div class="margin-bottom-3">
  <SummaryBox heading="Estado de Cuenta Autorizada y Canal de Correo (Autoritativo desde MySQL)" headingId="summary-seguridad-otp">
    <div class="grid-row grid-gap flex-align-start">
      <div class="tablet:grid-col-8">
        <div class="display-flex flex-wrap flex-align-center margin-bottom-105">
          <span class="usa-tag bg-success-dark text-white font-mono-3xs margin-right-1 margin-bottom-05">
            LISTA BLANCA: 2 PERITOS
          </span>
          <span id="badge-metodo-auth" class="usa-tag bg-primary-darker text-white font-mono-3xs margin-right-1 margin-bottom-05">
            OTP 6 DÍGITOS + ENLACE MÁGICO
          </span>
          <span class="usa-tag bg-base-lighter text-ink font-mono-3xs margin-bottom-05">
            CONTRASEÑA LOCAL: DESHABILITADA
          </span>
        </div>

        <dl class="grid-row grid-gap-1 margin-y-1 font-body-2xs">
          <div class="tablet:grid-col-6 margin-bottom-1">
            <dt class="text-bold text-base-dark font-sans-3xs text-uppercase">Correo Autorizado</dt>
            <dd id="seg-user-email" class="margin-0 font-mono-xs text-ink text-bold">Cargando...</dd>
          </div>
          <div class="tablet:grid-col-6 margin-bottom-1">
            <dt class="text-bold text-base-dark font-sans-3xs text-uppercase">Canal de Envío en cPanel</dt>
            <dd id="seg-mail-driver" class="margin-0 font-mono-xs text-ink">---</dd>
          </div>
          <div class="tablet:grid-col-6 margin-bottom-1">
            <dt class="text-bold text-base-dark font-sans-3xs text-uppercase">Último Acceso Verificado</dt>
            <dd id="seg-last-login" class="margin-0 font-mono-xs text-ink">---</dd>
          </div>
          <div class="tablet:grid-col-6 margin-bottom-1">
            <dt class="text-bold text-base-dark font-sans-3xs text-uppercase">Expiración de Sesión</dt>
            <dd class="margin-0 font-mono-xs text-ink">30 min inactividad · 8 h absolutas</dd>
          </div>
        </dl>
      </div>

      <div class="tablet:grid-col-4 text-right margin-top-2 tablet:margin-top-0">
        <button
          id="btn-enviar-correo-prueba"
          type="button"
          class="usa-button usa-button--outline font-sans-2xs padding-x-2 padding-y-1 display-inline-flex flex-align-center"
        >
          <Icon name="mail" className="margin-right-05" />
          <span>Probar Entrega de Correo</span>
        </button>
      </div>
    </div>
  </SummaryBox>
</div>

<!-- Alerta de resultado de prueba de correo -->
<div id="seg-global-alert" class="margin-bottom-3" hidden></div>

<!-- 2. Controles de Seguridad Activos -->
<div class="usa-card width-full">
  <div class="usa-card__container padding-3">
    <h2 class="font-heading-lg margin-top-0 margin-bottom-2">
      Controles de Seguridad Forense Activos
    </h2>
    <div class="grid-row grid-gap">
      <div class="tablet:grid-col-4 margin-bottom-2">
        <div class="bg-base-lightest padding-2 border-1px border-base-lighter radius-md height-full">
          <h3 class="font-heading-xs margin-top-0 margin-bottom-1 text-primary">
            1. Códigos Efímeros (5 min · Uso Único)
          </h3>
          <p class="font-body-3xs text-base-dark margin-0">
            Cada código de 6 dígitos y enlace mágico se almacena únicamente como hash SHA-256, caduca en 5 minutos, se invalida tras 5 intentos erróneos y se consume atómicamente al primer uso.
          </p>
        </div>
      </div>
      <div class="tablet:grid-col-4 margin-bottom-2">
        <div class="bg-base-lightest padding-2 border-1px border-base-lighter radius-md height-full">
          <h3 class="font-heading-xs margin-top-0 margin-bottom-1 text-primary">
            2. Lista Blanca + Anti Fuerza Bruta
          </h3>
          <p class="font-body-3xs text-base-dark margin-0">
            Solo los 2 correos autorizados pueden solicitar códigos. Bloqueo HTTP 429 automático (5 fallos / 15 min), enfriamiento de 45 s entre reenvíos y contraseñas locales bloqueadas.
          </p>
        </div>
      </div>
      <div class="tablet:grid-col-4 margin-bottom-2">
        <div class="bg-base-lightest padding-2 border-1px border-base-lighter radius-md height-full">
          <h3 class="font-heading-xs margin-top-0 margin-bottom-1 text-primary">
            3. Sesión Fail-Closed + CSRF + SHA-256
          </h3>
          <p class="font-body-3xs text-base-dark margin-0">
            Gatekeeper PHP + AuthGuard fail-closed, cookie HttpOnly/SameSite=Lax, cabecera X-CSRF-Token en toda mutación y registro inmutable en la tabla de auditoría SHA-256.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { phpApi } from '../../lib/data/phpApi';

  const segUserEmail = document.getElementById('seg-user-email');
  const segMailDriver = document.getElementById('seg-mail-driver');
  const segLastLogin = document.getElementById('seg-last-login');
  const btnTestEmail = document.getElementById('btn-enviar-correo-prueba') as HTMLButtonElement | null;
  const globalAlert = document.getElementById('seg-global-alert');

  function showGlobalAlert(msg: string, variant: 'success' | 'error' | 'info' = 'info') {
    if (!globalAlert) return;
    globalAlert.hidden = false;
    globalAlert.innerHTML = `
      <div class="usa-alert usa-alert--${variant} usa-alert--slim" role="status">
        <div class="usa-alert__body">
          <p class="usa-alert__text font-sans-2xs">${msg}</p>
        </div>
      </div>
    `;
  }

  async function initSeguridad() {
    const authRes = await phpApi.checkAuth();
    if (authRes.status === 200 && authRes.ok && authRes.data?.user) {
      const u = authRes.data.user;
      if (segUserEmail) segUserEmail.textContent = u.email || '---';
      if (segMailDriver) {
        const driver = authRes.data.mail_driver || 'php_mail';
        segMailDriver.textContent = driver === 'smtp'
          ? 'SMTP Autenticado TLS/SSL (config.local.php)'
          : 'Correo Nativo de cPanel (PHP mail())';
      }
      if (segLastLogin) {
        segLastLogin.textContent = u.last_login_at
          ? `${u.last_login_at} UTC · IP ${u.last_login_ip || '---'}`
          : 'Sesión actual activa';
      }
    }

    btnTestEmail?.addEventListener('click', async () => {
      if (!btnTestEmail) return;
      btnTestEmail.disabled = true;
      try {
        const res = await phpApi.sendTestEmail();
        if (res.status === 200 && res.ok) {
          showGlobalAlert(res.data?.message || 'Correo de prueba enviado correctamente.', 'success');
        } else {
          showGlobalAlert(res.error || 'No se pudo enviar el correo de prueba.', 'error');
        }
      } finally {
        btnTestEmail.disabled = false;
      }
    });
  }

  if (typeof window !== 'undefined') {
    initSeguridad();
  }
</script>
