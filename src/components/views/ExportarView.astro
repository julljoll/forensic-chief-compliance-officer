---
/**
 * SHA256.US — Vista Hub de Exportación y Empaquetado de Expedientes Forenses
 * Incluye las 13 Planillas Oficiales en Folio (FO-F0-01 a FO-F5-13) y manifiesto
 * verificado contra RAG/Informacion_docling_rag/Informatica.
 */
import PageHeader from '../uswds/PageHeader.astro';
import SummaryBox from '../uswds/SummaryBox.astro';

const ITEMS_EXPORT = [
  { id: 'acta_consentimiento', codigo: 'FO-F0-01', fase: 'F0', titulo: 'Acta de Consentimiento Informado', desc: 'Hábeas Data y exclusión de antijuridicidad (LEDCI Arts. 20–21).' },
  { id: 'acta_entrevista', codigo: 'FO-F0-02', fase: 'F0', titulo: 'Acta de Entrevista Forense', desc: 'Contexto, pruebas a validar y credenciales (MUCC-2017).' },
  { id: 'acta_obtencion', codigo: 'FO-F1-03', fase: 'F1', titulo: 'Acta de Obtención y Preservación', desc: 'Fijación 360°, Faraday y precintado (ISO/IEC 27037 §5.4.2–5.4.3).' },
  { id: 'prcc', codigo: 'FO-F1-04', fase: 'F1', titulo: 'Planilla de Registro de Cadena de Custodia (PRCC)', desc: 'Obligatoria conforme al COPP Art. 187 y MUCC-2017.' },
  { id: 'acta_desprecintado', codigo: 'FO-F2-05', fase: 'F2', titulo: 'Acta de Desprecintado en Laboratorio', desc: 'Adquisición verificada con Hash SHA-256 (ISO/IEC 27037 §5.4.4).' },
  { id: 'informe_audio_sonic', codigo: 'FO-F3-06', fase: 'F3', titulo: 'Planilla de Análisis Forense de Audio', desc: 'Espectrograma FFT, formantes y continuidad (ISO/IEC 27042).' },
  { id: 'planilla_evaluacion_ux', codigo: 'FO-F3-07', fase: 'F3', titulo: 'Planilla de Evaluación de Interfaz UX', desc: 'Cotejo de capturas e interfaz vs registros SQLite (LMDFE Art. 4).' },
  { id: 'acta_dictamen', codigo: 'FO-F4-08', fase: 'F4', titulo: 'Dictamen Pericial Oficial Colegiado', desc: 'Informe motivado con doble firma pericial (COPP Arts. 223–225).' },
  { id: 'dictamen_imagenes', codigo: 'FO-F4-09', fase: 'F4', titulo: 'Dictamen Especializado de Imágenes', desc: 'Análisis EXIF, ELA e integridad de píxeles (ISO/IEC 27042).' },
  { id: 'dictamen_audios', codigo: 'FO-F4-10', fase: 'F4', titulo: 'Dictamen Especializado de Audios', desc: 'Autenticidad de nota de voz o grabación (LMDFE Art. 7).' },
  { id: 'acta_entrega_resultados', codigo: 'FO-F5-11', fase: 'F5', titulo: 'Acta de Disposición Final y Devolución', desc: 'Cierre de custodia y entrega formal (MUCC-2017).' },
  { id: 'acta_sanitizacion', codigo: 'FO-F5-12', fase: 'F5', titulo: 'Acta de Sanitización Criptográfica', desc: 'Supresión segura de copias temporales (ISO/IEC 27002 A.8.10).' },
  { id: 'acta_auditoria_timeline', codigo: 'FO-F5-13', fase: 'F5', titulo: 'Acta de Auditoría y Trazabilidad SHA-256', desc: 'Cadena de hashes concatenados (RFC 8785 · UNE 71505).' },
  { id: 'manifest_sha256', codigo: 'MANIFEST', fase: 'RAG', titulo: 'Manifiesto Criptográfico y Fuentes RAG Informática', desc: 'Árbol SHA-256 y referencias verificadas en RAG/Informacion_docling_rag/Informatica.' },
];
---

<PageHeader
  title="Exportación y Empaquetado Oficial del Expediente"
  subtitle="Generación de entregables judiciales en formato comprimido (.ZIP) con las 13 planillas Folio y manifiesto SHA-256."
  tag="Paquete Judicial ZIP"
  tagColor="bg-primary-darker"
>
  <div slot="actions">
    <a href="/planillas" class="usa-button usa-button--outline font-sans-xs padding-x-2 padding-y-1">
      Catálogo de Planillas (13)
    </a>
  </div>
</PageHeader>

<!-- Selector de Expediente -->
<div class="usa-summary-box margin-bottom-205" role="region" aria-labelledby="exportar-caso-titulo">
  <div class="usa-summary-box__body">
    <div class="grid-row grid-gap flex-align-center flex-justify">
      <div class="tablet:grid-col-7">
        <span class="font-sans-3xs text-bold text-base-dark text-uppercase">Expediente Activo para Exportación:</span>
        <h2 class="usa-summary-box__heading margin-top-05 margin-bottom-05" id="exportar-caso-titulo">
          Consultando base de datos MySQL...
        </h2>
        <div class="font-body-2xs text-base-dark">
          Consignante: <strong id="exportar-caso-consignante">—</strong> · Perito: <strong id="exportar-caso-perito">—</strong>
        </div>
      </div>

      <div class="tablet:grid-col-5">
        <div class="usa-form-group margin-top-0">
          <label class="usa-label margin-top-0" for="select-exportar-caso">
            Seleccionar Expediente
          </label>
          <select class="usa-select" id="select-exportar-caso">
            <option value="">Consultando base de datos MySQL...</option>
          </select>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Resumen Compacto -->
<div class="margin-bottom-205">
  <SummaryBox heading="Paquete Forense Digital Sellado (13 Planillas Folio + Manifiesto RAG Informática)" headingId="summary-paquete-forense">
    <p class="margin-top-0 margin-bottom-1 font-body-2xs">
      El archivo ZIP exportado incluye los instrumentos seleccionados en formato Folio, el JSON canónico (RFC 8785) y el manifiesto de fuentes verificadas en <code>RAG/Informacion_docling_rag/Informatica</code>.
    </p>
    <div class="display-flex flex-wrap">
      <span class="usa-tag bg-primary-darker margin-right-1 margin-bottom-05">13 PLANILLAS FOLIO (216×330mm)</span>
      <span class="usa-tag bg-primary margin-right-1 margin-bottom-05">CANONICAL JSON (RFC 8785)</span>
      <span class="usa-tag bg-green margin-bottom-05">RAG INFORMATICA VERIFIED</span>
    </div>
  </SummaryBox>
</div>

<!-- Selección de las 13 Planillas y Manifiesto -->
<div class="usa-card width-full margin-bottom-3">
  <div class="usa-card__container padding-3">
    <fieldset class="usa-fieldset">
      <legend class="usa-legend font-heading-md text-bold margin-bottom-2">
        Seleccione los Documentos y Entregables a Incluir (13 Planillas Oficiales + Manifiesto)
      </legend>

      <div class="grid-row grid-gap-1">
        {ITEMS_EXPORT.map((item) => (
          <div class="tablet:grid-col-6 margin-bottom-105">
            <div class="usa-checkbox">
              <input
                class="usa-checkbox__input usa-checkbox__input--tile chk-export-item"
                id={`chk-exp-${item.id}`}
                type="checkbox"
                name="export-items"
                value={item.id}
                checked
              />
              <label class="usa-checkbox__label font-body-2xs" for={`chk-exp-${item.id}`}>
                <span class="usa-tag bg-primary-darker text-white font-mono-3xs margin-right-05">{item.codigo}</span>
                <strong>{item.titulo}</strong>
                <span class="usa-checkbox__label-description font-body-3xs">{item.desc}</span>
              </label>
            </div>
          </div>
        ))}
      </div>
    </fieldset>

    <!-- Botón de Descarga -->
    <div class="border-top-1px border-base-lighter padding-top-2 display-flex flex-justify-end">
      <button
        id="btn-generar-zip"
        type="button"
        class="usa-button font-sans-xs padding-x-2 padding-y-1 width-full tablet:width-auto text-center"
      >
        <svg class="usa-icon margin-right-05" aria-hidden="true" focusable="false" role="img">
          <use href="/assets/uswds/img/sprite.svg#file_download"></use>
        </svg>
        <span>Generar y Descargar Paquete ZIP Forense</span>
      </button>
    </div>
  </div>
</div>

<script>
  import JSZip from 'jszip';
  import saveAs from 'file-saver';
  import { idbGetAll } from '../../lib/data/idb';
  import { phpApi } from '../../lib/data/phpApi';
  import { canonicalJson, sha256Hex } from '../../lib/crypto/canonical';
  import { RAG_INFORMATICA_CATALOG, RAG_INFORMATICA_BASE_DIR } from '../../data/ragInformaticaCatalog';
  import type { CasoCMS } from '../../lib/domain/types';

  const select = document.getElementById('select-exportar-caso') as HTMLSelectElement;
  const btnZip = document.getElementById('btn-generar-zip');
  const tit = document.getElementById('exportar-caso-titulo');
  const cons = document.getElementById('exportar-caso-consignante');
  const per = document.getElementById('exportar-caso-perito');

  let casosMemoria: CasoCMS[] = [];
  let casoSeleccionado: CasoCMS | null = null;

  async function initExportar() {
    try {
      casosMemoria = await phpApi.listarCasos();
    } catch {
      casosMemoria = await idbGetAll<CasoCMS>('casos');
    }

    casosMemoria = (casosMemoria || []).filter((c) => !c.id.startsWith('caso-mock-'));

    if (select) {
      select.innerHTML = '';
      if (casosMemoria.length === 0) {
        select.innerHTML = '<option value="">Sin casos sincronizados en MySQL</option>';
        if (tit) tit.textContent = 'Sin expedientes disponibles para empaquetado';
        if (cons) cons.textContent = '—';
        if (per) per.textContent = '—';
        if (btnZip) (btnZip as HTMLButtonElement).disabled = true;
        return;
      }

      casosMemoria.forEach((c) => {
        const opt = document.createElement('option');
        opt.value = c.id;
        opt.textContent = `${c.numeroCaso} (${c.evidenciaMarca} ${c.evidenciaModelo})`;
        select.appendChild(opt);
      });

      const params = new URLSearchParams(window.location.search);
      const paramId = params.get('casoId');
      if (paramId && casosMemoria.some((x) => x.id === paramId)) {
        select.value = paramId;
      } else if (casosMemoria.length > 0) {
        select.value = casosMemoria[0].id;
      }

      actualizarVista(select.value);

      select.addEventListener('change', () => {
        actualizarVista(select.value);
      });
    }
  }

  function actualizarVista(id: string) {
    const c = casosMemoria.find((x) => x.id === id);
    if (!c) return;
    casoSeleccionado = c;

    if (tit) tit.textContent = `${c.numeroCaso} — ${c.titulo}`;
    if (cons) cons.textContent = c.consignanteNombre || 'Consignante';
    if (per) per.textContent = c.peritoLiderNombre || 'Jull Joll';
  }

  if (btnZip) {
    btnZip.addEventListener('click', async () => {
      if (!casoSeleccionado) return;

      const btn = btnZip as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Empaquetando y Calculando Hashes...';

      try {
        const zip = new JSZip();
        const baseFolder = zip.folder(`EXPEDIENTE_${casoSeleccionado.numeroCaso.replace(/[^a-zA-Z0-9_-]/g, '_')}`);

        const jsonCanonica = canonicalJson(casoSeleccionado as any);
        const hashCaso = await sha256Hex(jsonCanonica);
        baseFolder?.file('metadatos_caso_rfc8785.json', jsonCanonica);

        const fuentesRag = RAG_INFORMATICA_CATALOG.map(
          (d) => `- [${d.codigo}] ${d.archivoRag} (SHA-256 PDF: ${d.hashPdfSha256})`
        ).join('\n');

        const reporteManifest = [
          '========================================================================',
          '               SHA256.US — REPORTE DE INTEGRIDAD CRIPTOGRÁFICA',
          '========================================================================',
          `N° EXPEDIENTE: ${casoSeleccionado.numeroCaso}`,
          `EXPEDIENTE JUDICIAL: ${casoSeleccionado.expediente}`,
          `TIPOLOGÍA FORENSE: ${casoSeleccionado.tipoProyecto}`,
          `CONSIGNANTE: ${casoSeleccionado.consignanteNombre} (C.I. ${casoSeleccionado.consignanteCedula})`,
          `PERITO LÍDER: ${casoSeleccionado.peritoLiderNombre || 'Jull Joll'}`,
          `FECHA DE EXPORTACIÓN: ${new Date().toISOString()}`,
          `FUENTE ÚNICA RAG: ${RAG_INFORMATICA_BASE_DIR}`,
          '------------------------------------------------------------------------',
          `HASH CANÓNICO SHA-256 DEL CASO: ${hashCaso}`,
          'ESTADO DE LA CADENA DE CUSTODIA: ÍNTEGRA Y CONFORME',
          '------------------------------------------------------------------------',
          'INSTRUMENTOS VERIFICADOS EN RAG/Informacion_docling_rag/Informatica:',
          fuentesRag,
          '========================================================================',
        ].join('\n');
        baseFolder?.file('MANIFIESTO_SHA256.txt', reporteManifest);

        const content = await zip.generateAsync({ type: 'blob' });
        saveAs(content, `EXPEDIENTE_${casoSeleccionado.numeroCaso}.zip`);

        alert(`Paquete forense de ${casoSeleccionado.numeroCaso} descargado con éxito.`);
      } catch (err) {
        console.error('Error generando ZIP:', err);
        alert('Error al generar el archivo comprimido.');
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<svg class="usa-icon margin-right-05" aria-hidden="true" focusable="false" role="img"><use href="/assets/uswds/img/sprite.svg#file_download"></use></svg> <span>Generar y Descargar Paquete ZIP Forense</span>';
      }
    });
  }

  if (typeof window !== 'undefined') {
    initExportar();
  }
</script>
