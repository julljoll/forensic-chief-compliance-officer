---
/**
 * SHA256.US — Vista Base Normativa Forense RAG
 * Fuente Única de Verdad Verificada: RAG/Informacion_docling_rag/Informatica
 */
import PageHeader from '../uswds/PageHeader.astro';
import Accordion from '../uswds/Accordion.astro';
import RagSourceBadge from '../uswds/RagSourceBadge.astro';
import { RAG_INFORMATICA_CATALOG, RAG_INFORMATICA_BASE_DIR } from '../../data/ragInformaticaCatalog';
---

<PageHeader
  title="Base de Conocimiento Normativo RAG (Informática Forense)"
  subtitle={`Fuente única e inmutable del CMS: ${RAG_INFORMATICA_BASE_DIR} (${RAG_INFORMATICA_CATALOG.length} instrumentos verificados con SHA-256 Docling).`}
  tag="Fuente Única RAG"
  tagColor="bg-primary-darker"
>
  <div slot="actions">
    <a href="/flujo" class="usa-button usa-button--outline font-sans-xs padding-x-2 padding-y-1">
      Ir al Ciclo Pericial ISO →
    </a>
  </div>
</PageHeader>

<!-- Resumen de Jerarquía Normativa en Acordeón USWDS (Cero sobrecarga visual) -->
<div class="margin-bottom-205">
  <Accordion
    id="piramide-normativa-rag"
    title="Ver Jerarquía de Aplicación y Trazabilidad Documental (RAG/Informacion_docling_rag/Informatica)"
    expanded={false}
  >
    <p class="margin-top-0 margin-bottom-1 font-body-2xs">
      Todos los controles del flujo pericial ISO (F0–F5) y las 13 planillas oficiales en Folio se alimentan exclusivamente de los documentos procesados con IBM Docling en <code>{RAG_INFORMATICA_BASE_DIR}</code>:
    </p>
    <div class="display-flex flex-wrap">
      <span class="usa-tag bg-primary-darker margin-right-1 margin-bottom-05 font-mono-3xs">1. CRBV G.O. 36.860 / LEDCI G.O. 37.313 / LPPC G.O. 34.863</span>
      <span class="usa-tag bg-primary-darker margin-right-1 margin-bottom-05 font-mono-3xs">2. MUCC-2017 (G.O. 41.247) · COPP Arts. 187, 223–225</span>
      <span class="usa-tag bg-primary margin-right-1 margin-bottom-05 font-mono-3xs">3. LMDFE (G.O. 37.148) · CENIF (G.O. 39.847) · SUSCERTE</span>
      <span class="usa-tag bg-accent-warm-dark text-ink text-bold margin-right-1 margin-bottom-05 font-mono-3xs">4. ISO/IEC 27037 / 27042 / 27001 / 27002 · UNE 71505 / 197010</span>
      <span class="usa-tag bg-green margin-bottom-05 font-mono-3xs">5. NIST SP 800-101 / 800-86 · ACPO v5 · RFC 3227</span>
    </div>
  </Accordion>
</div>

<!-- Buscador y Filtros USWDS -->
<div class="usa-card width-full margin-bottom-3">
  <div class="usa-card__container padding-2">
    <div class="grid-row grid-gap flex-align-end margin-bottom-2">
      <div class="tablet:grid-col-6">
        <div class="usa-form-group margin-top-0">
          <label class="usa-label margin-top-0 font-sans-2xs text-bold" for="input-search-normas">
            Buscar en <code>{RAG_INFORMATICA_BASE_DIR}</code>
          </label>
          <input
            class="usa-input"
            id="input-search-normas"
            type="search"
            placeholder="Buscar por código, ley, estándar, Gaceta o hash SHA-256..."
          />
        </div>
      </div>
      <div class="tablet:grid-col-6 margin-top-2 tablet:margin-top-0">
        <label class="usa-label margin-top-0 font-sans-2xs text-bold margin-bottom-05">Filtrar por Tipo de Instrumento:</label>
        <ul class="usa-button-group flex-wrap" id="filtros-tipo-norma">
          <li class="usa-button-group__item">
            <button type="button" class="usa-button font-sans-3xs padding-x-1 padding-y-05 btn-filtro-norma" data-tipo="todos">
              Todas ({RAG_INFORMATICA_CATALOG.length})
            </button>
          </li>
          <li class="usa-button-group__item">
            <button type="button" class="usa-button usa-button--outline font-sans-3xs padding-x-1 padding-y-05 btn-filtro-norma" data-tipo="ISO">
              ISO/IEC
            </button>
          </li>
          <li class="usa-button-group__item">
            <button type="button" class="usa-button usa-button--outline font-sans-3xs padding-x-1 padding-y-05 btn-filtro-norma" data-tipo="NIST">
              NIST
            </button>
          </li>
          <li class="usa-button-group__item">
            <button type="button" class="usa-button usa-button--outline font-sans-3xs padding-x-1 padding-y-05 btn-filtro-norma" data-tipo="LEY">
              Leyes VE
            </button>
          </li>
          <li class="usa-button-group__item">
            <button type="button" class="usa-button usa-button--outline font-sans-3xs padding-x-1 padding-y-05 btn-filtro-norma" data-tipo="MANUAL">
              Manuales
            </button>
          </li>
          <li class="usa-button-group__item">
            <button type="button" class="usa-button usa-button--outline font-sans-3xs padding-x-1 padding-y-05 btn-filtro-norma" data-tipo="REGLAMENTO">
              Reglamentos
            </button>
          </li>
        </ul>
      </div>
    </div>

    <!-- Filtro Segmentado por Fase ISO F0..F5 -->
    <div class="border-top-1px border-base-lighter padding-top-105">
      <label class="usa-label margin-top-0 font-sans-2xs text-bold margin-bottom-05">Filtrar por Fase del Ciclo Pericial:</label>
      <div class="usa-button-group usa-button-group--segmented overflow-x-auto flex-nowrap" id="filtros-fase-norma">
        <button type="button" class="usa-button font-sans-3xs padding-x-1 padding-y-05 btn-filtro-fase-norma" data-fase="todas">
          Todas las Fases
        </button>
        <button type="button" class="usa-button usa-button--outline font-sans-3xs padding-x-1 padding-y-05 btn-filtro-fase-norma" data-fase="F0">
          F0: Apertura
        </button>
        <button type="button" class="usa-button usa-button--outline font-sans-3xs padding-x-1 padding-y-05 btn-filtro-fase-norma" data-fase="F1">
          F1: Recolección
        </button>
        <button type="button" class="usa-button usa-button--outline font-sans-3xs padding-x-1 padding-y-05 btn-filtro-fase-norma" data-fase="F2">
          F2: Adquisición
        </button>
        <button type="button" class="usa-button usa-button--outline font-sans-3xs padding-x-1 padding-y-05 btn-filtro-fase-norma" data-fase="F3">
          F3: Análisis
        </button>
        <button type="button" class="usa-button usa-button--outline font-sans-3xs padding-x-1 padding-y-05 btn-filtro-fase-norma" data-fase="F4">
          F4: Dictamen
        </button>
        <button type="button" class="usa-button usa-button--outline font-sans-3xs padding-x-1 padding-y-05 btn-filtro-fase-norma" data-fase="F5">
          F5: Disposición
        </button>
      </div>
    </div>
  </div>
</div>

<!-- USWDS Card Group con Progressive Disclosure para Artículos y Planillas -->
<ul class="usa-card-group" id="contenedor-normas">
  {RAG_INFORMATICA_CATALOG.map((doc) => {
    const fasesStr = doc.fasesIso.join(',');
    return (
      <li class="usa-card tablet:grid-col-6 desktop:grid-col-4 card-norma" data-tipo={doc.tipo} data-fases={fasesStr}>
        <div class="usa-card__container overflow-hidden">
          <div class="usa-card__header">
            <div class="display-flex flex-justify flex-align-center margin-bottom-1">
              <span class="usa-tag font-mono-3xs">{doc.tipo}</span>
              <span class="font-mono-3xs text-base-dark">
                {doc.gacetaOficial ? `G.O. N° ${doc.gacetaOficial}` : `Ed. ${doc.version}`}
              </span>
            </div>
            <h2 class="usa-card__heading font-heading-sm margin-top-0 margin-bottom-05">{doc.codigo}</h2>
            <div class="display-flex flex-wrap gap-1 margin-top-05">
              {doc.fasesIso.map((f) => (
                <span class="usa-tag bg-primary-darker text-white font-mono-3xs">{f}</span>
              ))}
            </div>
          </div>
          <div class="usa-card__body">
            <p class="text-bold margin-top-0 margin-bottom-05 font-body-2xs">
              {doc.nombreOficial}
            </p>
            <p class="font-body-3xs text-base-dark margin-top-0 margin-bottom-105">
              {doc.descripcion}
            </p>

            {doc.articulosClave.length > 0 && (
              <details class="margin-bottom-1 font-body-3xs">
                <summary class="cursor-pointer text-primary text-bold">
                  Ver Artículos y Controles Clave ({doc.articulosClave.length})
                </summary>
                <div class="bg-base-lightest border-1px border-base-lighter padding-1 margin-top-05">
                  <ul class="usa-list margin-top-0 margin-bottom-0 font-body-3xs">
                    {doc.articulosClave.map((art) => (
                      <li>{art}</li>
                    ))}
                  </ul>
                </div>
              </details>
            )}

            {doc.planillasVinculadas.length > 0 && (
              <div class="bg-primary-lightest border-1px border-primary-light padding-1">
                <p class="font-sans-3xs text-bold text-uppercase margin-top-0 margin-bottom-05 text-primary-darker">
                  Planillas Folio Vinculadas:
                </p>
                <div class="display-flex flex-wrap gap-1">
                  {doc.planillasVinculadas.map((pl) => (
                    <a
                      href={`/planillas/${pl.slug}`}
                      class="usa-button usa-button--outline font-mono-3xs padding-x-05 padding-y-0 margin-0 bg-white"
                      title={`Abrir ${pl.codigo}`}
                    >
                      {pl.codigo} ↗
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
          <div class="usa-card__footer border-top-1px border-base-lighter padding-top-1">
            <RagSourceBadge archivoRag={doc.archivoRag} hashPdfSha256={doc.hashPdfSha256} />
          </div>
        </div>
      </li>
    );
  })}
</ul>

<script>
  const searchInput = document.getElementById('input-search-normas') as HTMLInputElement;
  const botonesTipo = document.querySelectorAll('.btn-filtro-norma');
  const botonesFase = document.querySelectorAll('.btn-filtro-fase-norma');
  const cards = document.querySelectorAll('.card-norma');

  let tipoActivo = 'todos';
  let faseActiva = 'todas';

  function filtrarNormas() {
    const q = (searchInput?.value || '').toLowerCase().trim();

    cards.forEach((card) => {
      const tipo = card.getAttribute('data-tipo') || '';
      const fases = (card.getAttribute('data-fases') || '').split(',');
      const text = card.textContent?.toLowerCase() || '';

      const matchTipo = tipoActivo === 'todos' || tipo === tipoActivo;
      const matchFase = faseActiva === 'todas' || fases.includes(faseActiva);
      const matchText = !q || text.includes(q);

      (card as HTMLElement).hidden = !(matchTipo && matchFase && matchText);
    });
  }

  if (searchInput) {
    searchInput.addEventListener('input', filtrarNormas);
  }

  botonesTipo.forEach((btn) => {
    btn.addEventListener('click', () => {
      botonesTipo.forEach((b) => b.classList.add('usa-button--outline'));
      btn.classList.remove('usa-button--outline');
      tipoActivo = btn.getAttribute('data-tipo') || 'todos';
      filtrarNormas();
    });
  });

  botonesFase.forEach((btn) => {
    btn.addEventListener('click', () => {
      botonesFase.forEach((b) => b.classList.add('usa-button--outline'));
      btn.classList.remove('usa-button--outline');
      faseActiva = btn.getAttribute('data-fase') || 'todas';
      filtrarNormas();
    });
  });
</script>
