---
/**
 * SHA256.US — Vista Base Normativa Forense RAG (77 Normas y Estándares)
 * Compendio de directrices ISO/IEC, NIST, MUCC-2017 y legislación procesal penal.
 */
import SummaryBox from '../uswds/SummaryBox.astro';
import { NORMATIVAS_INICIALES } from '../../lib/data/seed';

const NORMA_VINCULACION: Record<string, { fases: string[]; planillas: Array<{ codigo: string; slug: string }> }> = {
  'ISO/IEC 27037:2012': {
    fases: ['F1', 'F2'],
    planillas: [
      { codigo: 'FO-F1-03', slug: 'acta-obtencion' },
      { codigo: 'FO-F1-04', slug: 'planilla-prcc' },
      { codigo: 'FO-F2-05', slug: 'acta-desprecintado' },
    ],
  },
  'ISO/IEC 27042:2015': {
    fases: ['F3', 'F4'],
    planillas: [
      { codigo: 'FO-F3-06', slug: 'planilla-audio-sonic' },
      { codigo: 'FO-F3-07', slug: 'planilla-evaluacion-ux' },
      { codigo: 'FO-F4-08', slug: 'acta-dictamen' },
      { codigo: 'FO-F4-09', slug: 'dictamen-imagenes' },
      { codigo: 'FO-F4-10', slug: 'dictamen-audios' },
    ],
  },
  'NIST SP 800-101 r1': {
    fases: ['F1', 'F2', 'F3'],
    planillas: [
      { codigo: 'FO-F1-03', slug: 'acta-obtencion' },
      { codigo: 'FO-F2-05', slug: 'acta-desprecintado' },
    ],
  },
  'MUCC-2017': {
    fases: ['F0', 'F1', 'F2', 'F5'],
    planillas: [
      { codigo: 'FO-F0-02', slug: 'acta-entrevista' },
      { codigo: 'FO-F1-03', slug: 'acta-obtencion' },
      { codigo: 'FO-F1-04', slug: 'planilla-prcc' },
      { codigo: 'FO-F5-11', slug: 'acta-entrega-resultados' },
    ],
  },
  'ACPO-v5': {
    fases: ['F1', 'F2', 'F3'],
    planillas: [
      { codigo: 'FO-F1-04', slug: 'planilla-prcc' },
      { codigo: 'FO-F2-05', slug: 'acta-desprecintado' },
    ],
  },
  'LEDI-2001': {
    fases: ['F0', 'F4'],
    planillas: [
      { codigo: 'FO-F0-01', slug: 'acta-consentimiento' },
      { codigo: 'FO-F4-08', slug: 'acta-dictamen' },
    ],
  },
  'LMDF-1999': {
    fases: ['F1', 'F3', 'F4', 'F5'],
    planillas: [
      { codigo: 'FO-F1-04', slug: 'planilla-prcc' },
      { codigo: 'FO-F3-06', slug: 'planilla-audio-sonic' },
      { codigo: 'FO-F4-08', slug: 'acta-dictamen' },
      { codigo: 'FO-F4-10', slug: 'dictamen-audios' },
      { codigo: 'FO-F5-13', slug: 'acta-auditoria-timeline' },
    ],
  },
  'COPP': {
    fases: ['F0', 'F1', 'F4', 'F5'],
    planillas: [
      { codigo: 'FO-F0-02', slug: 'acta-entrevista' },
      { codigo: 'FO-F1-03', slug: 'acta-obtencion' },
      { codigo: 'FO-F1-04', slug: 'planilla-prcc' },
      { codigo: 'FO-F4-08', slug: 'acta-dictamen' },
      { codigo: 'FO-F5-11', slug: 'acta-entrega-resultados' },
    ],
  },
  'CENIF-2012': {
    fases: ['F2', 'F4'],
    planillas: [
      { codigo: 'FO-F2-05', slug: 'acta-desprecintado' },
      { codigo: 'FO-F4-08', slug: 'acta-dictamen' },
    ],
  },
  'ISO/IEC 27002:2022': {
    fases: ['F2', 'F5'],
    planillas: [
      { codigo: 'FO-F5-12', slug: 'acta-sanitizacion' },
    ],
  },
  'ISO/IEC 27001:2022': {
    fases: ['F0', 'F5'],
    planillas: [
      { codigo: 'FO-F5-12', slug: 'acta-sanitizacion' },
      { codigo: 'FO-F5-13', slug: 'acta-auditoria-timeline' },
    ],
  },
  'NIST SP 800-86': {
    fases: ['F1', 'F2', 'F3', 'F4'],
    planillas: [
      { codigo: 'FO-F1-03', slug: 'acta-obtencion' },
      { codigo: 'FO-F2-05', slug: 'acta-desprecintado' },
      { codigo: 'FO-F4-08', slug: 'acta-dictamen' },
    ],
  },
};
---

<!-- Encabezado de Página -->
<div class="margin-bottom-3">
  <h1 class="margin-top-0 margin-bottom-1">
    Base de Conocimiento Normativo RAG
  </h1>
  <p class="usa-intro margin-top-0 margin-bottom-0 font-body-sm text-base-dark">
    Compendio legal y técnico internacional que fundamenta los dictámenes periciales y garantiza la licitud probatoria.
  </p>
</div>

<!-- Resumen de Jerarquía Normativa -->
<div class="margin-bottom-3">
  <SummaryBox heading="Pirámide de Aplicación y Supletoriedad (COPP Art. 225)" headingId="summary-piramide-normativa">
    <p class="margin-top-0 margin-bottom-1 font-body-2xs">
      En materia de informática forense, el Código Orgánico Procesal Penal faculta al perito a fundar su metodología
      en las reglas de su ciencia, arte o técnica. La validez probatoria descansa en la aplicación armónica de:
    </p>
    <div class="display-flex flex-wrap">
      <span class="usa-tag bg-primary-darker margin-right-1 margin-bottom-1 font-mono-3xs">1. CRBV Arts. 28 y 60 (Hábeas Data)</span>
      <span class="usa-tag bg-primary-darker margin-right-1 margin-bottom-1 font-mono-3xs">2. COPP Arts. 187, 223–225</span>
      <span class="usa-tag bg-primary margin-right-1 margin-bottom-1 font-mono-3xs">3. MUCC-2017 (Gaceta N° 41.247)</span>
      <span class="usa-tag bg-accent-warm-dark text-ink text-bold margin-right-1 margin-bottom-1 font-mono-3xs">4. ISO/IEC 27037 / 27042 / 27043</span>
      <span class="usa-tag bg-green margin-bottom-1 font-mono-3xs">5. NIST SP 800-86 / 800-88</span>
    </div>
  </SummaryBox>
</div>

<!-- USWDS: Card with Search and Filters | https://designsystem.digital.gov/components/card/ -->
<div class="usa-card width-full margin-bottom-3">
  <div class="usa-card__container padding-2">
    <div class="grid-row grid-gap flex-align-end margin-bottom-2">
      <div class="tablet:grid-col-6">
        <div class="usa-form-group margin-top-0">
          <label class="usa-label margin-top-0 font-sans-2xs text-bold" for="input-search-normas">
            Buscar en compendio normativo
          </label>
          <input
            class="usa-input"
            id="input-search-normas"
            type="search"
            placeholder="Buscar por código, nombre, artículo o palabra clave..."
          />
        </div>
      </div>
      <div class="tablet:grid-col-6 margin-top-2 tablet:margin-top-0">
        <label class="usa-label margin-top-0 font-sans-2xs text-bold margin-bottom-05">Filtrar por Instrumento:</label>
        <ul class="usa-button-group flex-wrap" id="filtros-tipo-norma">
          <li class="usa-button-group__item">
            <button type="button" class="usa-button font-sans-3xs padding-x-1 padding-y-05 btn-filtro-norma" data-tipo="todos">
              Todas ({NORMATIVAS_INICIALES.length})
            </button>
          </li>
          <li class="usa-button-group__item">
            <button type="button" class="usa-button usa-button--outline font-sans-3xs padding-x-1 padding-y-05 btn-filtro-norma" data-tipo="ISO">
              ISO/IEC
            </button>
          </li>
          <li class="usa-button-group__item">
            <button type="button" class="usa-button usa-button--outline font-sans-3xs padding-x-1 padding-y-05 btn-filtro-norma" data-tipo="NIST">
              NIST
            </button>
          </li>
          <li class="usa-button-group__item">
            <button type="button" class="usa-button usa-button--outline font-sans-3xs padding-x-1 padding-y-05 btn-filtro-norma" data-tipo="LEY">
              Leyes
            </button>
          </li>
          <li class="usa-button-group__item">
            <button type="button" class="usa-button usa-button--outline font-sans-3xs padding-x-1 padding-y-05 btn-filtro-norma" data-tipo="MANUAL">
              Manuales
            </button>
          </li>
        </ul>
      </div>
    </div>

    <!-- Filtro Segmentado por Fase ISO F0..F5 -->
    <div class="border-top-1px border-base-lighter padding-top-105">
      <label class="usa-label margin-top-0 font-sans-2xs text-bold margin-bottom-05">Filtrar por Fase del Ciclo Pericial:</label>
      <div class="usa-button-group usa-button-group--segmented overflow-x-auto flex-nowrap" id="filtros-fase-norma">
        <button type="button" class="usa-button font-sans-3xs padding-x-1 padding-y-05 btn-filtro-fase-norma" data-fase="todas">
          Todas las Fases
        </button>
        <button type="button" class="usa-button usa-button--outline font-sans-3xs padding-x-1 padding-y-05 btn-filtro-fase-norma" data-fase="F0">
          F0: Apertura
        </button>
        <button type="button" class="usa-button usa-button--outline font-sans-3xs padding-x-1 padding-y-05 btn-filtro-fase-norma" data-fase="F1">
          F1: Recolección
        </button>
        <button type="button" class="usa-button usa-button--outline font-sans-3xs padding-x-1 padding-y-05 btn-filtro-fase-norma" data-fase="F2">
          F2: Adquisición
        </button>
        <button type="button" class="usa-button usa-button--outline font-sans-3xs padding-x-1 padding-y-05 btn-filtro-fase-norma" data-fase="F3">
          F3: Análisis
        </button>
        <button type="button" class="usa-button usa-button--outline font-sans-3xs padding-x-1 padding-y-05 btn-filtro-fase-norma" data-fase="F4">
          F4: Dictamen
        </button>
        <button type="button" class="usa-button usa-button--outline font-sans-3xs padding-x-1 padding-y-05 btn-filtro-fase-norma" data-fase="F5">
          F5: Disposición
        </button>
      </div>
    </div>
  </div>
</div>

<!-- USWDS: Card Group | https://designsystem.digital.gov/components/card/ -->
<ul class="usa-card-group" id="contenedor-normas">
  {NORMATIVAS_INICIALES.map((norma) => {
    const vinc = NORMA_VINCULACION[norma.codigo] || { fases: [], planillas: [] };
    const fasesStr = vinc.fases.join(',');
    return (
      <li class="usa-card tablet:grid-col-6 desktop:grid-col-4 card-norma" data-tipo={norma.tipo} data-fases={fasesStr}>
        <div class="usa-card__container overflow-hidden">
          <div class="usa-card__header">
            <div class="display-flex flex-justify flex-align-center margin-bottom-1">
              <span class="usa-tag font-mono-3xs">{norma.tipo}</span>
              <span class="font-mono-3xs text-base-dark">Vigencia: {norma.version}</span>
            </div>
            <h2 class="usa-card__heading font-heading-sm margin-top-0 margin-bottom-05">{norma.codigo}</h2>
            {vinc.fases.length > 0 && (
              <div class="display-flex flex-wrap gap-1 margin-top-05">
                {vinc.fases.map((f) => (
                  <span class="usa-tag bg-primary-darker text-white font-mono-3xs">{f}</span>
                ))}
              </div>
            )}
          </div>
          <div class="usa-card__body">
            <p class="text-bold margin-top-0 margin-bottom-1 font-body-2xs">
              {norma.nombre}
            </p>
            <p class="font-body-2xs text-base-dark margin-top-0 margin-bottom-2">
              {norma.descripcion}
            </p>
            {norma.articulos && norma.articulos.length > 0 && (
              <div class="bg-base-lightest border-1px border-base-lighter padding-1 margin-bottom-1">
                <p class="font-sans-3xs text-bold text-uppercase margin-top-0 margin-bottom-05">
                  Artículos y Módulos Clave:
                </p>
                <ul class="usa-list margin-top-0 margin-bottom-0 font-body-3xs">
                  {norma.articulos.map((art) => (
                    <li>{art}</li>
                  ))}
                </ul>
              </div>
            )}
            {vinc.planillas.length > 0 && (
              <div class="bg-primary-lightest border-1px border-primary-light padding-1">
                <p class="font-sans-3xs text-bold text-uppercase margin-top-0 margin-bottom-05 text-primary-darker">
                  Planillas Oficiales que la Implementan:
                </p>
                <div class="display-flex flex-wrap gap-1">
                  {vinc.planillas.map((pl) => (
                    <a
                      href={`/planillas/${pl.slug}`}
                      class="usa-button usa-button--outline font-mono-3xs padding-x-05 padding-y-0 margin-0 bg-white"
                      title={`Abrir ${pl.codigo}`}
                    >
                      {pl.codigo} ↗
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
          <div class="usa-card__footer border-top-1px border-base-lighter padding-top-1">
            <span class="font-mono-3xs text-base-dark">Referencia: {norma.urlReferencia}</span>
          </div>
        </div>
      </li>
    );
  })}
</ul>

<script>
  const searchInput = document.getElementById('input-search-normas') as HTMLInputElement;
  const botonesTipo = document.querySelectorAll('.btn-filtro-norma');
  const botonesFase = document.querySelectorAll('.btn-filtro-fase-norma');
  const cards = document.querySelectorAll('.card-norma');

  let tipoActivo = 'todos';
  let faseActiva = 'todas';

  function filtrarNormas() {
    const q = (searchInput?.value || '').toLowerCase().trim();

    cards.forEach((card) => {
      const tipo = card.getAttribute('data-tipo') || '';
      const fases = (card.getAttribute('data-fases') || '').split(',');
      const text = card.textContent?.toLowerCase() || '';

      const matchTipo = tipoActivo === 'todos' || tipo === tipoActivo;
      const matchFase = faseActiva === 'todas' || fases.includes(faseActiva);
      const matchText = !q || text.includes(q);

      (card as HTMLElement).hidden = !(matchTipo && matchFase && matchText);
    });
  }

  if (searchInput) {
    searchInput.addEventListener('input', filtrarNormas);
  }

  botonesTipo.forEach((btn) => {
    btn.addEventListener('click', () => {
      botonesTipo.forEach((b) => b.classList.add('usa-button--outline'));
      btn.classList.remove('usa-button--outline');
      tipoActivo = btn.getAttribute('data-tipo') || 'todos';
      filtrarNormas();
    });
  });

  botonesFase.forEach((btn) => {
    btn.addEventListener('click', () => {
      botonesFase.forEach((b) => b.classList.add('usa-button--outline'));
      btn.classList.remove('usa-button--outline');
      faseActiva = btn.getAttribute('data-fase') || 'todas';
      filtrarNormas();
    });
  });
</script>

