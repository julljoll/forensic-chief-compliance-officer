    norma: 'COPP Art. 187 · MUCC-2017 §I-V · LMDFE Art. 7',
    descripcion: 'Instrumento matriz de trazabilidad ininterrumpida del dispositivo o soporte consignado y contenedores lógicos derivados.',
    hojas: '2 Hojas Folio',
  },
  {
    codigo: 'FO-F2-05',
    slug: 'acta-desprecintado',
    fase: 'F2',
    titulo: 'Acta de Desprecintado y Adquisición en Laboratorio',
    norma: 'NIST SP 800-101 / 800-86 · ISO/IEC 27037 §5.4.4 / §7.1.3 · COPP 187',
    descripcion: 'Constancia de apertura en laboratorio, extracción lógica móvil o imagen con Write-Blocker, Hash SHA-256 y Nuevo Precinto.',
