    norma: 'MUCC-2017 (G.O. 41.247) · COPP Art. 187 · ISO/IEC 27037 §5.4.2/§5.4.3',
    descripcion: 'Recepción física y técnica del dispositivo móvil o medio digital (CD, disco, reloj, PC, servidor, cámara) con fijación 360°, Faraday y precinto.',
    hojas: '2 Hojas Folio',
  },
  {
