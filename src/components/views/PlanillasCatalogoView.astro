 * Monocromático B&W puro · Encabezado y pie unificados · Modo Plantilla en Blanco para llenado manual.
 */
import PageHeader from '../uswds/PageHeader.astro';
import Alert from '../uswds/Alert.astro';
import EmitirPdfAdobeModal from '../planillas/EmitirPdfAdobeModal.astro';

const PLANILLAS = [
