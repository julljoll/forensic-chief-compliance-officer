---

<PageHeader
  title="Catálogo de Planillas Oficiales en Folio (216mm × 330mm)"
  subtitle="13 instrumentos periciales con aspecto judicial federal americano, membrete oficial, celdas limpias sin líneas internas, dactiloscopía bilateral y cierre formal."
  tag="13 Planillas Folio"
  tagColor="bg-primary-darker"
>
  <div slot="actions">
    <span class="usa-tag bg-primary-darker text-white font-mono-3xs padding-x-105 padding-y-1">
      FORMATO OFICIAL EN BLANCO (LLENADO A MANO)
    </span>
  </div>
</PageHeader>

<!-- Alerta de Especificaciones de Impresión Folio -->
<div class="margin-bottom-3">
  <Alert type="info" heading="Procedimiento de Análisis por Consignación (NIST SP 800-101 / 800-86 · MUCC-2017 · LMDFE Arts. 4 y 7)">
    Este catálogo guía la validación judicial para tribunales de pruebas en <strong>dispositivos móviles</strong> (imágenes, redes sociales, notas de voz, capturas de pantalla, WhatsApp/Telegram) y <strong>medios digitales consignados</strong> (CD/DVD, disco duro, reloj inteligente, computadora, servidor, cámara de seguridad DVR/CCTV), imprimiéndose en hojas tamaño Folio (<code>216mm × 330mm</code>) con <code>30mm</code> de margen izquierdo de encuadernación.
  </Alert>
</div>

<!-- Filtro Segmentado por Fase del Ciclo ISO (F0 - F5) -->
<div class="usa-button-group usa-button-group--segmented margin-bottom-3 overflow-x-auto flex-nowrap" id="filtros-fase-planillas" role="tablist">
  <button type="button" class="usa-button font-sans-2xs padding-x-105 padding-y-1 btn-filtro-fase" data-fase="todas">
    Todas (13)
  </button>
  <button type="button" class="usa-button usa-button--outline font-sans-2xs padding-x-105 padding-y-1 btn-filtro-fase" data-fase="F0">
    F0: Apertura (2)
  </button>
  <button type="button" class="usa-button usa-button--outline font-sans-2xs padding-x-105 padding-y-1 btn-filtro-fase" data-fase="F1">
    F1: Identificación (2)
  </button>
  <button type="button" class="usa-button usa-button--outline font-sans-2xs padding-x-105 padding-y-1 btn-filtro-fase" data-fase="F2">
    F2: Adquisición (1)
  </button>
  <button type="button" class="usa-button usa-button--outline font-sans-2xs padding-x-105 padding-y-1 btn-filtro-fase" data-fase="F3">
    F3: Análisis (2)
  </button>
  <button type="button" class="usa-button usa-button--outline font-sans-2xs padding-x-105 padding-y-1 btn-filtro-fase" data-fase="F4">
    F4: Dictamen (3)
  </button>
  <button type="button" class="usa-button usa-button--outline font-sans-2xs padding-x-105 padding-y-1 btn-filtro-fase" data-fase="F5">
    F5: Cierre (3)
  </button>
</div>

<!-- USWDS: Card | https://designsystem.digital.gov/components/card/ -->
<ul class="usa-card-group">
  {PLANILLAS.map((p) => (
    <li class="usa-card tablet:grid-col-6 desktop:grid-col-4 planilla-card-item" data-fase={p.fase}>
      <div class="usa-card__container overflow-hidden">
        <div class="usa-card__header">
          <div class="display-flex flex-justify flex-align-center margin-bottom-1">
            <span class="usa-tag font-mono-3xs">FASE {p.fase}</span>
            <span class="usa-tag usa-tag--informative font-mono-3xs">{p.codigo}</span>
            <span class="usa-tag font-mono-3xs">{p.hojas}</span>
          </div>
          <h2 class="usa-card__heading font-heading-sm">{p.titulo}</h2>
        </div>

        <div class="usa-card__body">
          <p class="font-mono-3xs text-bold text-accent-warm-dark margin-top-0 margin-bottom-1">
            ESTÁNDAR: {p.norma}
          </p>
          <p class="font-body-2xs text-base-dark margin-top-0 margin-bottom-0">
            {p.descripcion}
          </p>
        </div>

        <div class="usa-card__footer border-top-1px border-base-lighter padding-top-2">
          <ul class="usa-button-group flex-wrap width-full">
            <li class="usa-button-group__item flex-1">
              <a
                href={`/planillas/${p.slug}?modo=blanco`}
                class="usa-button usa-button--outline font-sans-2xs padding-x-1 padding-y-05 width-full text-center link-abrir-planilla"
                data-slug={p.slug}
              >
                Ver Formato
              </a>
            </li>
            <li class="usa-button-group__item flex-1">
              <a
                href={`/planillas/${p.slug}?modo=blanco&imprimir=1`}
                target="_blank"
                class="usa-button font-sans-2xs padding-x-1 padding-y-05 width-full text-center link-imprimir-planilla"
                data-slug={p.slug}
                title="Imprimir directamente en Folio en blanco"
              >
                <svg class="usa-icon margin-right-05" aria-hidden="true" focusable="false" role="img">
                  <use href="/assets/uswds/img/sprite.svg#print"></use>
                </svg>
                <span>Imprimir</span>
              </a>
            </li>
            <li class="usa-button-group__item flex-1 margin-top-1">
              <button
                type="button"
                class="usa-button usa-button--base font-sans-2xs padding-x-1 padding-y-05 width-full text-center btn-descargar-docx"
                data-slug={p.slug}
                data-titulo={p.titulo}
                title="Descargar esta planilla en formato Microsoft Word (.docx)"
              >
                <svg class="usa-icon margin-right-05" aria-hidden="true" focusable="false" role="img">
                  <use href="/assets/uswds/img/sprite.svg#file_download"></use>
                </svg>
                <span class="txt-descargar-docx">Word</span>
              </button>
            </li>
            <li class="usa-button-group__item flex-1 margin-top-1">
              <button
                type="button"
                class="usa-button usa-button--secondary font-sans-2xs padding-x-1 padding-y-05 width-full text-center btn-descargar-pdf-editable"
                data-slug={p.slug}
                data-titulo={p.titulo}
                data-codigo={p.codigo}
                data-fase={p.fase}
                title="Descargar en PDF editable con Código QR Rojo, barras Code-128, SHA-256 y campos para firma electrónica en Adobe Acrobat"
              >
                <svg class="usa-icon margin-right-05" aria-hidden="true" focusable="false" role="img">
                  <use href="/assets/uswds/img/sprite.svg#edit"></use>
                </svg>
                <span class="txt-descargar-pdf-editable">PDF (Adobe)</span>
              </button>
            </li>
          </ul>
        </div>
      </div>
    </li>
  ))}
</ul>

<EmitirPdfAdobeModal />

<script>
  import { descargarPlanillaPorSlug } from '../../lib/export/exportWordDocx';
  import { descargarPlanillaPdfEditablePorSlug } from '../../lib/export/exportEditablePdf';

  function initCatalogo() {
    // Configurar listeners de descarga directa Microsoft Word (.docx) siempre en blanco
    document.querySelectorAll('.btn-descargar-docx').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        const button = btn as HTMLButtonElement;
        const slug = button.getAttribute('data-slug') || '';
        const titulo = button.getAttribute('data-titulo') || '';
        const spanTxt = button.querySelector('.txt-descargar-docx');

        if (spanTxt) spanTxt.textContent = 'Generando...';
        button.disabled = true;

        try {
          await descargarPlanillaPorSlug(slug, 'blanco', undefined, titulo);
        } catch (err) {
          console.error('Error al descargar Word:', err);
          alert('Hubo un inconveniente al generar la planilla en formato Word.');
        } finally {
          if (spanTxt) spanTxt.textContent = 'Word';
          button.disabled = false;
        }
      });
    });

    // Configurar listeners de PDF Editable (abre Modal de Firma + Sellado QR Rojo & SHA-256 en cPanel)
    document.querySelectorAll('.btn-descargar-pdf-editable').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        const button = btn as HTMLButtonElement;
        const slug = button.getAttribute('data-slug') || '';
        const titulo = button.getAttribute('data-titulo') || '';
        const codigoDoc = button.getAttribute('data-codigo') || 'FO-FOR-01';
        const faseIso = button.getAttribute('data-fase') || 'F0';

        const openModal = (window as any).fccoOpenEmitirPdfModal;
        if (typeof openModal === 'function') {
          openModal({ mode: 'slug', slug, titulo, codigoDoc, faseIso });
          return;
        }

        const spanTxt = button.querySelector('.txt-descargar-pdf-editable');
        if (spanTxt) spanTxt.textContent = 'Generando...';
        button.disabled = true;

        try {
          await descargarPlanillaPdfEditablePorSlug(slug, 'blanco', undefined, titulo, {
            codigoDoc,
            faseIso,
          });
        } catch (err) {
          console.error('Error al descargar PDF Editable:', err);
          alert('Hubo un inconveniente al generar la planilla en PDF editable.');
        } finally {
          if (spanTxt) spanTxt.textContent = 'PDF (Adobe)';
          button.disabled = false;
        }
      });
    });

    // Filtro interactivo por Fase F0 - F5
    document.querySelectorAll('.btn-filtro-fase').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const fase = target.getAttribute('data-fase');
        document.querySelectorAll('.btn-filtro-fase').forEach((b) => b.classList.add('usa-button--outline'));
        target.classList.remove('usa-button--outline');

        document.querySelectorAll('.planilla-card-item').forEach((card) => {
          const cardEl = card as HTMLElement;
          const cardFase = cardEl.getAttribute('data-fase');
          if (fase === 'todas' || cardFase === fase) {
            cardEl.style.display = '';
          } else {
            cardEl.style.display = 'none';
          }
        });
      });
    });
  }

  if (typeof window !== 'undefined') {
    initCatalogo();
  }
</script>
