  function actualizarChecklistFase() {
    const fData = FASES_ISO.find((f) => f.id === faseSeleccionadaId);
    if (!fData) return;

    const bId = document.getElementById('badge-fase-id');
    const tNom = document.getElementById('titulo-fase-nombre');
    const tObj = document.getElementById('txt-fase-objetivo');
    const nWrap = document.getElementById('normas-fase-wrap');

    if (bId) bId.textContent = fData.id;
    if (tNom) tNom.textContent = fData.nombre;
    if (tObj) tObj.textContent = fData.objetivo;
    if (nWrap) {
      nWrap.innerHTML = fData.normas.map((n) => `<span class="usa-tag font-mono-3xs">${n}</span>`).join('');
    }

    document.querySelectorAll('.fcco-controles-group').forEach((el) => {
      const hEl = el as HTMLElement;
      hEl.hidden = hEl.id !== `controles-group-${faseSeleccionadaId}`;
    });

    const inputs = document.querySelectorAll<HTMLInputElement>(`#controles-group-${faseSeleccionadaId} .chk-control-iso`);
    let checkedCount = 0;
    inputs.forEach((i) => {
      if (i.checked) checkedCount++;
      i.onchange = actualizarProgreso;
    });

    const progTxt = document.getElementById('progreso-controles-txt');
    if (progTxt) progTxt.textContent = `${checkedCount} / ${inputs.length} Controles Verificados`;
  }

  function actualizarProgreso() {
    const inputs = document.querySelectorAll<HTMLInputElement>(`#controles-group-${faseSeleccionadaId} .chk-control-iso`);
    let checkedCount = 0;
    inputs.forEach((i) => {
      if (i.checked) checkedCount++;
