---
/**
 * SHA256.US — Vista Modular del Ciclo Pericial ISO (F0 - F5)
 * UX/UI USWDS Paso a Paso Sin Sobrecarga Cognitiva + Fuente Única RAG:
 *   RAG/Informacion_docling_rag/Informatica
 */
import PageHeader from '../uswds/PageHeader.astro';
import StepIndicator from '../uswds/StepIndicator.astro';
import Accordion from '../uswds/Accordion.astro';
import RagSourceBadge from '../uswds/RagSourceBadge.astro';
import { FASES_ISO } from '../../lib/domain/gating';
---

<PageHeader
  title="Guía Operativa del Ciclo Pericial ISO/IEC (F0 – F5)"
  subtitle="Asistente secuencial paso a paso fundamentado exclusivamente en RAG/Informacion_docling_rag/Informatica."
  tag="SOP Federal · 6 Fases"
  tagColor="bg-primary-darker"
>
  <div slot="actions" class="display-flex grid-gap-1 flex-wrap">
    <a href="/planillas" class="usa-button usa-button--outline font-sans-xs padding-x-2 padding-y-1">
      Catálogo Folio (13)
    </a>
    <a href="/custodia" class="usa-button usa-button--outline font-sans-xs padding-x-2 padding-y-1">
      Custodia PRCC
    </a>
  </div>
</PageHeader>

<!-- 1. BARRA COMPACTA DE SELECCIÓN DE EXPEDIENTE ACTIVO -->
<div class="usa-summary-box margin-bottom-205" role="region" aria-labelledby="caso-titulo">
  <div class="usa-summary-box__body">
    <div class="grid-row grid-gap flex-align-center">
      <div class="tablet:grid-col-8">
        <span class="usa-tag bg-primary-darker text-white font-mono-3xs margin-bottom-05">EXPEDIENTE PERICIAL ACTIVO</span>
        <h2 class="usa-summary-box__heading margin-y-05 font-heading-md" id="caso-titulo">
          Consultando expediente pericial...
        </h2>
        <p class="margin-0 font-body-2xs text-base-dark">
          N° Causa: <strong id="caso-numero" class="font-mono">---</strong> ·
          PRCC: <strong id="caso-prcc" class="font-mono">---</strong> ·
          Soporte: <strong id="caso-soporte" class="font-mono">Móvil / Medio Digital</strong> ·
          Fase Actual: <span class="usa-tag bg-accent-warm-dark text-ink font-mono-3xs" id="caso-fase-badge">F0</span>
        </p>
      </div>

      <div class="tablet:grid-col-4 tablet:display-flex tablet:flex-justify-end margin-top-2 tablet:margin-top-0">
        <div class="width-full">
          <label class="usa-label margin-top-0 font-sans-2xs text-bold" for="select-cambiar-caso">
            Cambiar de Expediente:
          </label>
          <select class="usa-select font-sans-xs" id="select-cambiar-caso">
            <option value="">Cargando expedientes...</option>
          </select>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 2. INDICADOR VISUAL DE ETAPAS USWDS (STEP INDICATOR) -->
<div class="margin-bottom-2" id="step-indicator-wrap">
  <StepIndicator faseActual="F0" />
</div>

<!-- 3. SEGMENTED TABS DE FASES F0 A F5 -->
<div class="usa-button-group usa-button-group--segmented margin-bottom-205 width-full overflow-x-auto flex-nowrap" role="tablist">
  {FASES_ISO.map((f, i) => (
    <button
      type="button"
      role="tab"
      aria-selected={i === 0 ? 'true' : 'false'}
      class={`usa-button btn-fase-tab ${i === 0 ? '' : 'usa-button--outline'} font-sans-2xs padding-x-2 padding-y-1 text-no-wrap`}
      data-fase={f.id}
      id={`tab-fase-${f.id}`}
    >
      <span class="font-bold">{f.id}</span>: {f.corto}
    </button>
  ))}
</div>

<!-- 4. CONTENEDOR PRINCIPAL DE LA FASE ACTIVA (FLUJO PASO A PASO EN 3 MICRO-PASOS) -->
<div class="usa-card width-full margin-bottom-4 shadow-2">
  <div class="usa-card__container padding-3 tablet:padding-4">

    <!-- Cabecera de la Fase -->
    <div class="grid-row grid-gap flex-align-center border-bottom-2px border-base-lighter padding-bottom-2 margin-bottom-205">
      <div class="tablet:grid-col-8">
        <div class="display-flex flex-align-center margin-bottom-05">
          <span class="usa-tag bg-primary-darker text-white text-bold margin-right-1 font-mono-sm" id="badge-fase-id">
            F0
          </span>
          <h2 class="margin-0 font-heading-lg" id="titulo-fase-nombre">
            Apertura y Legitimación
          </h2>
        </div>
        <p class="margin-0 font-body-xs text-base-dark" id="txt-fase-objetivo">
          Legitimar el encargo pericial, identificar al consignante y delimitar el alcance técnico.
        </p>
      </div>

      <div class="tablet:grid-col-4 tablet:display-flex tablet:flex-justify-end">
        <div class="display-flex flex-wrap grid-gap-05" id="normas-fase-wrap">
          <span class="usa-tag font-mono-3xs">LEDCI Arts. 20–22</span>
          <span class="usa-tag font-mono-3xs">ISO/IEC 27037 §5.2</span>
          <span class="usa-tag bg-accent-warm-dark text-ink text-bold font-mono-3xs">CRBV Arts. 28/60</span>
        </div>
      </div>
    </div>

    <!-- Barra de Navegación Rápida de los 3 Micro-Pasos de la Fase (Reduce Carga Cognitiva) -->
    <nav aria-label="Secuencia paso a paso de la fase activa" class="bg-base-lightest padding-105 radius-md border-1px border-base-lighter margin-bottom-205">
      <div class="grid-row grid-gap-1 flex-align-center">
        <div class="tablet:grid-col-4">
          <a href="#paso1-section" class="display-flex flex-align-center text-no-underline text-ink padding-05">
            <span class="usa-tag bg-primary text-white font-mono-3xs margin-right-1">PASO 1</span>
            <span class="font-sans-2xs text-bold">Registrar Datos de Fase</span>
          </a>
        </div>
        <div class="tablet:grid-col-4">
          <a href="#paso2-section" class="display-flex flex-align-center text-no-underline text-ink padding-05">
            <span class="usa-tag bg-primary text-white font-mono-3xs margin-right-1">PASO 2</span>
            <span class="font-sans-2xs text-bold">Emitir Planillas Folio</span>
          </a>
        </div>
        <div class="tablet:grid-col-4">
          <a href="#paso3-section" class="display-flex flex-align-center text-no-underline text-ink padding-05">
            <span class="usa-tag bg-primary-darker text-white font-mono-3xs margin-right-1">PASO 3</span>
            <span class="font-sans-2xs text-bold">Validar RAG y Sellar SHA-256</span>
          </a>
        </div>
      </div>
    </nav>

    <!-- =================================================================== -->
    <!-- GUÍA OPERATIVA DE LABORATORIO (ACORDEÓN USWDS — PROGRESSIVE DISCLOSURE) -->
    <!-- =================================================================== -->
    <div class="margin-bottom-3">
      <Accordion
        id="guia-sop-protocolo"
        title="Guía Operativa de Ejecución Pericial (SOP por Consignación — RAG/Informacion_docling_rag/Informatica)"
        expanded={false}
      >
        <div class="display-flex flex-justify flex-align-center margin-bottom-1">
          <span class="font-mono-3xs text-base-dark">Fuente autorizada: <code>RAG/Informacion_docling_rag/Informatica</code></span>
          <span class="usa-tag bg-primary-darker text-white font-mono-3xs" id="guia-sop-badge">PROTOCOLO F0</span>
        </div>
        <div id="guia-sop-steps-container" class="font-body-2xs text-ink">
          <!-- Se inyecta dinámicamente la guía paso a paso (.usa-process-list) según la fase F0..F5 -->
        </div>
      </Accordion>
    </div>

    <!-- =================================================================== -->
    <!-- MICRO-PASO 1: DATOS REQUERIDOS DEL EXPEDIENTE PARA ESTA FASE        -->
    <!-- =================================================================== -->
    <section id="paso1-section" class="margin-bottom-3 bg-base-lightest padding-3 radius-md border-1px border-base-lighter" aria-labelledby="paso1-heading">
      <div class="display-flex flex-justify flex-align-center margin-bottom-105">
        <div class="display-flex flex-align-center">
          <span class="usa-tag bg-primary text-white margin-right-1 font-mono-xs text-bold">PASO 1 DE 3</span>
          <h3 class="margin-0 font-heading-sm" id="paso1-heading">
            Verificación y Carga de Datos Clave de la Fase
          </h3>
        </div>
        <button type="button" class="usa-button usa-button--outline font-sans-2xs padding-x-105 padding-y-05" id="btn-guardar-paso1">
          Guardar Cambios
        </button>
      </div>
      <p class="font-body-2xs text-base-dark margin-top-0 margin-bottom-2">
        Complete únicamente los campos requeridos para esta fase. Se sincronizan con las planillas Folio y el sello SHA-256.
      </p>

      <div class="grid-row grid-gap-2 font-body-2xs" id="campos-fase-container">
        <!-- Campos dinámicos renderizados por JS según la fase seleccionada -->
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- MICRO-PASO 2: INSTRUMENTOS Y PLANILLAS EN FOLIO (216mm × 330mm)     -->
    <!-- =================================================================== -->
    <section id="paso2-section" class="margin-bottom-3" aria-labelledby="paso2-heading">
      <div class="display-flex flex-align-center margin-bottom-1">
        <span class="usa-tag bg-primary text-white margin-right-1 font-mono-xs text-bold">PASO 2 DE 3</span>
        <h3 class="margin-0 font-heading-sm" id="paso2-heading">
          Instrumentos y Planillas Oficiales en Papel Folio (216mm × 330mm)
        </h3>
      </div>
      <p class="font-body-2xs text-base-dark margin-top-0 margin-bottom-2">
        Abra e imprima los formatos oficiales correspondientes a esta fase para firmas ológrafas y huellas dactilares:
      </p>

      <div class="grid-row grid-gap-2" id="grid-planillas-fase">
        <!-- Renderizado dinámico de tarjetas de planillas de la fase -->
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- MICRO-PASO 3: VERIFICACIÓN RAG Y SELLO CRIPTOGRÁFICO SHA-256        -->
    <!-- =================================================================== -->
    <section id="paso3-section" class="border-top-2px border-base-lighter padding-top-3 margin-top-2" aria-labelledby="paso3-heading">
      <div class="display-flex flex-justify flex-align-center margin-bottom-105">
        <div class="display-flex flex-align-center">
          <span class="usa-tag bg-primary-darker text-white margin-right-1 font-mono-xs text-bold">PASO 3 DE 3</span>
          <h3 class="margin-0 font-heading-sm" id="paso3-heading">
            Checklist de Cumplimiento Normativo RAG y Sello Criptográfico SHA-256
          </h3>
        </div>
        <div class="usa-tag bg-base-lighter text-ink font-mono-xs text-bold" id="progreso-controles-txt">
          0 / 0 Controles Verificados
        </div>
      </div>

      <p class="font-body-2xs text-base-dark margin-top-0 margin-bottom-2">
        Marque cada control verificado. Despliegue <strong>Fundamento RAG</strong> solo si desea consultar el documento fuente exacto en <code>RAG/Informacion_docling_rag/Informatica</code>:
      </p>

      <!-- Checklist de Controles con Progressive Disclosure real del corpus RAG Informatica -->
      <div id="controles-fase-container" class="margin-bottom-3">
        {FASES_ISO.map((fase) => (
          <div
            class="fcco-controles-group"
            id={`controles-group-${fase.id}`}
            hidden={fase.id !== 'F0'}
          >
            <div class="grid-row grid-gap-1">
              {fase.controles.map((c) => (
                <div class="tablet:grid-col-6 margin-bottom-105">
                  <div class="usa-checkbox bg-white padding-105 radius-md border-1px border-base-lighter height-full display-flex flex-column flex-justify">
                    <div>
                      <input
                        class="usa-checkbox__input chk-control-iso"
                        type="checkbox"
                        id={`chk-${c.id}`}
                        name={`control-${c.id}`}
                        data-control-id={c.id}
                        data-fase-id={fase.id}
                      />
                      <label class="usa-checkbox__label font-body-2xs margin-top-0" for={`chk-${c.id}`}>
                        <strong class="text-ink">{c.texto}</strong>
                      </label>
                    </div>

                    <!-- Progressive Disclosure de la Cita RAG Verificada -->
                    <details class="margin-top-1 font-body-3xs text-base-dark">
                      <summary class="cursor-pointer text-primary text-bold">
                        Fundamento RAG: <span class="usa-tag font-mono-3xs">{c.norma}</span>
                      </summary>
                      <div class="margin-top-05">
                        <p class="margin-top-0 margin-bottom-05 bg-base-lightest padding-1 radius-sm border-left-2px border-primary">
                          {c.detalleRag || `Control verificado conforme a ${c.norma}.`}
                        </p>
                        <RagSourceBadge archivoRag={c.fuenteRag || 'RAG/Informacion_docling_rag/Informatica/ISO IEC 27037-2012.md'} />
                      </div>
                    </details>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Hero Call-to-Action: Sello Criptográfico SHA-256 -->
      <div class="usa-summary-box bg-primary-darker text-white radius-md" role="region" aria-labelledby="sello-crypto-heading">
        <div class="usa-summary-box__body">
          <div class="grid-row grid-gap flex-align-center">
            <div class="tablet:grid-col-8 margin-bottom-2 tablet:margin-bottom-0">
              <h4 class="usa-summary-box__heading margin-top-0 margin-bottom-05 text-white font-heading-sm" id="sello-crypto-heading">
                Gating Criptográfico y Encadenamiento SHA-256 (RFC 8785)
              </h4>
              <p class="margin-0 font-body-2xs text-base-lightest">
                Al sellar esta fase, el estado canónico se concatenará al bloque previo de auditoría y se habilitará la siguiente fase de forma irrevocable.
              </p>
              <div id="sello-info-hash" class="margin-top-1 margin-bottom-0 font-mono-3xs bg-black padding-1 radius-sm display-flex flex-align-center" hidden>
                <span class="text-accent-warm margin-right-1">SELLO GENERADO:</span>
                <code id="sello-hash-valor" class="text-white text-bold word-break-all"></code>
              </div>
            </div>

            <div class="tablet:grid-col-4 tablet:display-flex tablet:flex-justify-end">
              <button
                id="btn-sellar-fase"
                type="button"
                class="usa-button usa-button--big font-sans-xs padding-x-3 padding-y-105 width-full text-center"
              >
                Sellar y Avanzar Fase →
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

  </div>
</div>

<script>
  import { FASES_ISO } from '../../lib/domain/gating';
  import { phpApi } from '../../lib/data/phpApi';
  import { idbPut, idbGetAll } from '../../lib/data/idb';
  import type { CasoCMS } from '../../lib/domain/types';

  const SOP_GUIDE_MAP: Record<string, Array<{ titulo: string; detalle: string }>> = {
    F0: [
      {
        titulo: '1. Legitimar al Consignante y Excluir Antijuridicidad (CRBV Arts. 28, 48, 60 · LEDCI Arts. 20–22 · LPPC Art. 2)',
        detalle: 'Verifique la cédula/RIF y confirme que quien consigna el dispositivo móvil o medio digital es el titular legítimo o interlocutor directo (RAG: Ley Especial de Delitos informáticos 2001 y Ley sobre Protección a la Privacidad de las Comunicaciones).',
      },
      {
        titulo: '2. Suscribir Acta de Consentimiento Informado en Folio (FO-F0-01)',
        detalle: 'Imprima en papel Folio (216mm × 330mm) el Acta FO-F0-01 y recabe firma ológrafa y huellas dactilares bilaterales (Pulgar Izq. y Der.) autorizando la extracción lógica/física.',
      },
      {
        titulo: '3. Levantar Acta de Entrevista Técnico-Pericial (FO-F0-02)',
        detalle: 'Fije bajo juramento qué pruebas deben validarse (imágenes, redes sociales, notas de voz, capturas de pantalla, chats) y reciba el PIN o contraseña en sobre lacrado.',
      },
    ],
    F1: [
      {
        titulo: '1. Fijación Fotográfica 360° e Identificación Física (ISO/IEC 27037 §5.4.2 · MUCC-2017)',
        detalle: 'Capture 6 vistas macro del dispositivo móvil o medio digital consignado, registrando marca, modelo, color, serial/IMEI y estado físico inicial.',
      },
      {
        titulo: '2. Aislamiento Electromagnético y Precintado (ISO/IEC 27037 §5.4.3 · NIST SP 800-101)',
        detalle: 'Active Modo Avión (0 dBm), introduzca el móvil/wearable en Bolsa Faraday (o empaque antiestático para discos/CD/DVR) y coloque Precinto de Seguridad numerado.',
      },
      {
        titulo: '3. Emitir Acta de Obtención (FO-F1-03) y Abrir Planilla PRCC (FO-F1-04)',
        detalle: 'Formalice la recepción marcando la Forma de Obtención N° 3 (Consignación) en la PRCC conforme al Art. 187 del COPP y MUCC-2017.',
      },
    ],
    F2: [
      {
        titulo: '1. Desprecintado Controlado en Laboratorio (FO-F2-05 · MUCC-2017)',
        detalle: 'Verifique la indemnidad del precinto inicial antes de su apertura en área pericial aislada y deje constancia del número de precinto roto.',
      },
      {
        titulo: '2. Adquisición Lógica Móvil o Bit-a-Bit con Write-Blocker (NIST SP 800-101 / 800-86 · CENIF G.O. 39.847)',
        detalle: 'Extraiga las bases SQLite (msgstore.db, wa.db), redes sociales, imágenes, notas de voz y capturas con ALEAPP / Avilla Forensics, o imagen bit-a-bit con bloqueador de escritura.',
      },
      {
        titulo: '3. Cálculo de Hash Génesis SHA-256, Verificación MATCH y Reembalaje (ISO/IEC 27037 §5.4.4 / §7.1.3)',
        detalle: 'Calcule el digest SHA-256, compruebe MATCH 100% (otorgando valor de original según Art. 7 LMDFE G.O. 37.148) y reembale el soporte con Nuevo Precinto.',
      },
    ],
    F3: [
      {
        titulo: '1. Examen Exclusivo sobre Copia de Trabajo (ACPO P1 · ISO/IEC 27042 §7)',
        detalle: 'Realice todo el análisis forense sobre la copia lógica o imagen adquirida en F2, preservando intacto el dispositivo o medio original en bóveda.',
      },
      {
        titulo: '2. Análisis Espectrográfico de Notas de Voz y Audios (FO-F3-06 · ISO/IEC 27042 · LPPC Art. 4)',
        detalle: 'Examine los archivos de audio (.opus / .wav) en Sonic Visualiser / Praat verificando piso de ruido, formantes F1–F4, traza ENF 60 Hz y ausencia de edición.',
      },
      {
        titulo: '3. Cotejo de Capturas de Pantalla, Redes Sociales e Interfaz contra SQLite (FO-F3-07 · LMDFE Art. 4)',
        detalle: 'Corrobore la sincronía de sellos temporales UTC, JID de interlocutores y estados de envío entre las capturas/pantalla y los registros crudos de base de datos.',
      },
    ],
    F4: [
      {
        titulo: '1. Actuación Colegiada de Dos Peritos Acreditados (COPP Arts. 223–225 · MUCC-2017)',
        detalle: 'Revise conjuntamente entre el Perito Principal y el Co-Perito los hallazgos técnicos para garantizar repetibilidad y validez procesal.',
      },
      {
        titulo: '2. Emisión del Dictamen Oficial (FO-F4-08) y Dictámenes Especializados (FO-F4-09 / FO-F4-10)',
        detalle: 'Estructure el dictamen conforme al Art. 225 del COPP (1. Motivo y objeto, 2. Operaciones técnicas EXIF/ELA/FFT/SQLite y Hash SHA-256, 3. Conclusiones motivadas) y UNE 197010.',
      },
      {
        titulo: '3. Suscripción Bilateral y Dactiloscopía en Papel Folio (216mm × 330mm)',
        detalle: 'Imprima los dictámenes en formato Folio con margen izquierdo de 30mm para costura judicial, estampando firmas, sellos y huellas de ambos peritos.',
      },
    ],
    F5: [
      {
        titulo: '1. Disposición Final y Devolución de Evidencias (FO-F5-11 · MUCC-2017)',
        detalle: 'Entregue al consignante titular el Dictamen Oficial en Folio, la copia master digital sellada con SHA-256 y devuelva el móvil o medio digital consignado.',
      },
      {
        titulo: '2. Sanitización Criptográfica de Medios del Laboratorio (FO-F5-12 · ISO/IEC 27002 A.8.10 · LEDCI Art. 22)',
        detalle: 'Ejecute purga irreversible de los volúmenes temporales del laboratorio para cumplir el deber de confidencialidad y no retención de data personal.',
      },
      {
        titulo: '3. Certificación del Timeline de Auditoría Inmutable (FO-F5-13 · LMDFE Art. 16 · UNE 71505)',
        detalle: 'Verifique la integridad matemática de la cadena de bloques SHA-256 (SEQ 1 a 6, F0–F5) bajo RFC 8785 y archive el acta de cierre de cumplimiento.',
      },
    ],
  };

  const PLANILLAS_MAP: Record<string, Array<{ id: string; codigo: string; titulo: string; slug: string; desc: string }>> = {
    F0: [
      { id: 'acta_consentimiento', codigo: 'FO-F0-01', titulo: 'Acta de Consentimiento Informado', slug: 'acta-consentimiento', desc: 'Autorización legal expresa por consignación (móvil / multimedio) y privacidad (CRBV Arts. 28, 48, 60 · LEDCI Arts. 20–21).' },
      { id: 'acta_entrevista', codigo: 'FO-F0-02', titulo: 'Acta de Entrevista Técnico-Pericial', slug: 'acta-entrevista', desc: 'Fijación de declaraciones, pruebas a validar y credenciales bajo juramento (CP Arts. 243 y 246).' },
    ],
    F1: [
      { id: 'acta_obtencion', codigo: 'FO-F1-03', titulo: 'Acta de Obtención y Preservación', slug: 'acta-obtencion', desc: 'Recepción del móvil o medio digital con fijación 360°, aislamiento Faraday y precinto numerado.' },
      { id: 'prcc', codigo: 'FO-F1-04', titulo: 'Planilla de Registro de Cadena de Custodia (PRCC)', slug: 'planilla-prcc', desc: 'Apertura formal de la matriz de custodia por consignación (MUCC-2017 y COPP Art. 187).' },
    ],
    F2: [
      { id: 'acta_desprecintado', codigo: 'FO-F2-05', titulo: 'Acta de Desprecintado en Laboratorio', slug: 'acta-desprecintado', desc: 'Extracción lógica móvil o imagen con Write-Blocker, cálculo de Hash SHA-256 y nuevo precinto.' },
    ],
    F3: [
      { id: 'informe_audio_sonic', codigo: 'FO-F3-06', titulo: 'Planilla de Análisis Forense de Audio', slug: 'planilla-audio-sonic', desc: 'Espectrograma FFT, decodificación Opus 48 kHz, formantes vocálicos y detección anti-deepfake.' },
      { id: 'planilla_evaluacion_ux', codigo: 'FO-F3-07', titulo: 'Planilla de Evaluación de Interfaz UX', slug: 'planilla-evaluacion-ux', desc: 'Cotejo heurístico entre capturas de pantalla, redes sociales o interfaz y registros SQLite/logs.' },
    ],
    F4: [
      { id: 'acta_dictamen', codigo: 'FO-F4-08', titulo: 'Dictamen Pericial Oficial Colegiado', slug: 'acta-dictamen', desc: 'Dictamen motivado definitivo firmado por dos peritos para tribunales (COPP Arts. 223–225).' },
      { id: 'dictamen_imagenes', codigo: 'FO-F4-09', titulo: 'Dictamen de Evidencia Fotográfica', slug: 'dictamen-imagenes', desc: 'Cotejo EXIF, análisis ELA e integridad de píxeles en fotos, capturas y cámaras DVR.' },
