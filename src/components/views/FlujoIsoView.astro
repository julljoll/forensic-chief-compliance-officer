  let listaCasos: CasoCMS[] = [];
  let casoActual: CasoCMS | null = null;
  let faseSeleccionadaId = 'F0';

  async function cargarCasosYSeleccionar() {
    try {
      const data = await phpApi.listarCasos();
      listaCasos = (data || []).filter((c: CasoCMS) => !c.id.startsWith('caso-mock-'));
    } catch {
      const data = await idbGetAll<CasoCMS>('casos');
      listaCasos = (data || []).filter((c: CasoCMS) => !c.id.startsWith('caso-mock-'));
    }

    const select = document.getElementById('select-cambiar-caso') as HTMLSelectElement;
    if (select && listaCasos.length > 0) {
      select.innerHTML = '';
      listaCasos.forEach((c) => {
        const opt = document.createElement('option');
        opt.value = c.id;
        opt.textContent = `${c.numeroCaso} — ${c.evidenciaTipo || 'Móvil'} ${c.evidenciaMarca || 'Smartphone'} (${c.faseIsoActual || c.estado || 'F0'})`;
        select.appendChild(opt);
      });

      const params = new URLSearchParams(window.location.search);
      const paramId = params.get('casoId') || params.get('id');
      const encontrado = listaCasos.find((c) => c.id === paramId);
      casoActual = encontrado || listaCasos[0];
      select.value = casoActual.id;

      select.addEventListener('change', () => {
        const sel = listaCasos.find((c) => c.id === select.value);
        if (sel) {
          casoActual = sel;
          actualizarVistaCompleta();
        }
      });
    }

    actualizarVistaCompleta();
  }

  function seleccionarFase(fId: string) {
    faseSeleccionadaId = fId;
    document.querySelectorAll('.btn-fase-tab').forEach((b) => {
      const isTarget = b.getAttribute('data-fase') === fId;
      b.classList.toggle('usa-button--outline', !isTarget);
      b.setAttribute('aria-selected', isTarget ? 'true' : 'false');
    });

    actualizarStepIndicatorVisual();
    renderizarGuiaSop();
    renderizarPaso1Campos();
    renderizarPaso2Planillas();
    actualizarChecklistFase();
  }

  function actualizarVistaCompleta() {
    actualizarCabeceraCaso();
    actualizarStepIndicatorVisual();
    renderizarGuiaSop();
    renderizarPaso1Campos();
    renderizarPaso2Planillas();
    actualizarChecklistFase();
  }

  function actualizarCabeceraCaso() {
    if (!casoActual) return;
    const tEl = document.getElementById('caso-titulo');
    const nEl = document.getElementById('caso-numero');
    const pEl = document.getElementById('caso-prcc');
    const sEl = document.getElementById('caso-soporte');
    const bEl = document.getElementById('caso-fase-badge');

    const tipoSoporte = casoActual.evidenciaTipo || 'Teléfono Inteligente (Smartphone)';
    const marcaModelo = `${casoActual.evidenciaMarca || casoActual.dispositivo_marca || ''} ${casoActual.evidenciaModelo || casoActual.dispositivo_modelo || ''}`.trim();

    if (tEl) tEl.textContent = `${casoActual.numeroCaso} — ${casoActual.titulo || marcaModelo || 'Expediente Forense'}`;
    if (nEl) nEl.textContent = casoActual.numeroCaso;
    if (pEl) pEl.textContent = casoActual.numero_prcc || casoActual.numeroPRCC || 'PRCC-2026-001';
    if (sEl) sEl.textContent = `${tipoSoporte} ${marcaModelo ? `(${marcaModelo})` : ''}`;
    if (bEl) bEl.textContent = String(casoActual.faseIsoActual || casoActual.estado || 'F0');
  }

  function actualizarStepIndicatorVisual() {
    const activeIdx = FASES_ISO.findIndex((f) => f.id === faseSeleccionadaId);
    const numEl = document.getElementById('step-indicator-num');
    const titEl = document.getElementById('step-indicator-title');

    if (numEl && activeIdx >= 0) numEl.textContent = String(activeIdx + 1);
    if (titEl && activeIdx >= 0) titEl.textContent = FASES_ISO[activeIdx].nombre;

    document.querySelectorAll<HTMLElement>('[data-step-fase]').forEach((seg) => {
      const idx = Number(seg.getAttribute('data-step-idx') || 0);
      seg.classList.remove('usa-step-indicator__segment--complete', 'usa-step-indicator__segment--current');
      if (idx < activeIdx) {
        seg.classList.add('usa-step-indicator__segment--complete');
        seg.removeAttribute('aria-current');
      } else if (idx === activeIdx) {
        seg.classList.add('usa-step-indicator__segment--current');
        seg.setAttribute('aria-current', 'true');
      } else {
        seg.removeAttribute('aria-current');
      }
    });
  }

