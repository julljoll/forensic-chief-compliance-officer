---
/**
 * SHA256.US — Vista Modular del Panel General (Dashboard)
 * Principios UX/UI: Hick's Law (Próximo Paso Recomendado Hero Card) & Proximidad Gestalt
 */
import PageHeader from '../uswds/PageHeader.astro';
import KpiCard from '../uswds/KpiCard.astro';
import SummaryBox from '../uswds/SummaryBox.astro';
import Alert from '../uswds/Alert.astro';
---

<PageHeader
  title="Panel General de Cumplimiento"
  subtitle="Monitoreo determinista de expedientes periciales, sellos criptográficos SHA-256 y trazabilidad ISO/IEC."
  tag="Acreditación Activa"
  tagColor="bg-primary-darker"
>
  <div slot="actions" class="display-flex grid-gap-1 flex-wrap">
    <a href="/casos?nuevo=1" class="usa-button font-sans-xs padding-x-2 padding-y-1">
      Aperturar Expediente
    </a>
    <a href="/auditoria" class="usa-button usa-button--outline font-sans-xs padding-x-2 padding-y-1">
      Verificar Cadena
    </a>
  </div>
</PageHeader>

<Alert type="info" heading="Laboratorio Forense Certificado · Entorno Auditado" className="margin-bottom-3">
  Todos los procedimientos registrados en este CMS de cumplimiento están respaldados por sellos criptográficos
  <strong>SHA-256</strong> bajo la cadena de custodia reglamentaria <strong>MUCC-2017</strong> (Gaceta N° 41.247)
  y el estándar internacional <strong>ISO/IEC 27037:2012</strong>.
</Alert>

<!-- HERO CARD: PRÓXIMO PASO RECOMENDADO (HICK'S LAW: ELIMINACIÓN DE CARGA COGNITIVA) -->
<div class="usa-summary-box bg-primary-darker text-white radius-md margin-bottom-3 shadow-2" role="region" aria-labelledby="hero-proximo-paso-heading">
  <div class="usa-summary-box__body padding-3">
    <div class="grid-row grid-gap flex-align-center">
      <div class="tablet:grid-col-8">
        <span class="usa-tag bg-accent-warm-dark text-ink font-mono-3xs text-bold margin-bottom-1">
          ACCIÓN PRIORITARIA RECOMENDADA
        </span>
        <h2 class="usa-summary-box__heading margin-y-05 text-white font-heading-md" id="hero-proximo-paso-heading">
          Identificando siguiente paso procesal...
        </h2>
        <p class="margin-0 font-body-2xs text-base-lightest" id="hero-proximo-paso-desc">
          Analizando el estado procesal y los requisitos de gating de los expedientes periciales activos...
        </p>
      </div>

      <div class="tablet:grid-col-4 tablet:display-flex tablet:flex-justify-end margin-top-2 tablet:margin-top-0">
        <a
          href="/flujo"
          id="btn-hero-continuar-flujo"
          class="usa-button usa-button--big font-sans-xs padding-x-3 padding-y-105 width-full tablet:width-auto text-center"
        >
          Continuar Flujo ISO →
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Grupo de Métricas Principales (KPIs) -->
<div class="grid-row grid-gap-2 margin-bottom-3">
  <div class="grid-col-12 tablet:grid-col-6 desktop:grid-col-3">
    <KpiCard
      label="Expedientes Activos"
      value="0"
      id="kpi-total-casos"
      subtext="En curso procesal en laboratorio"
      variant="primary"
    />
  </div>
  <div class="grid-col-12 tablet:grid-col-6 desktop:grid-col-3">
    <KpiCard
      label="Evidencias Custodiadas"
      value="0"
      id="kpi-evidencias"
      subtext="Con precinto numerado y PRCC"
      variant="info"
    />
  </div>
  <div class="grid-col-12 tablet:grid-col-6 desktop:grid-col-3">
    <KpiCard
      label="Fases ISO Validadas"
      value="6 / 6"
      id="kpi-fases"
      subtext="Gating F0–F5 superado"
      variant="warning"
    />
  </div>
  <div class="grid-col-12 tablet:grid-col-6 desktop:grid-col-3">
    <KpiCard
      label="Integridad SHA-256"
      value="100%"
      id="kpi-integridad"
      subtext="Cadena sin roturas (RFC 8785)"
      variant="success"
    />
  </div>
</div>

<SummaryBox
  heading="Control de Calidad Pericial — Ciclo ISO 6 Fases (F0 - F5)"
  headingId="summary-ciclo-iso"
  className="margin-bottom-3"
>
  <p class="margin-top-0 margin-bottom-1 font-body-2xs">
    El CMS opera bajo un flujo determinista cerrado: ninguna etapa puede cerrarse sin que el perito
    adjunte los requisitos de fijación, adquiera la imagen forense con hardware de bloqueo de escritura
    y selle criptográficamente el hash génesis.
  </p>
  <div class="display-flex flex-wrap grid-gap-05 margin-top-1">
    <span class="usa-tag bg-primary-darker text-white font-mono-3xs">ISO/IEC 27037:2012</span>
    <span class="usa-tag bg-primary-darker text-white font-mono-3xs">ISO/IEC 27042:2015</span>
    <span class="usa-tag bg-primary text-white font-mono-3xs">NIST SP 800-86</span>
    <span class="usa-tag bg-accent-warm-dark text-ink text-bold font-mono-3xs">MUCC-2017</span>
    <span class="usa-tag bg-success text-white font-mono-3xs">COPP Art. 187</span>
  </div>
</SummaryBox>

<!-- Tabla de Expedientes Activos -->
<section class="margin-bottom-4" aria-labelledby="expedientes-curso-heading">
  <div class="grid-row flex-justify flex-align-center margin-bottom-2">
    <h2 class="margin-0 font-heading-md" id="expedientes-curso-heading">Expedientes Periciales en Curso</h2>
    <a href="/casos" class="usa-link font-sans-2xs">Ver todos los casos →</a>
  </div>

  <div class="usa-table-container--scrollable" tabindex="0">
    <table class="usa-table usa-table--striped usa-table--compact width-full">
      <caption>Listado de expedientes forenses activos sincronizados en base de datos</caption>
      <thead>
        <tr>
          <th scope="col">N° Expediente</th>
          <th scope="col">Tipología Forense</th>
          <th scope="col">Consignante / C.I.</th>
          <th scope="col">Dispositivo Evidencia</th>
          <th scope="col">Fase Actual</th>
          <th scope="col">Integridad</th>
          <th scope="col">Acciones</th>
        </tr>
      </thead>
      <tbody id="tabla-casos-body">
        <tr>
          <td colspan="7">Consultando expedientes sincronizados en MySQL...</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<!-- Tarjetas Rápidas de Planillas y Normativa -->
<div class="grid-row grid-gap-2">
  <div class="grid-col-12 tablet:grid-col-6">
    <div class="usa-card bg-white padding-3 radius-md shadow-1 border-1px border-base-lighter height-full display-flex flex-column flex-justify-between">
      <div>
        <h3 class="margin-top-0 margin-bottom-1 font-heading-sm">Planillas Oficiales en Folio (216mm × 330mm)</h3>
        <p class="font-body-2xs text-base-dark margin-top-0 margin-bottom-1">
          Formatos reglamentarios con membrete oficial, dactiloscopía bilateral y márgenes de impresión exactos:
        </p>
        <ul class="usa-list font-body-2xs">
          <li><a href="/planillas/acta-consentimiento" class="usa-link">Acta de Consentimiento Informado (FO-F0-01)</a></li>
          <li><a href="/planillas/acta-entrevista" class="usa-link">Acta de Entrevista Forense al Consignante (FO-F0-02)</a></li>
          <li><a href="/planillas/acta-obtencion" class="usa-link">Acta de Obtención y Preservación Inicial (FO-F1-03)</a></li>
          <li><a href="/planillas/planilla-prcc" class="usa-link">Planilla de Cadena de Custodia PRCC (FO-F1-04)</a></li>
          <li><a href="/planillas/acta-desprecintado" class="usa-link">Acta de Desprecintado en Laboratorio (FO-F2-05)</a></li>
          <li><a href="/planillas/acta-dictamen" class="usa-link">Dictamen Pericial Oficial Forense (FO-F4-08)</a></li>
        </ul>
      </div>
      <div class="border-top-1px border-base-lighter padding-top-2 margin-top-2">
        <a href="/planillas" class="usa-button usa-button--outline font-sans-xs padding-x-2 padding-y-1">
          Ver Catálogo Completo (13 Planillas)
        </a>
      </div>
    </div>
  </div>

  <div class="grid-col-12 tablet:grid-col-6">
    <div class="usa-card bg-white padding-3 radius-md shadow-1 border-1px border-base-lighter height-full display-flex flex-column flex-justify-between">
      <div>
        <h3 class="margin-top-0 margin-bottom-1 font-heading-sm">Admisibilidad y Blindaje Procesal</h3>
        <p class="font-body-2xs text-base-dark margin-top-0 margin-bottom-1">
          Garantías procesales activas para evitar la nulidad conforme al Art. 187 del COPP:
        </p>
        <ul class="usa-list font-body-2xs">
          <li>
            <strong>Bloqueadores de Escritura (Write-Blockers):</strong> Obligatorios para la clonación bit-a-bit en ISO 27037 §5.4.4.
          </li>
          <li>
            <strong>Sellado Génesis SHA-256:</strong> Cálculo bit-a-bit antes de cualquier análisis o triaje pericial.
          </li>
          <li>
            <strong>Dactiloscopía Bilateral:</strong> Pulgar izquierdo y pulgar derecho en todas las actas judiciales.
          </li>
        </ul>
      </div>
      <div class="border-top-1px border-base-lighter padding-top-2 margin-top-2">
        <a href="/normativa" class="usa-button usa-button--outline font-sans-xs padding-x-2 padding-y-1">
          Consultar Base Normativa RAG
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  import { phpApi } from '../../lib/data/phpApi';
  import { idbGetAll } from '../../lib/data/idb';
  import type { CasoCMS } from '../../lib/domain/types';

  const PASOS_INFO: Record<string, { titulo: string; desc: string; url: string }> = {
    F0: {
      titulo: 'Formalizar Apertura y Consentimiento Informado (F0)',
      desc: 'El expediente requiere legitimar la posesión, firmar el Acta de Consentimiento Hábeas Data (FO-F0-01) y la Entrevista Forense (FO-F0-02).',
      url: '/flujo',
    },
    F1: {
      titulo: 'Fijación Fotográfica y Aislamiento Faraday (F1)',
      desc: 'Completar fijación 360°, activar Modo Avión, precintar en bolsa Faraday blindada y aperturar la Planilla PRCC (FO-F1-04).',
      url: '/flujo',
    },
    F2: {
      titulo: 'Adquisición Lógica y Hash Génesis SHA-256 (F2)',
      desc: 'Desprecintar en laboratorio bajo write-blocker, extraer base SQLite msgstore.db y verificar MATCH de hash SHA-256.',
      url: '/flujo',
    },
    F3: {
      titulo: 'Análisis Forense Acústico y Heurística UX (F3)',
      desc: 'Cotejar notas de voz en Sonic Visualiser (espectrograma FFT) y verificar correspondencia entre pantalla y base cruda.',
      url: '/flujo',
    },
    F4: {
      titulo: 'Emisión del Dictamen Pericial Colegiado (F4)',
      desc: 'Redactar conclusiones técnicas motivadas y firmar bilateralmente el Dictamen Oficial (FO-F4-08) entre dos peritos titulados.',
      url: '/flujo',
    },
    F5: {
      titulo: 'Disposición Final y Sanitización NIST 800-88 (F5)',
      desc: 'Devolver dispositivo al titular, certificar desincorporación de copias lógicas temporales y archivar auditoría.',
      url: '/flujo',
    },
  };

  function renderizarFilaDashboard(c: CasoCMS): string {
    const tipo = (c.tipoProyecto || '').replace('forense_', '').toUpperCase();
    return `
      <tr>
        <th scope="row">
          <strong>${c.numeroCaso}</strong><br />
          <code>${c.expediente || 'S/E'}</code>
        </th>
        <td>
          <span class="usa-tag">${tipo || 'MENSAJERÍA'}</span>
        </td>
        <td>
          ${c.solicitante_nombre || c.consignanteNombre || 'Consignante'}<br />
          <span class="font-mono-3xs text-base-dark">C.I. ${c.solicitante_cedula || c.consignanteCedula || 'N/A'}</span>
        </td>
        <td>
          ${c.evidenciaMarca || c.dispositivo_marca || 'Smartphone'}<br />
          <code class="font-mono-3xs">S/N: ${c.dispositivo_imei || c.evidenciaSerial || 'N/A'}</code>
        </td>
        <td>
          <span class="usa-tag bg-primary-darker text-white font-mono-3xs">${c.estado || c.faseIsoActual || 'F0'}</span>
        </td>
        <td>
          <span class="usa-tag bg-success text-white font-mono-3xs">100% CONFORME</span>
        </td>
        <td>
          <ul class="usa-button-group flex-wrap">
            <li class="usa-button-group__item">
              <a href="/flujo?casoId=${c.id}" class="usa-button usa-button--outline font-sans-3xs padding-x-1 padding-y-05">
                Ciclo ISO
              </a>
            </li>
            <li class="usa-button-group__item">
              <a href="/planillas/planilla-prcc?casoId=${c.id}&modo=datos" class="usa-button font-sans-3xs padding-x-1 padding-y-05">
                PRCC
              </a>
            </li>
          </ul>
        </td>
      </tr>
    `;
  }

  async function cargarDatosDashboard() {
    const tbody = document.getElementById('tabla-casos-body');
    const kpiCasos = document.getElementById('kpi-total-casos');
    const kpiEvidencias = document.getElementById('kpi-evidencias');
    const heroTit = document.getElementById('hero-proximo-paso-heading');
    const heroDesc = document.getElementById('hero-proximo-paso-desc');
    const heroBtn = document.getElementById('btn-hero-continuar-flujo') as HTMLAnchorElement;

    let sincronizados: CasoCMS[] = [];
    try {
      const data = await phpApi.listarCasos();
      sincronizados = (data || []).filter((c: CasoCMS) => !c.id.startsWith('caso-mock-'));
    } catch {
      const data = await idbGetAll<CasoCMS>('casos');
      sincronizados = (data || []).filter((c: CasoCMS) => !c.id.startsWith('caso-mock-'));
    }

    if (kpiCasos) kpiCasos.textContent = String(sincronizados.length);
    if (kpiEvidencias) kpiEvidencias.textContent = String(sincronizados.length);

    if (sincronizados.length === 0) {
      if (heroTit) heroTit.textContent = 'Aperturar Primer Expediente Pericial';
      if (heroDesc) heroDesc.textContent = 'No hay expedientes activos en el laboratorio. Inicie un nuevo encargo con fijación y cadena de custodia.';
      if (heroBtn) {
        heroBtn.href = '/casos?nuevo=1';
        heroBtn.textContent = 'Aperturar Expediente →';
      }
      if (tbody) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7">
              No hay expedientes registrados. Comience en <a href="/casos?nuevo=1" class="usa-link">Expedientes Periciales</a>.
            </td>
          </tr>
        `;
      }
      return;
    }

    // Expediente más prioritario / reciente
    const casoActivo = sincronizados[0];
    const fase = casoActivo.estado || casoActivo.faseIsoActual || 'F0';
    const info = PASOS_INFO[fase] || PASOS_INFO.F0;

    if (heroTit) heroTit.textContent = `${casoActivo.numeroCaso}: ${info.titulo}`;
    if (heroDesc) heroDesc.textContent = info.desc;
    if (heroBtn) {
      heroBtn.href = `/flujo?casoId=${casoActivo.id}`;
      heroBtn.textContent = `Continuar Fase ${fase} →`;
    }

    if (tbody) {
      tbody.innerHTML = sincronizados.map(renderizarFilaDashboard).join('');
    }
  }

  if (typeof window !== 'undefined') {
    cargarDatosDashboard();
  }
</script>
