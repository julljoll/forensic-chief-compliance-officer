---
/**
 * SHA256.US — Vista Modular del Panel General (Dashboard)
 * Principios UX/UI USWDS: Hick's Law (Próximo Paso Recomendado), Progressive Disclosure (Acordeón)
 * y Fuente Única Verificada: RAG/Informacion_docling_rag/Informatica
 */
import PageHeader from '../uswds/PageHeader.astro';
import KpiCard from '../uswds/KpiCard.astro';
import Accordion from '../uswds/Accordion.astro';
import StatusDot from '../uswds/StatusDot.astro';
---

<PageHeader
  title="Panel General de Cumplimiento"
  subtitle="Control paso a paso de expedientes periciales, sellos SHA-256 y trazabilidad verificada en RAG/Informacion_docling_rag/Informatica."
  tag="Acreditación Activa"
  tagColor="bg-primary-darker"
>
  <div slot="actions" class="display-flex grid-gap-1 flex-wrap">
    <a href="/casos?nuevo=1" class="usa-button font-sans-xs padding-x-2 padding-y-1">
      Aperturar Expediente
    </a>
    <a href="/auditoria" class="usa-button usa-button--outline font-sans-xs padding-x-2 padding-y-1">
      Verificar Cadena
    </a>
  </div>
</PageHeader>

<!-- 1. HERO CARD: PRÓXIMO PASO RECOMENDADO (HICK'S LAW: ACCIÓN ÚNICA CLARA) -->
<div class="usa-summary-box bg-primary-darker text-white radius-md margin-bottom-3 shadow-2" role="region" aria-labelledby="hero-proximo-paso-heading">
  <div class="usa-summary-box__body padding-3">
    <div class="grid-row grid-gap flex-align-center">
      <div class="tablet:grid-col-8">
        <div class="display-flex flex-align-center grid-gap-1 margin-bottom-1">
          <span class="usa-tag bg-accent-warm-dark text-ink font-mono-3xs text-bold">
            PASO SIGUIENTE RECOMENDADO
          </span>
          <span class="font-mono-3xs text-base-lightest">
            Fuente Única: <code>RAG/Informacion_docling_rag/Informatica</code>
          </span>
        </div>
        <h2 class="usa-summary-box__heading margin-y-05 text-white font-heading-md" id="hero-proximo-paso-heading">
          Identificando siguiente paso procesal...
        </h2>
        <p class="margin-0 font-body-2xs text-base-lightest" id="hero-proximo-paso-desc">
          Analizando el estado procesal y los requisitos de gating de los expedientes periciales activos...
        </p>
      </div>

      <div class="tablet:grid-col-4 tablet:display-flex tablet:flex-justify-end margin-top-2 tablet:margin-top-0">
        <a
          href="/flujo"
          id="btn-hero-continuar-flujo"
          class="usa-button usa-button--big font-sans-xs padding-x-3 padding-y-105 width-full tablet:width-auto text-center"
        >
          Continuar Flujo ISO →
        </a>
      </div>
    </div>
  </div>
</div>

<!-- 2. GRUPO DE MÉTRICAS PRINCIPALES (4 KPIs ESENCIALES) -->
<div class="grid-row grid-gap-2 margin-bottom-3">
  <div class="grid-col-12 tablet:grid-col-6 desktop:grid-col-3">
    <KpiCard
      label="Expedientes Activos"
      value="0"
      id="kpi-total-casos"
      subtext="En curso procesal en laboratorio"
      variant="primary"
    />
  </div>
  <div class="grid-col-12 tablet:grid-col-6 desktop:grid-col-3">
    <KpiCard
      label="Evidencias Custodiadas"
      value="0"
      id="kpi-evidencias"
      subtext="Con precinto numerado y PRCC"
      variant="info"
    />
  </div>
  <div class="grid-col-12 tablet:grid-col-6 desktop:grid-col-3">
    <KpiCard
      label="Ciclo Canónico ISO"
      value="6 Fases"
      id="kpi-fases"
      subtext="Gating secuencial F0 a F5"
      variant="warning"
    />
  </div>
  <div class="grid-col-12 tablet:grid-col-6 desktop:grid-col-3">
    <KpiCard
      label="Integridad SHA-256"
      value="100%"
      id="kpi-integridad"
      subtext="Cadena sin roturas (RFC 8785)"
      variant="success"
    />
  </div>
</div>

<!-- 3. TABLA OPERATIVA DE EXPEDIENTES EN CURSO (FOCO PRINCIPAL) -->
<section class="margin-bottom-3" aria-labelledby="expedientes-curso-heading">
  <div class="grid-row flex-justify flex-align-center margin-bottom-105">
    <div class="display-flex flex-align-center grid-gap-1">
      <StatusDot status="online" />
      <h2 class="margin-0 font-heading-md" id="expedientes-curso-heading">Expedientes Periciales en Curso</h2>
    </div>
    <a href="/casos" class="usa-link font-sans-2xs">Directorio completo →</a>
  </div>

  <div class="usa-table-container--scrollable" tabindex="0">
    <table class="usa-table usa-table--striped usa-table--compact width-full">
      <caption>Listado de expedientes forenses activos sincronizados en base de datos</caption>
      <thead>
        <tr>
          <th scope="col">N° Expediente</th>
          <th scope="col">Tipología</th>
          <th scope="col">Consignante / C.I.</th>
          <th scope="col">Soporte Consignado</th>
          <th scope="col">Fase Actual</th>
          <th scope="col">Integridad</th>
          <th scope="col">Acción Directa</th>
        </tr>
      </thead>
      <tbody id="tabla-casos-body">
        <tr>
          <td colspan="7">Consultando expedientes sincronizados en MySQL...</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<!-- 4. GUÍA RÁPIDA EN ACORDEÓN USWDS (PROGRESSIVE DISCLOSURE — CERO SOBRECARGA COGNITIVA) -->
<Accordion
  id="dashboard-guia-ciclo-iso"
  title="Guía de Referencia Rápida: Las 6 Fases del Ciclo Pericial ISO (F0 – F5) y Fuente RAG Informática"
  expanded={false}
  className="margin-bottom-2"
>
  <p class="margin-top-0 margin-bottom-105 font-body-2xs">
    Todo el procedimiento pericial por consignación se fundamenta exclusivamente en el corpus verificado
    <code>RAG/Informacion_docling_rag/Informatica</code>:
  </p>
  <div class="grid-row grid-gap-1 margin-bottom-105">
    <div class="tablet:grid-col-4 margin-bottom-1">
      <a href="/flujo" class="display-block bg-base-lightest padding-105 radius-sm border-1px border-base-lighter text-no-underline text-ink">
        <strong class="font-mono-3xs text-primary">F0 · APERTURA Y LEGITIMACIÓN</strong>
        <span class="display-block font-body-3xs text-base-dark">Consentimiento (FO-F0-01) y Entrevista (FO-F0-02) · LEDCI Arts. 20–22</span>
      </a>
    </div>
    <div class="tablet:grid-col-4 margin-bottom-1">
      <a href="/flujo" class="display-block bg-base-lightest padding-105 radius-sm border-1px border-base-lighter text-no-underline text-ink">
        <strong class="font-mono-3xs text-primary">F1 · IDENTIFICACIÓN Y RECOLECCIÓN</strong>
        <span class="display-block font-body-3xs text-base-dark">Fijación 360°, Faraday (FO-F1-03) y PRCC (FO-F1-04) · ISO 27037 / MUCC-2017</span>
      </a>
    </div>
    <div class="tablet:grid-col-4 margin-bottom-1">
      <a href="/flujo" class="display-block bg-base-lightest padding-105 radius-sm border-1px border-base-lighter text-no-underline text-ink">
        <strong class="font-mono-3xs text-primary">F2 · ADQUISICIÓN Y PRESERVACIÓN</strong>
        <span class="display-block font-body-3xs text-base-dark">Desprecintado, Write-Blocker y Hash SHA-256 (FO-F2-05) · NIST 800-101 / 800-86</span>
      </a>
    </div>
    <div class="tablet:grid-col-4 margin-bottom-1">
      <a href="/flujo" class="display-block bg-base-lightest padding-105 radius-sm border-1px border-base-lighter text-no-underline text-ink">
        <strong class="font-mono-3xs text-primary">F3 · ANÁLISIS E INTERPRETACIÓN</strong>
        <span class="display-block font-body-3xs text-base-dark">Copia de trabajo, Audio FFT (FO-F3-06) y UX vs SQLite (FO-F3-07) · ISO 27042</span>
      </a>
    </div>
    <div class="tablet:grid-col-4 margin-bottom-1">
      <a href="/flujo" class="display-block bg-base-lightest padding-105 radius-sm border-1px border-base-lighter text-no-underline text-ink">
        <strong class="font-mono-3xs text-primary">F4 · INFORME PERICIAL Y DICTAMEN</strong>
        <span class="display-block font-body-3xs text-base-dark">Colegiado 2 Peritos (FO-F4-08, FO-F4-09, FO-F4-10) · COPP 223–225 / UNE 197010</span>
      </a>
    </div>
    <div class="tablet:grid-col-4 margin-bottom-1">
      <a href="/flujo" class="display-block bg-base-lightest padding-105 radius-sm border-1px border-base-lighter text-no-underline text-ink">
        <strong class="font-mono-3xs text-primary">F5 · ENTREGA Y SANITIZACIÓN</strong>
        <span class="display-block font-body-3xs text-base-dark">Devolución, Borrado y Auditoría (FO-F5-11..13) · ISO 27002 A.8.10 / UNE 71505</span>
      </a>
    </div>
  </div>
</Accordion>

<script>
  import { phpApi } from '../../lib/data/phpApi';
  import { idbGetAll } from '../../lib/data/idb';
  import type { CasoCMS } from '../../lib/domain/types';

  const PASOS_INFO: Record<string, { titulo: string; desc: string; url: string }> = {
    F0: {
      titulo: 'Paso 1 de 6 — Formalizar Apertura y Consentimiento Informado (F0)',
      desc: 'Legitime al consignante titular, suscriba el Acta de Consentimiento (FO-F0-01) y levante la Entrevista Forense (FO-F0-02).',
      url: '/flujo',
    },
    F1: {
      titulo: 'Paso 2 de 6 — Fijación Fotográfica 360° y Aislamiento Faraday (F1)',
      desc: 'Documente estado inicial, active Modo Avión, selle en Bolsa Faraday con precinto numerado y abra la Planilla PRCC (FO-F1-04).',
      url: '/flujo',
    },
    F2: {
      titulo: 'Paso 3 de 6 — Adquisición Forense y Hash Génesis SHA-256 (F2)',
      desc: 'Verifique indemnidad del precinto en laboratorio (FO-F2-05), adquiera copia de trabajo y compruebe MATCH del hash SHA-256.',
      url: '/flujo',
    },
    F3: {
      titulo: 'Paso 4 de 6 — Análisis Reproducible sobre Copia de Trabajo (F3)',
      desc: 'Ejecute examen acústico FFT (FO-F3-06) y cotejo de capturas/interfaz contra registros SQLite (FO-F3-07) sin tocar el original.',
      url: '/flujo',
    },
    F4: {
      titulo: 'Paso 5 de 6 — Emisión del Dictamen Pericial Colegiado (F4)',
      desc: 'Redacte conclusiones motivadas con cita de hashes SHA-256 y suscriba bilateralmente el Dictamen Oficial (FO-F4-08) entre dos peritos.',
      url: '/flujo',
    },
    F5: {
      titulo: 'Paso 6 de 6 — Disposición Final, Sanitización y Auditoría (F5)',
      desc: 'Entregue resultados (FO-F5-11), certifique borrado seguro de copias temporales (FO-F5-12) y selle la línea de auditoría (FO-F5-13).',
      url: '/flujo',
    },
  };

  function renderizarFilaDashboard(c: CasoCMS): string {
    const tipo = (c.tipoProyecto || '').replace('forense_', '').toUpperCase();
    const fase = c.faseIsoActual || c.estado || 'F0';
    return `
      <tr>
        <th scope="row">
          <strong>${c.numeroCaso}</strong><br />
          <code>${c.expediente || 'S/E'}</code>
        </th>
        <td>
          <span class="usa-tag">${tipo || 'MENSAJERÍA'}</span>
        </td>
        <td>
          ${c.solicitante_nombre || c.consignanteNombre || 'Consignante'}<br />
          <span class="font-mono-3xs text-base-dark">C.I. ${c.solicitante_cedula || c.consignanteCedula || 'N/A'}</span>
        </td>
        <td>
          ${c.evidenciaMarca || c.dispositivo_marca || 'Smartphone'}<br />
          <code class="font-mono-3xs">S/N: ${c.dispositivo_imei || c.evidenciaSerial || 'N/A'}</code>
        </td>
        <td>
          <span class="usa-tag bg-primary-darker text-white font-mono-3xs">${fase}</span>
        </td>
        <td>
          <span class="usa-tag bg-success text-white font-mono-3xs">100% CONFORME</span>
        </td>
        <td>
          <a href="/flujo?casoId=${c.id}" class="usa-button font-sans-3xs padding-x-105 padding-y-05">
            Continuar ${fase} →
          </a>
        </td>
      </tr>
    `;
  }

  async function cargarDatosDashboard() {
    const tbody = document.getElementById('tabla-casos-body');
    const kpiCasos = document.getElementById('kpi-total-casos');
    const kpiEvidencias = document.getElementById('kpi-evidencias');
    const heroTit = document.getElementById('hero-proximo-paso-heading');
    const heroDesc = document.getElementById('hero-proximo-paso-desc');
    const heroBtn = document.getElementById('btn-hero-continuar-flujo') as HTMLAnchorElement;

    let sincronizados: CasoCMS[] = [];
    try {
      const data = await phpApi.listarCasos();
      sincronizados = (data || []).filter((c: CasoCMS) => !c.id.startsWith('caso-mock-'));
    } catch {
      const data = await idbGetAll<CasoCMS>('casos');
      sincronizados = (data || []).filter((c: CasoCMS) => !c.id.startsWith('caso-mock-'));
    }

    if (kpiCasos) kpiCasos.textContent = String(sincronizados.length);
    if (kpiEvidencias) kpiEvidencias.textContent = String(sincronizados.length);

    if (sincronizados.length === 0) {
      if (heroTit) heroTit.textContent = 'Paso Inicial: Aperturar Primer Expediente Pericial';
      if (heroDesc) heroDesc.textContent = 'No hay expedientes activos. Registre el soporte consignado para iniciar guiado paso a paso desde la Fase F0.';
      if (heroBtn) {
        heroBtn.href = '/casos?nuevo=1';
        heroBtn.textContent = 'Aperturar Expediente →';
      }
      if (tbody) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7">
              No hay expedientes registrados. Comience en <a href="/casos?nuevo=1" class="usa-link text-bold">Aperturar Expediente</a>.
            </td>
          </tr>
        `;
      }
      return;
    }

    const casoActivo = sincronizados[0];
    const fase = String(casoActivo.faseIsoActual || casoActivo.estado || 'F0');
    const info = PASOS_INFO[fase] || PASOS_INFO.F0;

    if (heroTit) heroTit.textContent = `${casoActivo.numeroCaso}: ${info.titulo}`;
    if (heroDesc) heroDesc.textContent = info.desc;
    if (heroBtn) {
      heroBtn.href = `/flujo?casoId=${casoActivo.id}`;
      heroBtn.textContent = `Continuar Fase ${fase} →`;
    }

    if (tbody) {
      tbody.innerHTML = sincronizados.map(renderizarFilaDashboard).join('');
    }
  }

  if (typeof window !== 'undefined') {
    cargarDatosDashboard();
  }
</script>
